"Expansion adding colony tiles, player colonies, and trade fleets"
CLASS ColoniesExpansion : Module {
  premiseRequirement = HAS "(=1 Player, =3 ColonyTile) OR (=2 Player, =5 ColonyTile) OR (3 Player, =2 (ColonyTile - Player))"

  This:: TradeSA, BuildColonySP
  SetupPhase: ColoniesSetup
  SetupPhase IF SoloMode: PROD[-2 Megacredit<Player1>]
  SolarPhase: AdvanceColonyTracks
}

"Trade with a colony tile"
CLASS TradeSA : StandardAction {
  9 -> Trade
  3 Energy -> Trade
  3 Titanium -> Trade
}

CLASS BuildColonySP : StandardProject {
  cost = 17
  1 / cost -> Colony<>
}

"Creates the colony tiles and one trade fleet for each player"
CLASS ColoniesSetup : Custom

"A colony tile, such as Pluto"
ABSTRACT CLASS ColonyTile {
  HAS MAX 1 This, MAX 3 Colony<This>, MAX 1 FlownTradeFleet<This>

  This:: ColonyProduction<This>
  Colony<This>:: ColonyProduction<This> / Colony<This> - ColonyProduction<This>
  ResetColonyProduction<This>: -ColonyProduction<This>. / ColonyProduction<This> - Colony<This, Anyone>
  AdvanceColonyTracks: ColonyProduction<This>.
}

"One of the up-to-three colonies players can own on a ColonyTile"
CLASS Colony<ColonyTile> : Owned<Player> {
  DEFAULT +Colony<ColonyTile(HAS MAX 0 Colony)>
  FlownTradeFleet<Anyone, ColonyTile> OR GiveColonyBonuses:: GiveColonyBonus<ColonyTile>
}

// A player's trade fleet, either in reserve or flown to a ColonyTile this generation
ABSTRACT CLASS TradeFleet : Owned<Player> {
  CLASS ReserveTradeFleet
  CLASS FlownTradeFleet<ColonyTile> {
    Generation: ReserveTradeFleet FROM This
  }
}

"Initiates a Trade operation"
CLASS Trade<ColonyTile> : Owned<Player>, Signal {
  This: MAX 0 TradeBarrier: FlownTradeFleet<ColonyTile> FROM ReserveTradeFleet
}

"A notch on the production track of a ColonyTile; note a tile has 0 to 6 of these (not 1 to 7)"
CLASS ColonyProduction<ColonyTile> { HAS MAX 6 This }

"An implementation detail used to trigger colony bonuses to be paid out"
CLASS GiveColonyBonus<ColonyTile> : Owned<Player>, Signal

"Advances every colony tile track one step, as in production and Early Colonization"
CLASS AdvanceColonyTracks : Signal

"Requests one colony bonus payment for each colony the player owns"
CLASS GiveColonyBonuses : Owned<Player>, Signal

"Blocks fleet movement until one trade-track decision has been handled"
CLASS TradeBarrier : Barrier

"An implementation detail used to trigger a colony tile's 'white cube' to move left"
CLASS ResetColonyProduction<ColonyTile> : Signal

"To add a colony tile to the game (like Aridor does), gain this"
CLASS AddColonyTile<Class<ColonyTile>> : Custom

"If a ColonyTile gives card resources, one of these is created first instead"
CLASS DelayedColonyTile<Class<ColonyTile>, Class<CardResource>> {
  HAS MAX 1 This
  This IF ResourceCard<Class<CardResource>>:: ColonyTile FROM This
  ResourceCard<Class<CardResource>>:: ColonyTile FROM This
}
