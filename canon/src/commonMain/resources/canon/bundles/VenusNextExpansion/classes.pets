CLASS VenusNextExpansion : Module {
  SetupPhase: SoloVictoryRequirement
  SoloVictoryCheck IF MAX 0 Tr63SoloObjective, GpComplete<Class<TemperatureStep>>, GpComplete<Class<OxygenStep>>, GpComplete<Class<OceanTile>>, GpComplete<Class<VenusStep>>: Victory<Player1>.
  SolarPhase IF MAX 0 LastCall:: VenusSolarPhase FROM Phase
}

CLASS AirScrappingSP : StandardProject, AutoLoad {
  cost = 15
  1 / This.cost -> VenusStep
}

"Adds World Government Terraforming to the solar phase"
CLASS WorldGovernmentOption : Module {
  // A Venus game has four global parameters, so MAX 3 means at least one is still incomplete.
  VenusSolarPhase IF MAX 3 GpComplete:: WorldGovernmentTerraforming
}

"The Venus Next contribution to the Solar phase"
CLASS VenusSolarPhase : Phase

"Represents a 2% increase in Venus... terraformedness"
CLASS VenusStep : GlobalParameter {
  HAS MAX 15 This

  This IF =15 This: GpComplete<Class<VenusStep>>
  This IF =4 This: ProjectCard
  This IF =8 This: TerraformRating
}

CLASS VenusTag : PlanetTag

"Asks the first player where an ocean is placed while preserving the performing Player"
CLASS FirstPlayerOcean<Player> : Signal
