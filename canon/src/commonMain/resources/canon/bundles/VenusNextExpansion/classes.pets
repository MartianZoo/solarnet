CLASS VenusNextExpansion : Module {
  This:: AirScrappingSP
  This IF MAX 0 MilestonePoolOverride, MAX 0 VenusDefaultMilestones: VenusDefaultMilestones
  This IF MultiplayerMode, MAX 0 AwardPoolOverride, MAX 0 VenusDefaultAwards: VenusDefaultAwards
  SetupPhase IF SoloMode: SoloVictoryRequirement
  SoloVictoryCheck IF SoloMode, MAX 0 Tr63SoloObjective, GpComplete<Class<TemperatureStep>>, GpComplete<Class<OxygenStep>>, GpComplete<Class<OceanTile>>, GpComplete<Class<VenusStep>>: Victory<Player1>.
}

CLASS VenusDefaultMilestones : Module

CLASS VenusDefaultAwards : Module

CLASS AirScrappingSP : StandardProject {
  cost = 15
  CostPaid<Class<This>>: VenusStep
}

"Adds World Government Terraforming to the solar phase"
CLASS WorldGovernmentOption : Module {
  autoSelectWhen = HAS VenusNextExpansion
  premiseRequirement = HAS =1 VenusNextExpansion

  // A Venus game has four global parameters, so MAX 3 means at least one is still incomplete.
  SolarPhase IF MAX 3 GpComplete:: WorldGovernmentTerraforming
}

"Represents a 2% increase in Venus... terraformedness"
CLASS VenusStep : GlobalParameter {
  automaticSelectionRequirement = HAS VenusNextExpansion
  activationRequirement = HAS VenusNextExpansion

  HAS MAX 15 This

  This IF =15 This: GpComplete<Class<VenusStep>>
  This IF =4 This: ProjectCard
  This IF =8 This: TerraformRating
}

CLASS VenusTag : PlanetTag {
  automaticSelectionRequirement = HAS VenusNextExpansion
}

"Asks the first player where an ocean is placed while preserving the performing Player"
CLASS FirstPlayerOcean<Player> : Signal
