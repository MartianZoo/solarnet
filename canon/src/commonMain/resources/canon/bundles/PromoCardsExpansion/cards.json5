    {
      "name": "PharmacyUnion",
      "deck": "CORPORATION",
      "tags": [ "MicrobeTag", "MicrobeTag" ],
      "resourceType": "Disease",
      "immediate": "ProjectCard",
      "effects": [
        // This is the only card I know of that has a double-colon effect. Without it, the engine
        // automatically tried to take the 2 disease cubes first and lose no money, then pocketed
        // the whole 54 money free and clear!
        // Reference: https://boardgamegeek.com/thread/3067197/can-card-effects-really-be-done-any-order-weird-sc
        "This:: 54",
        // The disease task can remain pending after this corporation flips. Its gated fallback
        // states that lifetime exception without weakening the mandatory placement while it exists.
        "MicrobeTag<Anyone, CardFront<Anyone>>: (Disease<This>! OR (MAX 0 This: Ok)), -4.",
        // Check the disease count when each tag consequence executes, so two simultaneous science
        // tags can remove the last disease and then offer the flip.
        "ScienceTag<>: TerraformRating FROM Disease<This>! OR (MAX 0 Disease: (PlayedEvent<Class<This>> FROM This THEN 3 TerraformRating) OR Ok)"
      ],
    },

