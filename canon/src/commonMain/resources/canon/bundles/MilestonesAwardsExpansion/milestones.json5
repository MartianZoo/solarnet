{
  // Reprinted goals retain the canonical definitions owned by their original map bundles. This
  // file contains only new goals and revised goals with distinct implementations.
  "milestones": [
    // Briber needs a claim cost that differs for this milestone.
    // { "name": "Briber", "requirement": "..." },

    // Builder
    { "name": "Builder7", "replaces": "Builder8", "requirement": "7 BuildingTag" },

    // Engineer
    { "name": "Engineer", "requirement": "10 PROD[Energy OR Heat]" },

    // Farmer
    { "name": "Farmer", "requirement": "5 (Animal OR Microbe)" },

    // Geologist
    {
      "name": "Geologist",
      "requirement": "3 (OwnedTile<VolcanicArea> OR OwnedTile(HAS Neighbor<VolcanicArea>))",
    },

    // Hydrologist needs player markers that track who placed each ocean.
    // { "name": "Hydrologist", "requirement": "..." },

    // Landshaper
    { "name": "Landshaper", "requirement": "CityTile, GreeneryTile, SpecialTile" },

    // Legend
    { "name": "Legend4", "replaces": "Legend5", "requirement": "4 PlayedEvent" },

    // Lobbyist needs the unimplemented Turmoil delegate and party-leader rules.
    // { "name": "Lobbyist", "requirement": "..." },

    // Merchant. ClaimMilestoneSA pays its 8 M€ before resolving the selected milestone, so the
    // ordinary requirement observes the post-payment resources required by the tile.
    {
      "name": "Merchant",
      "requirement": "2 Megacredit, 2 Steel, 2 Titanium, 2 Plant, 2 Energy, 2 Heat",
    },

    // Philantropist. This reuses Vitor's positive-VP citation metric. It is unclear whether the
    // milestone is intended to count Vitor itself, which cites positive VP but does not score VP.
    {
      "name": "Philantropist",
      "requirement": "5 CardFront(HAS CitationsIgnoringRemoves<Class<VictoryPoint>>)",
    },

    // Pioneer
    {
      "name": "Pioneer4",
      "replaces": "Pioneer3",
      "requirement": "4 Colony",
    },

    // Producer. GrossHack contributes five synthetic M€ production components, so 21 models
    // the printed combined production threshold of 16.
    { "name": "Producer", "requirement": "21 PROD[StandardResource]" },

    // Spacefarer
    { "name": "Spacefarer", "requirement": "4 SpaceTag" },

    // Sponsor
    { "name": "Sponsor", "requirement": "3 CardFront(HAS 20 cost)" },

    // Tactician
    {
      "name": "Tactician4",
      "replaces": "Tactician5",
      "requirement": "4 CardFront(HAS requirement)",
    },

    // Terraformer
    { "name": "Terraformer29", "replaces": "Terraformer35", "requirement": "29 TerraformRating" },

    // Terran
    { "name": "Terran", "requirement": "5 EarthTag" },

    // Thawer needs player markers that track who raised each temperature step.
    // { "name": "Thawer", "requirement": "..." },

    // Tycoon
    {
      "name": "Tycoon10",
      "replaces": "Tycoon15",
      "requirement": "10 (ActiveCard OR AutomatedCard)",
    },
  ],
}
