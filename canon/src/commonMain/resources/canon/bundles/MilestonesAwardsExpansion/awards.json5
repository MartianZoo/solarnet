{
  // Reprinted goals retain the canonical definitions owned by their original map bundles. This
  // file contains only new awards.
  "awards": [
    { "name": "Administrator", "metric": "CardFront(HAS MAX 0 Tag)" },

    { "name": "Biologist", "metric": "BioTag" },

    { "name": "Collector", "metric": "Class<Resource>(HAS Resource<Owner>)" },

    { "name": "Constructor", "metric": "Colony OR CityTile" },

    { "name": "Highlander", "metric": "OwnedTile<MarsArea(HAS MAX 0 Neighbor<OceanTile>)>" },

    { "name": "Landscaper", "metric": "TileInLargestGroup" },

    { "name": "Manufacturer", "metric": "PROD[Steel OR Heat]" },

    // Politician needs the unimplemented Turmoil party-leader and influence rules.
    // { "name": "Politician", "metric": "..." },

    { "name": "Promoter", "metric": "CARDS[CardBack<EventPile>]" },

    { "name": "Traveller", "metric": "JovianTag OR EarthTag" },

    { "name": "Visionary", "metric": "CARDS[ProjectCard<Hand>]" },
  ],
}
