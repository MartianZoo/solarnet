// Supporting declarations contributed by cards in this bundle.
CLASS Microbe : CardResource<ResourceHolder<Class<Microbe>, Owner>>

CLASS SpliceTacticalGenomicsWatcher : Owned<Player> {
  HAS =1 This
  MicrobeTag<CardFront> IF SpliceTacticalGenomics<Anyone>: Microbe<CardFront> OR 2
}

CLASS MonsInsuranceWatcher : Owned<Player> {
  HAS =1 This
  MonsInsurance<Anyone> IF MAX 0 MonsInsurance<Owner>: PROD[-2] BY Owner
}

CLASS Asteroid : CardResource<ResourceHolder<Class<Asteroid>, Owner>>

CLASS Disease : CardResource<ResourceHolder<Class<Disease>, Owner>>

CLASS CopyPrelude<CardFront<Player>> : Custom, Owned<Player>

CLASS Animal : CardResource<ResourceHolder<Class<Animal>, Owner>>

CLASS Floater : CardResource<ResourceHolder<Class<Floater>, Owner>>

CLASS Graphene : CardResource<ResourceHolder<Class<Graphene>, Owner>>

CLASS CyberiaSystemsFirstChoice : Cardbound, Temporary

CLASS NeptunianOption : HasActions, Owned {
  UseAction<This>:: Accept<Class<Steel>>
  5 -> PROD[Energy], Hydroelectric<NeptunianPowerConsultants>
}

CLASS Hydroelectric : CardResource<ResourceHolder<Class<Hydroelectric>, Owner>>

CLASS CathedralAction : HasActions {
  2 -> ProjectCard
}

CLASS Cathedral<CityTile<Owner>> : Owned<Owner> {
  HAS MAX 1 This
  This: UseAction<CathedralAction>?
}

CLASS VerminWatcher : Owned<Player> {
  HAS =1 This
  End IF 10 Animal<Anyone, Vermin<Anyone>>: -VictoryPoint / CityTile<Owner>
}
