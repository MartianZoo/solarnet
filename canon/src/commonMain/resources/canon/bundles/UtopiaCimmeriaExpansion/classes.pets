"Terra Cimmeria's MSL Curiosity placement bonus; its colony branch exists only with Colonies"
CLASS TcColonyBonus : Signal {
  This IF Class<ColoniesExpansion>: Colony<>, -5
}

CLASS UtopiaDefaultMilestones : Module

CLASS UtopiaDefaultAwards : Module

CLASS CimmeriaDefaultMilestones : Module

CLASS CimmeriaDefaultAwards : Module

CLASS UtopiaMap : MarsMap {
  This IF (MultiplayerMode, =0 Milestone):: UtopiaDefaultMilestones.
  This IF (MultiplayerMode, =0 Award):: UtopiaDefaultAwards.
}

CLASS CimmeriaMap : MarsMap {
  This IF (MultiplayerMode, =0 Milestone):: CimmeriaDefaultMilestones.
  This IF (MultiplayerMode, =0 Award):: CimmeriaDefaultAwards.
}

