"A selected game option; every concrete subtype has at most one immutable instance"
ABSTRACT CLASS GameOption : System {
  HAS MAX 1 This
  -This:: Die!
}

"One participant seated for the game being configured"
CLASS Player { HAS MAX 5 This }

"The map option selected for the setup world"
ABSTRACT CLASS MarsMapOption : GameOption { HAS MAX 1 MarsMapOption }

"The player-count mode selected for the game"
ABSTRACT CLASS Mode : GameOption { HAS MAX 1 Mode }

"Solo play with a neutral opponent and a fixed generation limit"
CLASS SoloMode : Mode

"A game with at least two players"
CLASS MultiplayerMode : Mode

"Checks whether the current selections describe one complete game"
CLASS ValidateSetup : Signal {
  This IF MAX 0 Player: Die
  This IF MAX 0 MarsMapOption: Die
  This IF =1 Player, MAX 0 SoloMode: Die
  This IF 2 Player, MAX 0 MultiplayerMode: Die

  This IF MAX 0 ColoniesExpansion, SelectedColonyTile: Die
  This IF MAX 0 ColoniesExpansion, DeferredColonySelection: Die
  This IF ColoniesExpansion, DeferredColonySelection, SelectedColonyTile: Die
  This IF =1 Player, ColoniesExpansion, MAX 0 DeferredColonySelection, (MAX 2 SelectedColonyTile OR 4 SelectedColonyTile): Die
  This IF (=2 Player OR =3 Player), ColoniesExpansion, MAX 0 DeferredColonySelection, (MAX 4 SelectedColonyTile OR 6 SelectedColonyTile): Die
  This IF =4 Player, ColoniesExpansion, MAX 0 DeferredColonySelection, (MAX 5 SelectedColonyTile OR 7 SelectedColonyTile): Die
  This IF =5 Player, ColoniesExpansion, MAX 0 DeferredColonySelection, (MAX 6 SelectedColonyTile OR 8 SelectedColonyTile): Die
}
