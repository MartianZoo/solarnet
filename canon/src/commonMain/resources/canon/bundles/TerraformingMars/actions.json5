{
  "actions": [

    // Play card from hand
    { "name": "PlayCardSA", "action": "-> PlayCard<Class<ProjectCard>>" },

    // Use standard project
    { "name": "UseStandardProjectSA", "action": "-> UseAction<StandardProject>" },

    // Claim milestone
    {
      "name": "ClaimMilestoneSA",
      "action": "-> Payment<This, First>",
      "effects": [
        "UseAction<This>:: 8 Owed<>",
        "CostPaid<This>: Milestone"
      ],
      "automaticSelectionRequirement": "MAX 0 SoloMode"
    },

    // Fund award
    {
      "name": "FundAwardSA",
      "action": "-> Payment<This, First>",
      "effects": [
        "UseAction<This>:: (=0 Award: 8 Owed<>) OR (=1 Award: 14 Owed<>) OR (=2 Award: 20 Owed<>)",
        "CostPaid<This>: Award"
      ],
      "automaticSelectionRequirement": "MAX 0 SoloMode"
    },

    // Use card action
    {
      "name": "UseCardActionSA",
      "action": "-> ActionUsedMarker<ActionCard> THEN UseAction<ActionCard>"
    },

    // Convert plants
    {
      "name": "ConvertPlantsSA",
      "action": "8 Plant -> GreeneryTile<>"
    },

    // Convert heat
    {
      "name": "ConvertHeatSA",
      "action": "8 Heat -> TemperatureStep"
    },

    // Sell patents - yes, it's technically a project, but that makes things annoying
    { "name": "SellPatents", "action": "X ProjectCard -> X" },

    // Mandatory first action; it's always here but you can't take it if you have 0 Mandate
    { "name": "HandleMandates", "action": "-> Mandate: MandateSignal" }
  ],
}
