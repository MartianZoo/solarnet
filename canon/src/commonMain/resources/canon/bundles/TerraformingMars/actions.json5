{
  "actions": [

    // Play card from hand
    { "id": "PlayCardSA", "action": "-> PlayCard<Class<ProjectCard>>" },

    // Use standard project
    { "id": "UseStandardProjectSA", "action": "-> UseAction<StandardProject>" },

    // Claim milestone
    { "id": "ClaimMilestoneSA", "action": "8 -> Milestone", "setupRequirement": "MAX 0 SoloMode" },

    // Fund award
    {
      "id": "FundAwardSA",
      "action": "(=0 Award: 8) OR (=1 Award: 14) OR (=2 Award: 20) -> Award",
      "setupRequirement": "MAX 0 SoloMode"
    },

    // Use card action
    {
      "id": "UseCardActionSA",
      "action": "-> ActionUsedMarker<ActionCard> THEN UseAction<ActionCard>"
    },

    // Convert plants
    { "id": "ConvertPlantsSA", "action": "8 Plant -> GreeneryTile" },

    // Convert heat
    { "id": "ConvertHeatSA", "action": "8 Heat -> TemperatureStep" },

    // Sell patents - yes, it's technically a project, but that makes things annoying
    { "id": "SellPatents", "action": "X ProjectCard -> X" },

    // Mandatory first action; it's always here but you can't take it if you have 0 Mandate
    { "id": "HandleMandates", "action": "-> Mandate: MandateSignal" }
  ],
}
