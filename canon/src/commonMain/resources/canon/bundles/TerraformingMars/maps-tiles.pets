"Every game must have exactly one of these (Tharsis Map, etc.)"
ABSTRACT CLASS MarsMap { HAS =1 This }

"A hexagonal area where a tile can go (note the game does not call these 'spaces')"
ABSTRACT CLASS Area {
  HAS =1 This
  HAS MAX 1 Tile<This>                                 // circular reference is un-ideal, but...

  "One of the 61 areas on the planet itself"
  ABSTRACT CLASS MarsArea {                            // specific areas loaded from `maps.json5`
    Tile<This>:: CreateAdjacencies<This>

    "An unreserved area"
    ABSTRACT CLASS LandArea {
      ABSTRACT CLASS VolcanicArea
    }

    "An area reserved for oceans"
    ABSTRACT CLASS WaterArea

    "An area reserved for Noctis City"
    ABSTRACT CLASS NoctisArea
  }

  "An area not on Mars (yes, it includes the one for Stanford Torus)"
  ABSTRACT CLASS RemoteArea
}

"A virtual metric whose count is the area's row number; no MarsRow component ever exists"
CLASS MarsRow<MarsArea> : Custom

"A tile; if it's not on an Area / not in play, it doesn't exist yet"
ABSTRACT CLASS Tile<Area> {
  CLASS OceanTile : Tile<MarsArea>, GlobalParameter {
    HAS MAX 9 OceanTile                                // `HAS MAX 9 This` wouldn't work!
    DEFAULT +OceanTile<WaterArea>
    This IF =9 OceanTile: GpComplete<Class<OceanTile>>
                                                       // We could almost count all adjacencies,
    ForwardAdjacency<This, Tile>: 2                    // but then the tile would trigger itself
  }

  "Any tile that someone/something owns: city tile, greenery tile, or special tile"
  // Not narrowed to <Player> because SoloOpponent gets four tiles
  ABSTRACT CLASS OwnedTile : Owned {
    CLASS GreeneryTile : Tile<MarsArea> {
      // HAS? specifies a requirement with an "escape clause": the requirement is upheld as long as
      // there is at least one component that satisfies it. If none do, it's dropped.
      // `MAX 0 Tile` is normally not needed here (tiles on an area are limited to 1 anyway), but
      // is here so the "escape clause" can take it into account.
      DEFAULT +GreeneryTile<LandArea(HAS? Neighbor<OwnedTile>, MAX 0 Tile)>

      End: VictoryPoint
    }

    CLASS CityTile {
      DEFAULT +CityTile<LandArea(HAS MAX 0 Neighbor<CityTile<Anyone>>)>
      End: VictoryPoint / Adjacency<This, GreeneryTile<Anyone>>
    }

    ABSTRACT CLASS SpecialTile : Tile<MarsArea> {
      DEFAULT +SpecialTile<LandArea>
    }
  }
}

"Adding a Tile automatically creates one of these per adjacent area"
CLASS Neighbor<Tile<MarsArea>, MarsArea> : Hidden

"When Tile B is placed next to existing Tile A, a ForwardAdj<A, B> and BackwardAdj<B, A> are created"
ABSTRACT CLASS Adjacency<Tile, Tile> {
  CLASS ForwardAdjacency, BackwardAdjacency
}

"Triggers creating Neighbors and Adjacencies"
CLASS CreateAdjacencies<MarsArea>: Custom
