// These files contain definitions of classes. Not all of them will be defined during any actual
// game; that depends on how the game was configured. However, if a class is defined then it forces
// every other class its definition refers to to be defined as well (with the possible exception of
// effect *triggers*, since we can reason tht those triggers would simply never happen anyway.

"An immutable fact in the fully resolved configuration of a playable game"
ABSTRACT CLASS GameConfiguration : System {
  -This:: Die!
}

"An affirmative module of rules active in a playable game"
ABSTRACT CLASS GameModule : GameConfiguration { HAS =1 This }

"The base Terraforming Mars rules"
CLASS TerraformingMars : GameModule {
  HAS =1 MarsMap

  SetupPhase IF 2 Player:: BeginGame
  CorporationPhase: Photosynthesis

  PlayTag<Class<BuildingTag>>:: Accept<Class<Steel>>
  PlayTag<Class<SpaceTag>>:: Accept<Class<Titanium>>
  Pay<Class<Steel>>:: -2 Owed
  Pay<Class<Titanium>>:: -3 Owed                       // should be innocuous for TradeSA...
}

CLASS Photosynthesis {
  HAS MAX 1 This

  FinalGreeneryPhase: -This!
  GreeneryTile: OxygenStep
}

"A single step along a global parameter track; creating one gives the active player (if any) a TR"
ABSTRACT CLASS GlobalParameter : Atomized {
  DEFAULT +GlobalParameter.                            // by default gains/removes are "if possible"
  DEFAULT -GlobalParameter.

  This: TerraformRating                                // transformed to `This BY Owner: TR<Owner>`

  "Represents 2 degrees C of temperature increase"
  CLASS TemperatureStep {
    HAS MAX 19 This

    This IF =3 This: PROD[Heat]
    This IF =5 This: PROD[Heat]
    This IF =15 This: OceanTile
    This IF =19 This: GpComplete<Class<TemperatureStep>>
  }

  "Represents a 1% increase in oxygen level"
  CLASS OxygenStep {
    HAS MAX 14 This

    This IF =8 This: TemperatureStep
    This IF =14 This: GpComplete<Class<OxygenStep>>
  }

  // OceanTile is in maps-tiles.pets
}

"Records that a particular global parameter track has reached its maximum"
CLASS GpComplete<Class<GlobalParameter>> { HAS MAX 1 This }

"Records that the current generation will be the last one played"
CLASS LastCall { HAS MAX 1 This }

"Tells what generation we're in"
CLASS Generation : System

"Starts generation one after mode-specific setup is complete"
CLASS BeginGame : Signal, System {
  This:: Generation THEN StartToken<Player1>
}

"Supertype for anything that automatically disappears between generations"
ABSTRACT CLASS Generational { Generation:: -This. }

"The current game phase; exactly one exists from the start of SetupPhase onward"
ABSTRACT CLASS Phase : AutoLoad, System {
  HAS =1 Phase                                         // weird that this works, but it does

  CLASS SetupPhase
  CLASS CorporationPhase {
    NewTurn: PlayCard<Class<CorporationCard>>, 10 BuyCard?
  }
  CLASS ResearchPhase
  CLASS ActionPhase {
    NewTurn: UseAction<StandardAction> OR Pass
    SecondAction: UseAction<StandardAction>?
  }
  CLASS ProductionPhase
  CLASS SolarPhase
  CLASS FinalGreeneryPhase {
    NewTurn: UseAction1<ConvertPlantsSA>?
  }
  CLASS EndPhase
}

"This Signal causes components to pay out victory points"
CLASS End : Signal, System

"Signals that the final score is available"
CLASS FinalScore : Signal, System
