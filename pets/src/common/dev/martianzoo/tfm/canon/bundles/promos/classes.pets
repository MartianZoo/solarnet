"Installs attack history for cards that use it"
CLASS AttackHistoryWatcher : CardWatcher {
  This: EACH @Class<Resource> { ResourceRemovalWatcher<@Class> }
  This: EACH @Class<StandardResource> { ProductionDecreaseWatcher<@Class> }
}

"A durable generational resource-removal record owned by the victim and naming the attacker"
CLASS ResourceWasAttacked<Class<Resource>, Player, GenerationScope> : Owned, System

"A durable generational production-decrease record owned by the victim and naming the attacker"
CLASS ProductionWasAttacked<Class<StandardResource>, Player, GenerationScope> : Owned, System

CLASS ResourceRemovalWatcher<Class<@Resource>> : System {
  HAS MAX 1 This
  -X @Resource<Victim@Owner(NOT Attacker@)> BY Attacker@Player: ResourceWasAttacked<Victim@, Class<@Resource>, Attacker@>*
}

CLASS ProductionDecreaseWatcher<Class<@StandardResource>> : System {
  HAS MAX 1 This
  -X Production<Victim@Owner(NOT Attacker@), Class<@StandardResource>> BY Attacker@Player: ProductionWasAttacked<Victim@, Class<@StandardResource>, Attacker@>*
}
