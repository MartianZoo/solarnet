"The basic actions a player may take during their turn"
ABSTRACT CLASS StandardAction : HasActions {
  UseAction<Me@Player, This> IF MAX 0 ActionScope<Me@>:: ActionScope<Me@>
  UseAction<This>:: MAX 0 RequiredAction: Ok

  CLASS PlayCardAction {
    -> PlayCard<Class<ProjectCard>, Class<CardFront>, Hand> OR \
      PlayCard<Class<ProjectCard>, Class<CardFront>, StagedProject>
  }
  CLASS UseStandardProjectAction { -> UseAction<StandardProject, Action1> }
  CLASS UseActionOnCardAction { -> UseAction<@ActionCard> THEN ActionUsedMarker<@ActionCard> }
  CLASS ConvertPlantsAction { 8 Plant -> PlaceGreeneryTile }
  CLASS ConvertHeatAction { 8 Heat -> TemperatureStep }
  CLASS ClaimMilestoneAction { 8 MC -> Milestone }
  CLASS FundAwardAction {
    UseAction<This> IF 3 Award: Die
    -> 8 Owed<> THEN 6 Owed<> / Award THEN PaymentScope<Class<This>>
    -PaymentScope<Class<This>>: Award
  }
}

ABSTRACT CLASS StandardProject : HasActions, Iconic {
  HAS =1 This
  cost = Number

  "Discard cards for 1 megacredit each"
  CLASS SellPatentsProject {
    cost = 0
    -> X MC FROM ProjectCard
  }

  CLASS PowerPlantProject {
    cost = 11
    1 MC / cost -> PROD[Energy]
  }

  CLASS AsteroidProject {
    cost = 14
    1 MC / cost -> TemperatureStep
  }

  CLASS AquiferProject {
    cost = 18
    1 MC / cost -> OceanTile<>
  }

  CLASS GreeneryProject {
    cost = 23
    1 MC / cost -> PlaceGreeneryTile
  }

  CLASS CityProject {
    cost = 25
    1 MC / cost -> CityTile<>, PROD[1 MC]
  }
}

"Any component that can respond to `UseAction` signals"
ABSTRACT CLASS HasActions { HAS MAX 1 This }

"A simple enum type to identify which action of a `HasActions` you want"
ABSTRACT CLASS ActionSlot : System {
  HAS =1 This
  CLASS Action1
  CLASS Action2
  CLASS Action3
}

CLASS UseAction<HasActions, ActionSlot> : Owned<Player>, Signal, System

"A mandatory pending action the owner must perform as their next"
ABSTRACT CLASS RequiredAction : Owned<Player>, HasActions, System {
  HAS MAX 1 This
  DoRequiredActions: UseAction<This, Action1> THEN -This
}

CLASS DoRequiredActions : Owned<Player>, Signal {
  This IF MAX 0 ActionScope:: ActionScope<Me@>
}
