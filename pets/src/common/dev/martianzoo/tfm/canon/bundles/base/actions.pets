"The action a player selects and performs during their turn"
ABSTRACT CLASS StandardAction : Owned<Player>, Signal {
  This IF MAX 0 ActionScope:: ActionScope<Me@>
  This:: MAX 0 RequiredAction: Ok

  CLASS PlayProject<Class<@CardFront>> {
    This: PlayCard<Class<ProjectCard>, Class<@CardFront>, Hand>
  }
  CLASS UseStandardProject<@StandardProject> {
    This: UseAction<@StandardProject, Action1>
  }
  CLASS UseCardAction<@ActionCard<@Player>, @ActionSlot> : StandardAction<@Player> {
    This: UseAction<@ActionCard, @ActionSlot> THEN ActionUsedMarker<@ActionCard>
  }
  CLASS ConvertPlants {
    This: 8 Owed<Class<Plant>> THEN Billing<Class<ConvertPlants>, Class<Plant>> \
      THEN MAX 0 Billing: PlaceGreeneryTile
  }
  CLASS ConvertHeat {
    This: 8 Owed<Class<Heat>> THEN Billing<Class<ConvertHeat>, Class<Heat>> \
      THEN MAX 0 Billing: TemperatureStep
  }
  CLASS ClaimMilestone<Class<@Milestone>> {
    This: 8 Owed<> THEN Billing<Class<@Milestone>> THEN MAX 0 Billing: @Milestone
  }
  CLASS FundAward<Class<@Award>> {
    This IF 3 Award: Die
    This: 8 Owed<> THEN 6 Owed<> / Award THEN Billing<Class<@Award>> \
      THEN MAX 0 Billing: @Award
  }
}

ABSTRACT CLASS StandardProject : HasActions, Iconic {
  HAS =1 This
  cost = Number

  "Discard cards for 1 megacredit each"
  CLASS SellPatentsProject {
    cost = 0
    -> X MC FROM ProjectCard
  }

  CLASS PowerPlantProject {
    cost = 11
    1 MC / cost -> PROD[Energy]
  }

  CLASS AsteroidProject {
    cost = 14
    1 MC / cost -> TemperatureStep
  }

  CLASS AquiferProject {
    cost = 18
    1 MC / cost -> OceanTile<>
  }

  CLASS GreeneryProject {
    cost = 23
    1 MC / cost -> PlaceGreeneryTile
  }

  CLASS CityProject {
    cost = 25
    1 MC / cost -> CityTile<>, PROD[1 MC]
  }
}

"Any component that can respond to `UseAction` signals"
ABSTRACT CLASS HasActions { HAS MAX 1 This }

"A simple enum type to identify which action of a `HasActions` you want"
ABSTRACT CLASS ActionSlot : System {
  HAS =1 This
  CLASS Action1
  CLASS Action2
  CLASS Action3
}

CLASS UseAction<HasActions, ActionSlot> : Owned<Player>, Signal, System

"A mandatory pending action the owner must perform as their next"
ABSTRACT CLASS RequiredAction : Owned<Player>, HasActions, System {
  HAS MAX 1 This
  DoRequiredActions: UseAction<This, Action1> THEN -This
}

CLASS DoRequiredActions : Owned<Player>, Signal {
  This IF MAX 0 ActionScope:: ActionScope<Me@>
}
