        {
          "name": "MonsInsurance",
          "invariants": [ "Class<AttackHistoryWatcher>" ],
          "direct": "48 MC, PROD[4 MC], EACH Other@Player(NOT Me@) { PROD[-2 MC<Other@>] BY Other@ }",
          "effects": [
            "ResourceWasAttacked<Victim@Anyone(NOT Me@)>: 3* MC<Victim@ FROM Me@>",
            "ProductionWasAttacked<Victim@Anyone(NOT Me@)>: 3* MC<Victim@ FROM Me@>",
          ],
        },
        {
          "name": "PharmacyUnion",
          "tags": [ "MicrobeTag", "MicrobeTag" ],
          "direct": "SearchForCard<TagFilter<Class<ScienceTag>>>",
          "effects": [
            // Starting money must precede the disease losses. Placing disease first leaves
            // setup incomplete until the player undoes that choice.
            // Reference: https://boardgamegeek.com/thread/3067197/can-card-effects-really-be-done-any-order-weird-sc
            "This: (=0 Disease<This>: 54 MC)",
            // The disease task can remain pending after this corporation flips. Its gated fallback
            // states that lifetime exception without weakening the mandatory placement while it exists.
            "MicrobeTag<CardFront<Anyone>>: (Disease<This>! OR (MAX 0 This: Ok)) THEN -4* MC",
            // Check the disease count when each tag consequence executes, so two simultaneous science
            // tags can remove the last disease and then offer the flip.
            "ScienceTag<>: TerraformRating FROM Disease<This>! OR (MAX 0 Disease<This>: (PlayedEvent<Class<This>> FROM This THEN 3 TerraformRating) OR Ok)"
          ],
        },
        {
          "name": "Philares",
          "tags": [ "BuildingTag" ],
          "direct": "47 MC, RequiredAction { -> PlaceGreeneryTile }",
          "effects": [
            "Adjacency<OwnedTile, OwnedTile<Anyone(NOT Me@)>> BY Anyone: StandardResource",
