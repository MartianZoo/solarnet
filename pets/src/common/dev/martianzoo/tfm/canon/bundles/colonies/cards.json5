          "components": [
            "CLASS AridorTagWatcher<Class<@Tag>> : Cardbound<Aridor> { HAS MAX 1 This; CardFront(HAS @Tag, NOT EventCard) IF =1 CardFront(HAS @Tag, NOT EventCard): PROD[1 MC] }"
