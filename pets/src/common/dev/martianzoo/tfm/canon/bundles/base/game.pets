"An authored game item; concrete subclasses are content classes"
ABSTRACT CLASS Content

"The base Terraforming Mars rules"
CLASS TerraformingMars : Module {
  autoSelectWhen = HAS "MAX 0 TerraformingMars"

  // Premise adjustments, including negative counts, run immediately after module creation.
  This:: 2 SelectableCorporationCount
  New@Player IF MultiplayerMode:: NextPlayer<Player, New@>*

  HAS =1 GameMode, =1 MarsMap
  HAS Class<Production>, Class<NormalCityTile>
  HAS Class<SetupPhase>, Class<CorporationPhase>, Class<ResearchPhase>, Class<ActionPhase>
  HAS Class<ProductionPhase>, Class<CheckGameEnd>, Class<SolarPhase>, Class<FinalGreeneryPhase>
  HAS Class<End>, Class<VictoryPhase>
  HAS Class<UseAction>, Class<OfferAction>

  This: SellPatentsProject, PowerPlantProject, AsteroidProject, AquiferProject, GreeneryProject, CityProject
  HAS Class<PlayProject>, Class<UseStandardProject>, Class<UseCardAction>, Class<ConvertPlants>, Class<ConvertHeat>

  This: Hand, Selecting, Revealed
  This: NoTagsFilter, RequirementFilter
  This: EACH Class<@Tag> { TagFilter<Class<@Tag>> }
  This: EACH @Class<GlobalParameter> { GpIncomplete<@Class> }
  This: EACH Class<@RemoteArea> { @RemoteArea }
  This: EACH Class<@ActionSlot> { @ActionSlot }

  ModulesReady IF MAX 0 ExtendedGlobalParametersRule: StandardGpTrackRules

  @PaymentScope<Class<@CardFront>, Class<MC>, Class<PlayCard>>:: PayingFor<Class<@CardFront>, @PaymentScope>
  @PaymentScope<Class<BuySelectedCards>>:: PayingFor<Class<ProjectCard>, @PaymentScope> / ProjectCard<Selecting>
  PayingFor<Class<@CardFront>, @PaymentScope>:: EACH @Class<Tag> { PayingFor<@Class, @PaymentScope> / PriceAspectCount<Class<@CardFront>, @Class> }
  PayingFor<Class<BuildingTag>, @PaymentScope>:: Accepting<Class<Steel>, @PaymentScope>
  PayingFor<Class<SpaceTag>, @PaymentScope>:: Accepting<Class<Titanium>, @PaymentScope>
}

"Allows known incompatible content to coexist"
CLASS Unsafe : Module

"Begins the first action phase right after the corporation phase, in a game without Prelude"
CLASS NoPreludes : Module {
  autoSelectWhen = HAS "TerraformingMars, MAX 0 PreludeExpansion"
  premiseRequirement = HAS "MAX 0 PreludeExpansion"

  -Baton IF MAX 0 Baton, CorporationPhase: FINALLY { ActionPhase FROM CorporationPhase }
}

"Variant rule: each player begins with 1 of each production"
CLASS QuickStartVariant : Module {
  autoSelectWhen = HAS "TerraformingMars, MAX 0 CorporateEraExpansion"

  SetupPhase: EACH Me@Player { PROD[MC, Steel, Titanium, Plant, Energy, Heat] }
}

"A singleton immutable provider of rule content based on game options"
ABSTRACT CLASS Module : System {
  autoSelectWhen = Requirement?
  premiseRequirement = Requirement?

  HAS =1 This
}

"Signals that the complete selected Module layer is live"
// TODO.md: replace with BootstrapPhase entry after premise construction
CLASS ModulesReady : Signal, System {
  This IF MultiplayerMode:: NextPlayer<Player, Player>
}

"Exactly one player-count Module active in a playable game"
ABSTRACT CLASS GameMode : Module {
  HAS =1 GameMode

  "Multiplayer rules, including the end condition that deliberately excludes Venus"
  CLASS MultiplayerMode {
    HAS 2 Player
    autoSelectWhen = HAS "2 Player"

    HAS Class<ClaimMilestone>, Class<FundAward>
    This: GpGameEndBarrier<Class<TemperatureStep>>, GpGameEndBarrier<Class<OxygenStep>>, GpGameEndBarrier<Class<OceanTile>>

    VictoryPhase: EACH Me@Player(HAS =1 (RANK Me@Player { VictoryPoint, MC })) { Victory }
    CheckGameEnd: FinalGreeneryPhase FROM ProductionPhase
  }
}

"One of the actual people or bots playing Terraforming Mars"
ABSTRACT CLASS Player : Owner, Actor {
  HAS =1 This
  HAS MAX 1 NextPlayer<This, Anyone>, MAX 1 NextPlayer<Anyone, This>
  HAS MAX 0 NextPlayer<This, This>
  HAS MAX 1 CorporationOption<This>
  HAS MAX 1 RoundStatus<This>

  This:: StartToken<This>*

  // Queued `This` work gives every Player its production floor and payment values only after the
  // complete seat layer exists.
  This: 5 ProdOffset<This, Class<MC>> BY Admin
  This: 2 BaseResourceValue<This, Class<Steel>>, 3 BaseResourceValue<This, Class<Titanium>>

  SetupPhase IF MAX 0 BeginnerVariant: StandardOption<This>
  SetupPhase IF BeginnerVariant: BeginnerOption<This> OR StandardOption<This>
  ResearchPhase: 4 ProjectCard<This, Selecting> THEN -4? ProjectCard<This, Selecting> THEN BuySelectedCards<This>
  ActionScope<This>: LATER Admin { EACH @CardBack<This, Selecting> { -@CardBack } }
}

"A player's persistent choice of starting procedure"
ABSTRACT CLASS CorporationOption : Owned<Player>, System {
  This IF MultiplayerMode: 20 TerraformRating
  This IF SoloMode: 14 TerraformRating
}

"A unit in the configured number of corporation cards offered to each player"
CLASS SelectableCorporationCount : System

"Records that this player chose the standard starting-card procedure"
CLASS StandardOption : CorporationOption {
  This: CorporationCard / SelectableCorporationCount, \
    -CorporationCard / (SelectableCorporationCount - 1), \
    10 ProjectCard<Selecting>, -10? ProjectCard<Selecting>
}

"One step on the terraform rating track; you generally start with 20 of them"
CLASS TerraformRating : Owned<Player>, Iconic {
  ProductionPhase: 1 MC
  End: VictoryPoint
}

"Marks the player who takes the first turn"
CLASS StartToken : Owned<Player>, Iconic {
  HAS =1 StartToken
  TurnBasedPhase: Baton
}

"Identifies the Player immediately after another Player in seat order"
CLASS NextPlayer<Previous@Owner, Next@Player> : System {
  HAS MAX 1 This
  ResearchPhase IF MultiplayerMode, StartToken<Previous@>: StartToken<Next@ FROM Previous@>*

  // Continue cyclically during the action phase; otherwise stop at the start player.
  PassBaton<Previous@> IF Baton<Previous@>, ((ActionPhase, InRound<Anyone>) OR (MAX 0 ActionPhase, MAX 0 StartToken<Next@>)): FINALLY { Baton<Next@ FROM Previous@> }
  PassBaton<Previous@> IF Baton<Previous@>, ((ActionPhase, MAX 0 InRound<Anyone>) OR (MAX 0 ActionPhase, StartToken<Next@>)): FINALLY { -Baton<Previous@> }
}

"The current game phase; exactly one exists from bootstrap through the terminal VictoryPhase"
ABSTRACT CLASS Phase : System, Iconic {
  HAS =1 Phase

  CLASS BootstrapPhase
  CLASS SetupPhase {
    This: Generation
    This: FINALLY { CorporationPhase FROM This }
  }
  CLASS CorporationPhase : TurnBasedPhase {
    This: Photosynthesis
    This: EACH Class<@CardWatcher> { @CardWatcher }

    Baton<Me@Player> OR OfferAction<Me@Player> IF CorporationCard<Hand>: \
      PlayCard<Me@Player, Class<CorporationCard>, Class<CardFront>, Hand>
    Baton<Me@Player> OR OfferAction<Me@Player> IF BeginnerCard<Hand>: \
      PlayCard<Me@Player, Class<BeginnerCard>, Class<CardFront>, Hand>
    OfferAction IF MAX 0 CorporationCard<Hand>, MAX 0 BeginnerCard<Hand>: PassBaton
    CardFront<Class<CorporationCard>>: BuySelectedCards
    CardFront<Class<BeginnerCard>>: BuySelectedCards
  }
  CLASS ResearchPhase {
    This: Generation
    This: LATER Admin { EACH @ProjectCard<Anyone, Selecting> { -@ProjectCard } }
    This: FINALLY { ActionPhase FROM This }
  }
  CLASS ActionPhase : TurnBasedPhase {
    // A player who has already passed this generation stays out.
    This:: EACH Me@Player { InRound* }

    // The last baton is put down only after the last action has finished.
    -Baton IF MAX 0 Baton: FINALLY { ProductionPhase FROM This }
  }
  CLASS ProductionPhase {
    // The game goes on while anything prevents it from ending.
    This IF GameEndBarrier: FINALLY { SolarPhase FROM This }
    This IF MAX 0 GameEndBarrier: FINALLY { CheckGameEnd }
  }
  "Expansions add their solar-phase work as triggers on this phase"
  CLASS SolarPhase {
    This: FINALLY { ResearchPhase FROM This }
  }
  CLASS FinalGreeneryPhase : TurnBasedPhase {
    Baton: OfferAction
    OfferAction: ConvertPlants OR PassBaton
    -Baton IF MAX 0 Baton: FINALLY { End FROM This }
  }

  "Final scoring"
  CLASS End {
    This: FINALLY { VictoryPhase FROM This }
  }

  "The terminal game phase, which names the winner after final scoring has finished"
  CLASS VictoryPhase
}

"A phase in which players take turns holding the baton"
ABSTRACT CLASS TurnBasedPhase : Phase

"Requests an action offer; InRound or the current phase supplies its choices"
CLASS OfferAction : Owned<Player>, Signal, System

"Held during a table turn; transferred to the next player or removed when the phase ends"
CLASS Baton : Owned<Player>, System {
  HAS MAX 1 Baton
  -ActionScope<Me@>: FINALLY { OfferAction }
}

"An accepted action and all of its consequences, including responses by other players"
CLASS ActionScope<Player> : Scope, System {
  HAS MAX 1 ActionScope
  This:: EACH @WildTag<Player> { WildTagElection<@WildTag, This> }
  @WildTag<Player>:: WildTagElection<@WildTag, This>
  This: FINALLY { -This }
}

"The option of a second ordinary action while this player holds the baton"
CLASS SecondAction<Baton<@Player>> : Owned<@Player>, System { HAS MAX 1 This }

"Requests that the current holder hand over the baton or finish the turn-based phase"
CLASS PassBaton : Owned<Player>, Signal, System

"Whether a player is still taking action-phase turns or has passed"
ABSTRACT CLASS RoundStatus : Owned<Player>

"Lets a player take action-phase turns until they pass"
CLASS InRound<ActionPhase> : RoundStatus, System {
  Baton IF 2 InRound<Anyone>: SecondAction

  Baton OR (OfferAction IF MAX 0 Baton OR MAX 1 InRound<Anyone>) IF MAX 0 RequiredAction: StandardAction OR Pass
  Baton OR (OfferAction IF MAX 0 Baton OR MAX 1 InRound<Anyone>) IF RequiredAction: DoRequiredActions OR Pass
  OfferAction IF Baton, SecondAction: -SecondAction
  OfferAction IF Baton, 2 InRound<Anyone>, MAX 0 SecondAction: PassBaton
  -SecondAction IF Baton, MAX 0 RequiredAction: StandardAction OR PassBaton
  -SecondAction IF Baton, RequiredAction: DoRequiredActions OR PassBaton
}

"Instead of taking an action you can gain this, and be out for the rest of the generation"
CLASS Pass<GenerationScope> : RoundStatus {
  This:: -InRound*

  This IF ActionPhase, Baton, MAX 0 ActionScope<Me@>: FINALLY { PassBaton }
  Baton OR OfferAction IF ActionPhase: PassBaton
}

"Tells what generation we're in"
CLASS Generation : System, Iconic {
  This IF MAX 0 GenerationScope:: GenerationScope
}

"The lifetime anchor for components that exist only during the current generation"
CLASS GenerationScope : Scope, System {
  HAS MAX 1 This
  Generation:: -This THEN This
}

"Anything that prevents the game from ending"
ABSTRACT CLASS GameEndBarrier

"Signals the post-production check after the final GameEndBarrier is removed"
CLASS CheckGameEnd : Signal, System
