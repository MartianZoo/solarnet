"Expansion adding the Terraforming Committee and Global Events"
CLASS TurmoilExpansion : Module {
  UseTurmoilPolicyAction<Action1>:: UseAction<ScientistsPolicy, Action1>
  UseTurmoilPolicyAction<Action2>:: UseAction<KelvinistsPolicy, Action1>
  This: Neutral, ReferenceFilter<Class<Ruling>>
  HAS Class<LobbyAction>, Class<PaidLobbyAction>, Class<UseTurmoilPolicyAction>, Class<PartyLeader>, Class<PartyFollower>

  // Party derives each successor edge from this committee-order creation sequence.
  This: MarsFirst THEN Kelvinists THEN Reds THEN Greens THEN Unity THEN Scientists

  SetupPhase:: EACH Me@Player { LobbyDelegate }
  SetupPhase:: Chairman<Neutral>, Ruling<Greens>
  SetupPhase: RevealComingEvent
  // Deferred so that other solar-phase work, like World Government Terraforming, finishes first.
  SolarPhase: LATER { TurmoilPhase }
}

"Turmoil's part of the solar phase; a signal, not a game Phase"
CLASS TurmoilPhase : Signal, System {
  // Revise TR and resolve the current event, then form the government and change times.
  This:: EACH Me@Player { -TerraformRating*, MeasureInfluence }
  This: ResolveGlobalEvent, LATER { FormGovernment THEN ChangingTimes }
}

CLASS Terraformer26 : Milestone {
  HAS MAX 1 Terraformer26
  requirement = HAS "26 TerraformRating"
}

"A revealed Global Event card, discarded by ChangingTimes after its Current generation"
ABSTRACT CLASS GlobalEvent : Content, Iconic {
  HAS MAX 1 This
  HAS MAX 1 GlobalEventPosition<This>
  This IF RevealComingEvent:: Coming<This>
  This IF RevealDistantEvent:: Distant<This>
}

"The party receiving the neutral delegate printed in a Global Event's distant position"
ABSTRACT CLASS GePartyDistant<DistantParty@Party> : GlobalEvent {
  This IF MAX 13 Delegate<Neutral>: PartyDelegate<DistantParty@, Neutral>
}

"The party receiving the neutral delegate when a Global Event becomes current"
ABSTRACT CLASS GePartyCurrent<CurrentParty@Party> : GlobalEvent {
  Current<This> IF MAX 13 Delegate<Neutral>: PartyDelegate<CurrentParty@, Neutral>
}

"One printed board position, occupied by at most one Global Event card"
ABSTRACT CLASS GlobalEventPosition<GlobalEvent> {
  CLASS Current { HAS MAX 1 Current }
  CLASS Coming { HAS MAX 1 Coming }
  CLASS Distant { HAS MAX 1 Distant }
}

"Requests the first revealed event and then the second setup event"
CLASS RevealComingEvent : Barrier, System {
  HAS MAX 1 This
  This: GlobalEvent THEN RevealDistantEvent FROM This
}

"Requests the next event for the Distant position"
CLASS RevealDistantEvent : Barrier, System {
  HAS MAX 1 This
  This: GlobalEvent THEN -This
}

"The lower half of a Global Event, resolved separately for each player"
ABSTRACT CLASS GlobalEffect : Owned<Player>, Signal, System

"The effect chosen by the current Global Event card, waiting for the solar phase"
CLASS PendingGlobalEffect<Current<GlobalEvent>, Class<@GlobalEffect>> : System {
  ResolveGlobalEvent: EACH Me@Player { @GlobalEffect }
}

"Resolves the active Global Effect"
CLASS ResolveGlobalEvent : Signal, System

"Moves every revealed Global Event one position and requests the next event"
CLASS ChangingTimes : Signal, System {
  This:: EACH Event@GlobalEvent(HAS Current) { -Event@ }, EACH Event@GlobalEvent(HAS Coming) { Current<Event@> FROM Coming<Event@> }, \
    EACH Event@GlobalEvent(HAS Distant) { Coming<Event@> FROM Distant<Event@> }, RevealDistantEvent
}

"The owner of gray delegates, who holds a reserve of fourteen"
CLASS Neutral : Owner {
  HAS =1 This
  HAS MAX 14 Delegate<This>
}

ABSTRACT CLASS Party : Content, Iconic {
  HAS =1 This
  HAS MAX 1 AfterParty<This, Party>, MAX 1 AfterParty<Party, This>
  HAS MAX 1 PartyLeader<This, Anyone>
  This:: EACH Previous@Party(NOT This, HAS MAX 0 AfterParty) { AfterParty<Previous@, This> }
  FormGovernment IF Dominant<This>:: \
    -Ruling! THEN Ruling<This>, ApplyRulingBonus<This>, \
    EACH FormerChairman@Owner(HAS Chairman) { -Chairman<FormerChairman@> }, \
    EACH DelegateHolder@Owner(HAS PartyFollower<This>) { -14* PartyFollower<This, DelegateHolder@> }, \
    EACH Winner@Player(HAS PartyLeader<This>) { Chairman<Winner@> FROM PartyLeader<This, Winner@> THEN TerraformRating<Winner@> }, \
    EACH Winner@Neutral(HAS PartyLeader<This>) { Chairman<Winner@> FROM PartyLeader<This, Winner@> }, \
    EACH Next@Party(HAS MAX 0 Dominant, HAS =1 (RANK Ranked@Party { \
      PartyDelegate<Ranked@, Anyone>, PartyDistance<Ranked@, This> \
    })) { Dominant<Next@> }, RefillLobby
}
CLASS MarsFirst : Party {
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / BuildingTag }
  ActionPhase IF Ruling<This>:: MarsFirstPolicy
}
CLASS MarsFirstPolicy : Policy<Ruling<MarsFirst>> {
  Tile<MarsArea>: Steel
}

CLASS Scientists : Party {
  HAS =1 AfterParty<This, MarsFirst>
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / ScienceTag }
  ActionPhase IF Ruling<This>:: ScientistsPolicy
}
CLASS ScientistsPolicy : Policy<Ruling<Scientists>>, HasActions {
  10 MC -> 3 ProjectCard THEN ScientistsUsedMarker
}
CLASS ScientistsUsedMarker<GenerationScope> : Owned<Player>, System, Iconic {
  HAS MAX 1 This
}

CLASS Unity : Party {
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / PlanetaryTag }
  ActionPhase IF Ruling<This>:: UnityPolicy
}
CLASS UnityPolicy : Policy<Ruling<Unity>> {
  This:: EACH Me@Player { UnityTitaniumValue }
}
CLASS UnityTitaniumValue<UnityPolicy> : ResourceValue<Class<Titanium>> {
  HAS MAX 1 This
}

CLASS Greens : Party {
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / BioTag }
  ActionPhase IF Ruling<This>:: GreensPolicy
}
CLASS GreensPolicy : Policy<Ruling<Greens>> {
  GreeneryTile: 4 MC
}

CLASS Reds : Party {
  // Ranking is highest-first, so rank each player by everyone else's rating to find the lowest.
  ApplyRulingBonus<This> IF MAX 0 SoloMode:: EACH Lowest@Player(HAS =1 (RANK Ranked@Player { TerraformRating<Anyone(NOT Ranked@)> })) { \
    TerraformRating<Lowest@> }
  ApplyRulingBonus<This> IF SoloMode:: EACH Me@Player(HAS MAX 20 TerraformRating) { TerraformRating }
  ActionPhase IF Ruling<This>:: RedsPolicy
}
CLASS RedsPolicy : Policy<Ruling<Reds>> {
  TerraformRating: -3 MC
}

CLASS Kelvinists : Party {
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / PROD[Heat] }
  ActionPhase IF Ruling<This>:: KelvinistsPolicy
}
CLASS KelvinistsPolicy : Policy<Ruling<Kelvinists>>, HasActions {
  10 MC -> PROD[Heat, Energy]
}

"Requests the one-time bonus for the party forming the new government"
CLASS ApplyRulingBonus<Party> : Signal, System

"Performs the complete new-government sequence for the current Dominant party"
CLASS FormGovernment : Signal, System

"Identifies the Party immediately after another Party around the committee"
CLASS AfterParty<Party, Party> : System { HAS MAX 1 This }

"The forward distance from one Party to another around the committee"
CLASS PartyDistance<Party, Party> : CustomMetric

"The clockwise seat distance between owners, with unseated owners last"
CLASS PlayerDistance<Owner, Owner> : CustomMetric

ABSTRACT CLASS PartyStatus<Party> {
  "The party with the greatest delegate count"
  CLASS Dominant {
    HAS MAX 1 Dominant
    This:: -Dominant(NOT This)*
  }

  "The party whose policy and bonus govern the current generation"
  CLASS Ruling {
    HAS MAX 1 Ruling
  }
}

"A delegate; note that those the game calls 'in the reserve' simply don't exist."
ABSTRACT CLASS Delegate : Owned, Iconic {
  This IF 8 Delegate(NOT Delegate<Neutral>): Die

  "The delegate holding the committee chair"
  CLASS Chairman {
    HAS MAX 1 Chairman
    MeasureInfluence:: ChairmanInfluence
    End: VictoryPoint
  }

  "A delegate currently assigned to a political party"
  ABSTRACT CLASS PartyDelegate<Delegation@Party> {
    X This OR -X This:: RecalculateDominance<Delegation@>
    MeasureInfluence IF Dominant<Delegation@>, PartyFollower<Delegation@>:: DelegateInfluence*

    "A party member outside the leader seat"
    CLASS PartyFollower {
      // A removal can promote this new follower during the same automatic cascade.
      This IF MAX 0 PartyLeader<Delegation@, Owner(HAS =1 (RANK Ranked@Owner { PartyDelegate<Delegation@, Ranked@> }))>: Die
      // Only player removals change leadership; Admin returns followers during government formation.
      // Break successor ties from the player who removed this follower, before the old leader's demotion runs as its owner.
      -This BY Acting@Player:: EACH Next@Owner(HAS PartyFollower<Delegation@>, \
        HAS MAX 0 PartyLeader<Delegation@>, HAS =1 (RANK Ranked@Owner { \
          PartyDelegate<Delegation@, Ranked@>, PartyLeader<Delegation@, Ranked@>, Player - PlayerDistance<Acting@, Ranked@> }) \
      ) { PartyLeader<Delegation@, Next@> FROM PartyFollower<Delegation@, Next@> }
    }

    "The delegate occupying its party's leader seat"
    CLASS PartyLeader {
      This:: EACH Former@Owner(NOT Me@, HAS PartyLeader<Delegation@>) { \
        1 (PartyDelegate<Delegation@, Me@> - PartyDelegate<Delegation@, Former@>): \
          PartyFollower<Delegation@, Former@> FROM PartyLeader<Delegation@, Former@> }
      MeasureInfluence IF Dominant<Delegation@>:: PartyLeaderInfluence
      End: VictoryPoint
    }
  }

  "The player's unspent free lobbying delegate"
  CLASS LobbyDelegate : Owned<Player> {
    HAS MAX 1 This
    // Variant: other placements use the lobby only after the reserve is exhausted.
    // Automatic removal restores the player's seven-piece limit before it is checked.
    X Delegate IF 8 Delegate:: -This!
  }
}

"Gives dominance to the largest delegation, then incumbency and committee order"
CLASS RecalculateDominance<Source@Party> : Signal, System {
  This:: EACH Next@Party(HAS MAX 0 Dominant, HAS =1 (RANK Ranked@Party { PartyDelegate<Ranked@, Anyone>, Dominant<Ranked@>, \
    Party - PartyDistance<Source@, Ranked@> })) { Dominant<Next@> }
}

"Sends the player's free lobby delegate to a party"
CLASS LobbyAction : StandardAction {
  This: PartyDelegate FROM LobbyDelegate
}

"Places a delegate from the reserve for 5 M€"
CLASS PaidLobbyAction : StandardAction {
  This: 5 Owed<> THEN Billing<Class<PaidLobbyAction>> THEN (MAX 0 Billing, MAX 6 Delegate): PartyDelegate
}

"Restores free lobbying for each player who has an available delegate"
CLASS RefillLobby : Signal, System {
  This:: EACH Me@Player { LobbyDelegate* }
}

"Requests the current political influence snapshot for one player"
CLASS MeasureInfluence : Owned<Player>, Signal, System {
  // Clear this player's previous snapshot before the other components supply current influence.
  This:: EACH Measured@Influence { -Measured@! }
}

"One generation's political influence; each source below supplies at most one"
ABSTRACT CLASS Influence<GenerationScope> : Owned<Player> {
  HAS MAX 1 This

  // Chairman; leading the Dominant party; any delegates in it; Event Analysts
  CLASS ChairmanInfluence
  CLASS PartyLeaderInfluence
  CLASS DelegateInfluence
  CLASS EventAnalystsInfluence
}

"A ruling party's capability during the Action phase"
ABSTRACT CLASS Policy<Ruling<Party>, ActionPhase> {
  HAS MAX 1 Policy
}

CLASS UseTurmoilPolicyAction<ActionSlot> : StandardAction {
  DEFAULT UseTurmoilPolicyAction<Action1>
}
