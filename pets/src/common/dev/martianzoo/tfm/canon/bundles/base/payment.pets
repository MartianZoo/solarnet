"The quantity still owed in a standard-resource denomination"
CLASS Owed<@Class<StandardResource>> : Owned<Player>, Barrier, System {
  DEFAULT +Owed<Class<MC>>
  DEFAULT -Owed*
}

"Announces a card or printed tag while its payment is being adjusted"
CLASS PayingFor<Class<Component>, PaymentScope> : Owned<Player>, Signal, System

"The subject, denomination, and operation whose payment is in progress"
CLASS PaymentScope<Class<Component>, Class<@StandardResource>, Class<Component>> : Owned<Player>, Scope, Barrier, System {
  DEFAULT +PaymentScope<Class<Component>, Class<MC>, Class<Action1>>
  HAS MAX 1 PaymentScope
  This IF MAX 0 Owed<Class<@StandardResource>>: -This
  This IF Owed<Class<@StandardResource>>: \
    (MAX 0 (Accepting OR AcceptingFromCard): \
      1! Pay<Class<@StandardResource>> FROM @StandardResource / Owed<Class<@StandardResource>>) THEN -This
}

CLASS Accepting<Class<@StandardResource>, @PaymentScope<@Player>> : Owned<@Player>, MustCleanUp, System {
  HAS MAX 1 This
  DEFAULT +Accepting*
  This IF MAX 0 Owed:: -This
  @PaymentScope IF Owed, MAX 0 @StandardResource: -This
  @PaymentScope IF Owed, @StandardResource: \
    (X Pay<Class<@StandardResource>> FROM @StandardResource OR Ok) THEN -This
}

"Records an explicit payment in units of the resource spent"
CLASS Pay<@Class<StandardResource>> : Owned<Player>, Signal {
  DEFAULT +Pay<Class<MC>>
  This:: -Owed<@Class>
}

"Offers payment using the resource held by a specific card"
CLASS AcceptingFromCard<@ResourceCard<Class<@CardResource>, @Player>, @PaymentScope<@Player>> : Owned<@Player>, MustCleanUp, System {
  HAS MAX 1 This
  This IF MAX 0 Owed:: -This
  @PaymentScope IF Owed, MAX 0 @CardResource<@ResourceCard>: -This
  @PaymentScope IF Owed, @CardResource<@ResourceCard>: \
    (X PayFromCard<@ResourceCard> FROM @CardResource<@ResourceCard> OR Ok) THEN -This
}

"Records an explicit payment from a particular card's resources"
CLASS PayFromCard<ResourceCard<Class<CardResource>, @Player>> : Owned<@Player>, Signal

"A card-owned adjustment that remains in play until the next project card play"
ABSTRACT CLASS NextCardEffect<GenerationScope> : Owned<Player> {
  CardFront<Class<ProjectCard>>:: -This
}

"A component that makes a standard resource worth one M€ when paid"
ABSTRACT CLASS ResourceValue<Class<@StandardResource>> : Owned<Player> {
  // The resource being spent can be Steel or Titanium, but it pays the default M€ debt.
  Pay<Class<@StandardResource>>:: -Owed<Class<MC>>

  "One M€ of a standard resource's ordinary payment value"
  CLASS BaseResourceValue

  "One M€ of resource value represented separately from the component granting it"
  CLASS GrantedResourceValue : Cardbound
}
