"The disease cubes used by Pharmacy Union and Hospitals"
CLASS Disease : CardResource

"The moving marker placed by Mars Nomads"
CLASS NomadsMarker : Owned<Player>, AreaPiece<@LandArea> {
  HAS MAX 1 This
  Tile<@LandArea> BY Anyone: Die
}

// Published promotional Global Events, appended to the generated cards.
CLASS JovianColonyBoom : GePartyDistant<Scientists>, GePartyCurrent<Unity> {
  HAS Class<Colony>
  Current<This>: PendingGlobalEffect<Current<This>, Class<JovianTaxRights>>
}

CLASS JovianTaxRights : GlobalEffect {
  This: PROD[MC / Colony MAX 5], Titanium / Influence
}

CLASS Diaspora : GePartyDistant<MarsFirst>, GePartyCurrent<Scientists> {
  HAS Class<Colony>
  Current<This>: PendingGlobalEffect<Current<This>, Class<MicrogravityHealthProblems>>
}

CLASS MicrogravityHealthProblems : GlobalEffect {
  This: -3* MC / (Colony MAX 5 - Influence)
}

CLASS MartianProtectionism : GePartyDistant<MarsFirst>, GePartyCurrent<Unity> {
  HAS Class<VenusTag>
  Current<This>: PendingGlobalEffect<Current<This>, Class<VenusInfrastructure>>
}

CLASS VenusInfrastructure : GlobalEffect {
  This: 2 MC / VenusTag MAX 5, 2 MC / Influence
}

CLASS TitanVenusAlliance : GePartyDistant<Unity>, GePartyCurrent<Reds> {
  HAS Class<VenusTag>, Class<Colony>
  Current<This>: PendingGlobalEffect<Current<This>, Class<CloudSocieties>>
}

CLASS CloudSocieties : GlobalEffect {
  This IF StartToken: EACH @ResourceCard<Class<Floater>, Anyone> { Floater<@ResourceCard> BY Admin }
  This: Floater<ResourceCard<Class<Floater>>> / Influence
}

CLASS ImmigrationToVenus : GePartyDistant<Kelvinists>, GePartyCurrent<Greens> {
  HAS Class<VenusTag>, Class<Colony>
  Current<This>: PendingGlobalEffect<Current<This>, Class<CorrosiveRain>>
}

CLASS CorrosiveRain : GlobalEffect {
  This: (-2! Floater OR -10* MC) THEN ProjectCard / Influence
}

"The discount resources held by projects stored on Self-Replicating Robots"
CLASS RobotUnit : CardResource

"A project location outside play that holds robot resources instead of the card's printed resource type"
CLASS StagedProject<Class<@CardFront>> : CardLocation, ResourceHolder<Class<RobotUnit>>, Owned<Player> {
  HAS MAX 1 This
  This: ProjectCard<This> FROM ProjectCard<Hand>, 2 RobotUnit<This>
  ReplicateForStagedProject<Class<@CardFront>>: RobotUnit<This> / RobotUnit<This>
  PlayCard<Class<ProjectCard>, Class<Selected@CardFront>, This>:: MAX 0 Class<Selected@>(NOT Class<@CardFront>): Ok
  PayingFor<Class<@CardFront>, PaymentScope>:: -Owed / RobotUnit<This>
  -ProjectCard<This>:: -This
}

CLASS SelfReplicatingRobots : ActionCard, ActiveCard {
  cost = 7
  requirement = HAS "2 ScienceTag"

  HAS MAX 1 SelfReplicatingRobots

  -> StageForReplicatedProject<Class<CardFront>>
  -> ReplicateForStagedProject<Class<@CardFront>(HAS StagedProject<Class<@CardFront>>)>
}

CLASS StageForReplicatedProject<Class<@CardFront>> : Owned<Player>, Signal {
  This: (PriceAspectCount<Class<@CardFront>, Class<BuildingTag>> OR \
      PriceAspectCount<Class<@CardFront>, Class<SpaceTag>>): StagedProject<Class<@CardFront>>
}

CLASS ReplicateForStagedProject<Class<CardFront>> : Owned<Player>, Signal
