"The published Prelude 1 rules"
CLASS PreludeExpansion : Module {
  HAS Class<PreludePhase>
  SetupPhase IF SoloMode: -2 SoloGenerationsLeft
  // Premise adjustments, including negative counts, run immediately after module creation.
  This:: 4 SelectablePreludeCount

  CorporationOption: PreludeCard / SelectablePreludeCount, \
    -PreludeCard / (SelectablePreludeCount - 2)

  RoundOver IF CorporationPhase: PreludePhase FROM CorporationPhase
}

"A unit in the configured number of Prelude cards offered to each player"
CLASS SelectablePreludeCount : System

CLASS PreludePhase : TurnBasedPhase {
  OfferAction IF PreludeCard<Hand>: PlayPrelude
  -PreludeCard<@Player> IF MAX 0 ActionScope:: ActionScope<@Player>
  // Each Prelude has its own action scope; the player keeps the baton until all are played.
  -ActionScope<@Player> IF Baton<@Player>, MAX 0 ExtraAction<@Player>, PreludeCard<@Player, Hand>: FINALLY { OfferAction<@Player> }
  -ActionScope<@Player> IF Baton<@Player>, MAX 0 ExtraAction<@Player>, MAX 0 PreludeCard<@Player, Hand>: FINALLY { -Baton<@Player> }
  RoundOver: ActionPhase FROM This
}
