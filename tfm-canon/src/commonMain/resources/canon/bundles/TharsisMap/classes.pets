ABSTRACT CLASS TharsisMilestone : Milestone {
  CLASS Terraformer35 { requirement = HAS "35 TerraformRating" }
  CLASS Mayor { requirement = HAS "3 CityTile" }
  CLASS Gardener { requirement = HAS "3 GreeneryTile" }
  CLASS Builder8 { requirement = HAS "8 BuildingTag" }
  CLASS Planner { requirement = HAS "CARDS[16 ProjectCard<Hand>]" }
}

ABSTRACT CLASS TharsisAward : Award {
  CLASS Landlord { metric = COUNT "OwnedTile" }
  CLASS Banker { metric = COUNT "PROD[Megacredit]" }
  CLASS Scientist { metric = COUNT "ScienceTag" }
  CLASS Thermalist { metric = COUNT "Heat" }
  CLASS Miner { metric = COUNT "Metal" }
}

CLASS TharsisMap : MarsMap

