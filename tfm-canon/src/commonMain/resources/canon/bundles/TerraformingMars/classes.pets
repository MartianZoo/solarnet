"The base Terraforming Mars rules"
CLASS TerraformingMars : Module {
  HAS =1 Mode
  HAS =1 Class<Production>
  HAS =1 Class<SetupPhase>, =1 Class<CorporationPhase>, =1 Class<ResearchPhase>, =1 Class<ActionPhase>, =1 Class<ProductionPhase>, =1 Class<SolarPhase>, =1 Class<FinalGreeneryPhase>, =1 Class<EndPhase>
  HAS =1 Class<UseAction>, =1 Class<NewTurn>, =1 Class<SecondAction>
  autoSelectWhen = HAS "MAX 0 TerraformingMars"

  This:: PowerPlantSP, AsteroidSP, AquiferSP, GreenerySP, CitySP
  This:: PlayCardSA, UseCardActionSA, ConvertPlantsSA, ConvertHeatSA, SellPatents, HandleMandates
  This IF Mode, MAX 0 MarsMap:: TharsisMap

  SetupPhase IF MultiplayerMode:: BeginGame
  CorporationPhase: Photosynthesis

  PlayTag<Class<BuildingTag>> IF Owed:: Accept<Class<Steel>>
  PlayTag<Class<SpaceTag>> IF Owed:: Accept<Class<Titanium>>
  Pay<Class<Steel>>:: -2 Owed<>
  Pay<Class<Titanium>>:: -3 Owed<>
}

"Starts each player with one production of every standard resource"
CLASS QuickStartVariant : Module {
  autoSelectWhen = HAS "TerraformingMars, MAX 0 CorporateEraExpansion"
}

// PLAYERS AND OWNERSHIP

"One of the actual people or bots playing Terraforming Mars"
ABSTRACT CLASS Player : Owner, Actor {
  HAS =1 This

  This:: GrossHack<This> BY Engine
  SetupPhase:: 20 TerraformRating<This>
  SetupPhase IF QuickStartVariant: PROD[1 MC, Steel, Titanium, Plant, Energy, Heat]
  CorporationPhase:: CorporationCard
  ResearchPhase: CARDS[4 ProjectCard<Selecting>, -4 ProjectCard<Selecting>? THEN BuySelectedCards]
  MeasureAward<Award>:: AwardTally<Award> / EVAL Award.metric

  CLASS Player1, Player2, Player3, Player4, Player5
}

// MAPS AND AREAS

"Every game must have exactly one of these (Tharsis Map, etc.)"
ABSTRACT CLASS MarsMap : Module {
  HAS =1 MarsMap
  This:: CreateMapAreas<This>
}

"A hexagonal area where a tile can go"
ABSTRACT CLASS Area {
  HAS =1 This
  HAS MAX 1 Tile<This>

  "One of the usually-61 areas on the planet itself"
  ABSTRACT CLASS MarsArea {
    row = Number
    column = Number

    Tile<This>:: CreateAdjacencies<This>

    // An unreserved area
    ABSTRACT CLASS LandArea {
      ABSTRACT CLASS VolcanicArea
    }

    "An area reserved for oceans"
    ABSTRACT CLASS WaterArea

    "An area reserved for Noctis City - TODO: move to cards.json5?"
    ABSTRACT CLASS NoctisArea
  }

  "An area not on Mars (yes, it includes one for Stanford Torus)"
  ABSTRACT CLASS RemoteArea
}

"Creates every Area belonging to the selected map"
CLASS CreateMapAreas<MarsMap> : Custom

"A player's reservation of one land area"
CLASS LandClaimMarker<LandArea> : Owned<Player> {
  Tile<LandArea> BY !Owner:: Die
}

// TILES AND ADJACENCY

// A tile; if it's not on an Area / not in play, it doesn't exist yet
ABSTRACT CLASS Tile<Area> {
  // IMPL: This should narrow ownership to Owner, but bare owned-tile expressions rely on the Owned
  // default inserting an explicit contextual Owner variable, which a declared Owner bound erases.
  "Any tile that someone owns"
  ABSTRACT CLASS OwnedTile : Owned {
    "A greenery tile"
    CLASS GreeneryTile : Tile<MarsArea> {
      DEFAULT +GreeneryTile<LandArea(HAS? Neighbor<OwnedTile>, MAX 0 Tile)>

      This IF Photosynthesis: OxygenStep
      End: VictoryPoint
    }

    "A city tile, including Capital's"
    CLASS CityTile {
      DEFAULT +CityTile<LandArea(HAS MAX 0 Neighbor<CityTile<Anyone>>)>

      End: VictoryPoint / Adjacency<This, GreeneryTile<Anyone>>
    }

    "A brown special tile (specific subtypes are with the individual cards)"
    ABSTRACT CLASS SpecialTile : Tile<MarsArea> {
      DEFAULT +SpecialTile<LandArea>
    }
  }

  CLASS OceanTile : Tile<MarsArea>, GlobalParameter {
    HAS MAX 9 OceanTile
    DEFAULT +OceanTile<WaterArea>

    This IF =9 OceanTile:: GpComplete<Class<This>>
    ForwardAdjacency<This, Tile>: 2 MC
  }
}

// GLOBAL PARAMETERS

"A single step along a global parameter track; creating one gives the active player (if any) a TR"
ABSTRACT CLASS GlobalParameter : Atomized {
  DEFAULT +GlobalParameter.
  DEFAULT -GlobalParameter.

  This: TerraformRating

  "Represents 2 degrees C of temperature increase"
  CLASS TemperatureStep {
    HAS MAX 19 This

    This IF =3 This: PROD[Heat]
    This IF =5 This: PROD[Heat]
    This IF =15 This: OceanTile<>
    This IF =19 This:: GpComplete<Class<This>>
  }

  "Represents a 1% increase in oxygen level"
  CLASS OxygenStep {
    HAS MAX 14 This

    This IF =8 This: TemperatureStep
    This IF =14 This:: GpComplete<Class<This>>
  }
}

// CARDS, TAGS, AND CARD-BOUND STATE

// CARD STATES

"Anything that can hold tags"
ABSTRACT CLASS TagHolder : Owned<Player>

"A place where an unplayed card can be associated with a player"
ABSTRACT CLASS CardLocation : Owned<Player> {
  CLASS Hand { HAS =1 This }
  CLASS EventPile { HAS =1 This }
  CLASS Selecting : Temporary { HAS MAX 1 This }
  CLASS Revealed : Temporary { HAS MAX 1 This }
}

// Has subtypes for cards in hand/in play/etc, so your # of Card instances stays constant except on draw/discard
ABSTRACT CLASS Card : Owned<Player> {
  // A generic unplayed card whose face is still supplied by the follow-mode client
  ABSTRACT CLASS CardBack<CardLocation<Player>> : Owned<Player> {
    DEFAULT CardBack<Hand<Player>>
    DEFAULT +CardBack
    DEFAULT -CardBack

    CLASS CorporationCard, ProjectCard
  }

  // A card in play: face-up on the table
  ABSTRACT CLASS CardFront<Class<CardBack>> : TagHolder {
    HAS MAX 1 This<Player>

    cost = Number
    requirement = Requirement?

    ABSTRACT CLASS ActiveCard, AutomatedCard
    ABSTRACT CLASS ActionCard : HasActions
    ABSTRACT CLASS ResourceCard : ResourceHolder

    "A red *project* card"
    ABSTRACT CLASS EventCard {
      HAS =1 EventTag<This>
      This: CARDS[CardBack<EventPile, Class<This>> FROM This.]
    }
  }

  "A card in your played-events pile"
  CLASS PlayedEvent<Class<CardFront>> {
    End: GetEventVps<Class<CardFront>>
  }
}

// CARD BINDINGS, TAGS, AND EFFECTS

"Anything that can hold a particular kind of card resource"
ABSTRACT CLASS ResourceHolder<Class<CardResource>> : Owned<Owner>

// Anything that 'lives on' a card / couldn't exist without the card
ABSTRACT CLASS Cardbound<CardFront<Player>> : Owned<Player>

"Indicates that an action card has already been used this generation"
CLASS ActionUsedMarker : Cardbound<ActionCard>, Generational { HAS MAX 1 This }

"A printed wild tag creates one temporary holder for each action slot"
CLASS WildTag : Cardbound {
  HAS MAX 1 This
  // In the closed phase set, only Corporation and Final Greenery have non-wild NewTurns.
  NewTurn<Owner> IF MAX 0 CorporationPhase, MAX 0 FinalGreeneryPhase:: WildTagUse<CardFront>
  SecondAction<Owner>:: WildTagUse<CardFront>
}

"The action-scoped meaning chosen for one printed wild tag"
CLASS WildTagUse<CardFront<Player>> : TagHolder<Player>, Temporary {
  HAS MAX 1 This
  HAS MAX 1 Tag<This>
  This: Tag<This>?
}

ABSTRACT CLASS Tag<TagHolder<Player>> : Owned<Player>, Atomized {
  DEFAULT Tag<CardFront>:

  CLASS BuildingTag, SpaceTag, ScienceTag, PowerTag, CityTag
  "The printed event icon, derived for every EventCard and forbidden in authored card tags"
  CLASS EventTag : Tag<EventCard>
  ABSTRACT CLASS BioTag { CLASS PlantTag, MicrobeTag, AnimalTag }
  ABSTRACT CLASS PlanetTag { CLASS EarthTag, JovianTag }
}

// RESOURCES, PRODUCTION, AND PAYMENT

// Anything represented by a copper cube IRL, perhaps except for SRR resources (not sure)
// IMPL: This should narrow ownership to Owner, but bare resources rely on the Owned default
// inserting an explicit Owner variable; making Owner the bound erases that contextual binding.
ABSTRACT CLASS Resource : Owned {
  ABSTRACT CLASS StandardResource {
    CLASS MC
    ABSTRACT CLASS Metal {
      CLASS Steel
      CLASS Titanium
    }
    CLASS Plant
    CLASS Energy { ProductionPhase:: Heat FROM This }
    CLASS Heat
  }

  "A resource cube living on a compatible card or neutral holder, such as `Animal<Pets>`"
  // The explicit Owned occurrence links the holder's Owner to the resource's inherited Owner.
  ABSTRACT CLASS CardResource<ResourceHolder<Class<CardResource>, Owner>> : Owned<Owner> {
    DEFAULT +CardResource.

    "A particular kind of resource held by a card"
    CLASS Microbe : CardResource<ResourceHolder<Class<Microbe>>>
    CLASS Animal : CardResource<ResourceHolder<Class<Animal>>>
    CLASS Science : CardResource<ResourceHolder<Class<Science>>>
    CLASS Asteroid : CardResource<ResourceHolder<Class<Asteroid>>>
    CLASS Floater : CardResource<ResourceHolder<Class<Floater>>>
  }
}

"Each instance of this creates an instance of a standard resource during ProductionPhase"
// IMPL: This should narrow ownership to Owner, but bare production uses the same contextual
// Owner binding as Resource and becomes incorrectly unbound when Owner is the declared bound.
CLASS Production<Class<StandardResource>> : Owned {
  ProductionPhase: StandardResource
}

"One step on the terraform rating track; you generally start with 20 of them"
CLASS TerraformRating : Owned<Player> {
  ProductionPhase: 1 MC
  End: VictoryPoint
}

"The only component to have absolutely no purpose whatsoever"
CLASS Victory : Owned<Player> { HAS MAX 1 This }

"Well it's a victory point"
CLASS VictoryPoint : Owned<Player>

"A milestone already claimed; unclaimed milestones exist only as a Class<ThatMilestoneType>"
ABSTRACT CLASS Milestone : Owned<Player> {
  HAS MAX 3 Milestone
  requirement = Requirement

  This:: (EVAL This.requirement: Ok)
  End: 5 VictoryPoint
}

"A funded award; unfunded awards exist only as a Class<ThatAwardType>"
ABSTRACT CLASS Award {
  HAS MAX 1 This
  HAS MAX 3 Award
  metric = Metric
  EndPhase:: MeasureAward<This> THEN AssignAwardPlaces<This>
}

CLASS FirstPlace<Award> : Owned<Player> {
  This:: 5 VictoryPoint
}

CLASS SecondPlace<Award> : Owned<Player> {
  This:: 2 VictoryPoint
}

// TURN AND ACTION PROTOCOL

// Any component that responds to `UseAction` signals
ABSTRACT CLASS HasActions { HAS MAX 1 This }

"Identifies one of the actions offered by a component"
ABSTRACT CLASS WhichAction {
  HAS =1 This
  CLASS First, Second, Third
}

"A Signal a player sends to indicate an action they want to perform"
CLASS UseAction<HasActions, WhichAction> : Owned<Player>, Signal {
  This: MAX 0 Mandate: Ok
}

ABSTRACT CLASS Mandate : Owned<Player>, HasActions {
  HAS MAX 1 This
  MandateSignal: UseAction<This, First>
  MandateSignal: -This!
}

CLASS MandateSignal : Owned<Player>, Signal

"This is what the engine creates to grant you a 'turn' (note in some phases you get two in a row)"
CLASS NewTurn : Owned<Player>, Signal

"The engine's signal for the second action slot in an action phase turn; no Pass option"
CLASS SecondAction : Owned<Player>, Signal

"Instead of taking an action you can gain this, and be out for the rest of the generation"
CLASS Pass : Owned<Player>, Generational { HAS MAX 1 This }

"Any of the basic choices a player can make on their turn"
ABSTRACT CLASS StandardAction : HasActions {
  HAS =1 This

  "Play a project card from hand"
  CLASS PlayCardSA { -> PlayCard<Class<ProjectCard>> }

  "Claim an available milestone"
  CLASS ClaimMilestoneSA { 8 MC -> Milestone }

  "Fund an available award"
  CLASS FundAwardSA {
    8 MC -> (=0 Award: Award)
    14 MC -> (=1 Award: Award)
    20 MC -> (=2 Award: Award)
  }

  "Use an action on a card"
  CLASS UseCardActionSA { -> ActionUsedMarker<ActionCard> THEN UseAction<ActionCard> }

  "Convert plants into a greenery tile"
  CLASS ConvertPlantsSA { 8 Plant -> GreeneryTile<> }

  "Convert heat into a temperature increase"
  CLASS ConvertHeatSA { 8 Heat -> TemperatureStep }

  "Sell any number of patents"
  CLASS SellPatents { X ProjectCard<Hand> -> X MC }

  "Resolve a mandatory action before taking another standard action"
  CLASS HandleMandates { -> Mandate: MandateSignal }
}

"The persistent operation that owns research-phase and corporation-setup card purchases"
CLASS BuyCards : HasActions { HAS =1 This }

// TODO: Replace this stable invoice host with a live late-stage card-play operation.
"The persistent operation that owns card play regardless of how the play was initiated"
CLASS PlayCards : HasActions { HAS =1 This }

"A standard project, as the game defines it (but excluding Sell Patents)"
ABSTRACT CLASS StandardProject : StandardAction {
  cost = Number
}

CLASS PowerPlantSP : StandardProject {
  cost = 11
  1 MC / cost -> PROD[Energy]
}

CLASS AsteroidSP : StandardProject {
  cost = 14
  1 MC / cost -> TemperatureStep
}

CLASS BufferGasSP : StandardProject {
  cost = 16
  1 MC / cost -> TerraformRating
}

CLASS AquiferSP : StandardProject {
  cost = 18
  1 MC / cost -> OceanTile<>
}

CLASS GreenerySP : StandardProject {
  cost = 23
  1 MC / cost -> GreeneryTile<>
}

CLASS CitySP : StandardProject {
  cost = 25
  1 MC / cost -> CityTile<>, PROD[1 MC]
}

// PAY AND PLAY

CLASS BuyCard : Owned<Player>, Signal {
  This:: 3 Owed<>
  X This: Invoice<BuyCards, First>
}

"Confirms purchase of every project card remaining in the player's selection"
CLASS BuySelectedCards : Owned<Player>, Signal {
  This: (BuyCard / ProjectCard<Selecting>) THEN MAX 0 Invoice: (ProjectCard<Hand FROM Selecting> / ProjectCard<Selecting>) THEN -Selecting
}

CLASS PlayCard<Class<CardBack>, Class<CardFront>> : Owned<Player>, Signal {
  This:: CheckCardDeck<Class<CardBack>, Class<CardFront>>
  This:: (EVAL CardFront.requirement: Ok) OR HandlePossibleGpRequirement<Class<CardFront>>
  This: Owed<> / CardFront.cost THEN HandleCardTags<Class<CardFront>> THEN CardInvoice<Class<CardFront>> THEN MAX 0 Barrier: CardFront FROM CardBack<Hand>
}

CLASS PlayTag<Class<Tag>> : Owned<Player>, Signal

ABSTRACT CLASS PaymentMechanic<Class<StandardResource>> : Owned<Player>, Temporary {
  CLASS Owed : Barrier {
    DEFAULT +Owed<Class<MC>>
    DEFAULT -Owed<Class<MC>>.
    X This:: Accept<Class<StandardResource>>
  }

  CLASS Accept : Temporary {
    HAS MAX 1 This
    DEFAULT +Accept.
    Billing: X Pay<Class<StandardResource>> FROM StandardResource?
    -X Billing:: -This!
  }

  CLASS Pay : Signal {
    DEFAULT +Pay<Class<MC>>
    This:: -Owed<Class<StandardResource>>
  }
}

"Offers payment using the resource held by a specific card"
CLASS AcceptFromCard<ResourceCard<Class<CardResource>, Player>> : Owned<Player>, Temporary {
  HAS MAX 1 This
  Billing: X PayFromCard<ResourceCard> FROM CardResource<ResourceCard>?
  -X Billing:: -This!
}

"Records payment using the resource held by a specific card"
CLASS PayFromCard<ResourceCard<Class<CardResource>, Player>> : Owned<Player>, Signal

"A finalized debt; removing it signals that its denomination has been fully paid"
ABSTRACT CLASS Billing<HasActions, WhichAction, Class<StandardResource>> : Owned<Player>, Barrier {
  HAS MAX 1 This
  This IF MAX 0 Owed<Class<StandardResource>>:: -This!
  -X Owed<Class<StandardResource>> IF MAX 0 Owed<Class<StandardResource>>:: -This!
}

"The invoice produced by an action with a standard-resource cost"
CLASS Invoice : Billing {
  DEFAULT +Invoice<HasActions, WhichAction, Class<MC>>
}

"The finalized debt for playing a particular card"
CLASS CardInvoice<Class<CardFront>> : Billing<PlayCards, First, Class<MC>>

"A card-owned adjustment that remains in play until the next card-play"
ABSTRACT CLASS NextCardEffect : Owned<Player>, Generational {
  Billing<PlayCards>:: -This!
}

// PHASES

"The current game phase; exactly one exists from the start of SetupPhase onward"
ABSTRACT CLASS Phase : System {
  HAS =1 Phase

  CLASS SetupPhase
  CLASS CorporationPhase {
    NewTurn: PlayCard<Class<CorporationCard>>, CARDS[10 ProjectCard<Selecting>, -10 ProjectCard<Selecting>? THEN BuySelectedCards]
  }
  CLASS ResearchPhase
  CLASS ActionPhase {
    NewTurn: UseAction<StandardAction> OR Pass
    SecondAction: UseAction<StandardAction>?
  }
  CLASS ProductionPhase
  CLASS SolarPhase
  CLASS FinalGreeneryPhase {
    NewTurn: UseAction<ConvertPlantsSA, First>?
  }
  CLASS EndPhase
}

// TIME FLOW

"Tells what generation we're in"
CLASS Generation : System

"Supertype for anything that automatically disappears between generations"
ABSTRACT CLASS Generational {
  Generation:: -This.
}

"Indicates that greenery placement raises oxygen"
CLASS Photosynthesis {
  HAS MAX 1 This
  FinalGreeneryPhase: -This!
}

"Starts generation one after mode-specific setup is complete"
CLASS BeginGame : Signal, System {
  This:: Generation THEN StartToken<Player1>
}

"Records that a particular global parameter track has reached its maximum"
CLASS GpComplete<Class<GlobalParameter>> { HAS MAX 1 This }

"Records that the current generation will be the last one played"
CLASS LastCall { HAS MAX 1 This }

"This Signal causes components to pay out victory points"
CLASS End : Signal, System

"Signals that the final score is available"
CLASS FinalScore : Signal, System

"Asks the first player to choose one mandatory global-parameter increase performed by Engine"
CLASS WorldGovernmentTerraforming : Signal, System

"Asks the first player where an ocean is placed while preserving the performing Player"
CLASS FirstPlayerOcean<Player> : Signal

"Marks the player who takes the first turn; passes one seat left with each new generation"
CLASS StartToken : Owned<Player> {
  HAS MAX 1 StartToken
  Generation: PassLeft<This>
  FirstPlayerOcean<Player> BY Anyone: OceanTile<> BY Player
  WorldGovernmentTerraforming BY Anyone: GlobalParameter! BY Engine
}

// GAME CONFIGURATION

"An affirmative, immutable Module active in a playable game"
ABSTRACT CLASS Module : System {
  HAS =1 This
  autoSelectWhen = Requirement?
  premiseRequirement = Requirement?
  -This:: Die!
}

"Exactly one player-count Module active in a playable game"
ABSTRACT CLASS Mode : Module {
  HAS MAX 1 Mode
  premiseRequirement = HAS "=1 TerraformingMars"

  "Multiplayer rules, including the end condition that deliberately excludes Venus"
  CLASS MultiplayerMode {
    HAS 2 Player
    autoSelectWhen = HAS "2 Player"

    This:: ClaimMilestoneSA, FundAwardSA

    GpComplete IF GpComplete<Class<TemperatureStep>>, GpComplete<Class<OxygenStep>>, GpComplete<Class<OceanTile>>:: LastCall.
    EndPhase: End THEN FinalScore
    FinalScore: MultiplayerVictoryCheck
  }
}

CLASS MultiplayerVictoryCheck : Custom

// SOLO MODE

"Solo play with a neutral opponent and a fixed generation limit"
CLASS SoloMode : Mode {
  HAS =1 Player
  autoSelectWhen = HAS "=1 Player"

  HAS =1 SoloVariant, =1 Class<FakeResourceGiver>, =1 Class<FakeResourceHolder>, =1 Class<SoloVictoryCheck>

  This:: SoloOpponent
  This IF MAX 0 Tr63SoloVariant:: StandardSoloVariant.
  SetupPhase:: GenerationSetup THEN BeginGame
  GenerationSetup: 14 SoloGenerationsLeft
  Generation: -SoloGenerationsLeft.
  -SoloGenerationsLeft IF MAX 0 SoloGenerationsLeft: LastCall
  SetupPhase: -6 TerraformRating<Player1>
  EndPhase: End THEN FinalScore
}

"Exactly one solo objective Module active in a solo game"
ABSTRACT CLASS SoloVariant : Module {
  HAS MAX 1 SoloVariant, =1 SoloMode

  "The original solo victory objective: complete every required global parameter"
  CLASS StandardSoloVariant {
    SoloVictoryCheck IF GpComplete<Class<TemperatureStep>>, GpComplete<Class<OxygenStep>>, GpComplete<Class<OceanTile>>, MAX 0 SoloVictoryRequirement: Victory<Player1>.
  }

  "The solo objective is 63 terraform rating instead of completed global parameters"
  CLASS Tr63SoloVariant {
    This:: BufferGasSP

    SetupPhase: Tr63SoloObjective
    SoloVictoryCheck IF 63 TerraformRating<Player1>: Victory<Player1>.
  }
}

"Records that a selected expansion extends the ordinary solo victory objective"
CLASS SoloVictoryRequirement { HAS MAX 1 This }

"Lets selected variants initialize solo state immediately before generation 1 begins"
CLASS GenerationSetup : Signal, System

"Records that the selected solo objective is 63 terraform rating"
CLASS Tr63SoloObjective { HAS MAX 1 This }

"The number of generations remaining in a solo game"
CLASS SoloGenerationsLeft

"Checks whether the solo player satisfied the configured victory objective"
CLASS SoloVictoryCheck : Signal, System

"The passive owner of the removable neutral stock in solo mode"
CLASS SoloOpponent : Owner {
  HAS MAX 1 This
  SetupPhase: SoloStartingPlacement
}

"Creates the two independent city-and-greenery placement tasks in solo setup"
CLASS SoloStartingPlacement : Signal, System, Owned<SoloOpponent> {
  HAS MAX 1 This
  This: CityTile<> THEN GreeneryTile<LandArea(HAS Neighbor<CityTile<>>)>
  This: CityTile<> THEN GreeneryTile<LandArea(HAS Neighbor<CityTile<>>)>
}

"Creates the neutral solo stock of each standard resource and its production"
CLASS FakeResourceGiver<Class<StandardResource>> : Owned<SoloOpponent> {
  HAS =1 This
  SetupPhase: 42 StandardResource
  SetupPhase: PROD[42 StandardResource]
  -StandardResource BY Player:: StandardResource BY Engine
  StandardResource BY Player:: -StandardResource BY Engine
  PROD[-StandardResource] BY Player:: PROD[StandardResource] BY Engine
  PROD[StandardResource] BY Player:: PROD[-StandardResource] BY Engine
}

"A neutral solo-mode holder for each kind of removable card resource"
CLASS FakeResourceHolder : ResourceHolder<Class<CardResource>>, Owned<SoloOpponent> {
  HAS =1 This
  SetupPhase: 42 CardResource<This>
  -CardResource<This> BY Player:: CardResource<This> BY Engine
  CardResource<This> BY Player:: -CardResource<This> BY Engine
}

// When Tile B is placed next to existing Tile A, a ForwardAdj<A, B> and BackwardAdj<B, A> are created
// IMPL: Both bounds should be Tile<MarsArea>, but current header-variable inference links the two
// repeated MarsArea occurrences and therefore requires adjacent tiles to occupy the same area.
ABSTRACT CLASS Adjacency<Tile, Tile> {
  CLASS ForwardAdjacency, BackwardAdjacency
}

"Triggers creating Neighbors and Adjacencies"
CLASS CreateAdjacencies<MarsArea> : Custom

"A virtual metric whose count is the number of a particular resource printed as an area's bonus"
CLASS MapBonus<Class<Resource>, MarsArea> : Custom

"Moves an owned component to the next player in seat order"
CLASS PassLeft<StartToken> : Custom

"(Like anything extending Custom) an implementation detail backed by Kotlin code"
CLASS GetEventVps<Class<CardFront>> : Owned<Player>, Custom

"Copies the single immediate production box on a chosen card"
CLASS CopyProductionBox<CardFront<Player>> : Owned<Player>, Custom

"You didn't see this"
CLASS GrossHack : Owned<Player>, System {
  This:: PROD[5 MC]
  ProductionPhase: -5 MC
}

CLASS CheckCardDeck<Class<CardBack>, Class<CardFront>> : Custom
CLASS HandlePossibleGpRequirement<Class<CardFront>> : Owned<Player>, Custom
CLASS HandleCardTags<Class<CardFront>> : Owned<Player>, Custom

"A temporary shortfall between a printed global requirement and the current parameter"
CLASS Required<Class<GlobalParameter>> : Owned<Player>, Barrier {
  DEFAULT -Required.
}

"Adding a Tile automatically creates one of these per adjacent area"
CLASS Neighbor<Tile<MarsArea>, MarsArea> : Hidden

CLASS MeasureAward<Award> : Signal, System
CLASS AwardTally<Award> : Owned<Player>
CLASS AssignAwardPlaces<Award> : Custom
