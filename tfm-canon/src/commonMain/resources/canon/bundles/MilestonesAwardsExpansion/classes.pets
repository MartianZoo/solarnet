"Counts the tiles in a player's largest contiguous group of owned tiles"
CLASS TileInLargestGroup : Owned<Player>, Custom

// Hydrologist and Thawer need global parameters to become Owned components.
// Lobbyist and Politician need Turmoil.
// Briber is coming soon.
//
// Reprinted goals retain the canonical declarations owned by their original map bundles. Only new
// goals and revised goals with distinct implementations are declared here.

CLASS Builder7 : Milestone { requirement = HAS "7 BuildingTag" }
CLASS Engineer : Milestone { requirement = HAS "10 PROD[Energy OR Heat]" }
CLASS Farmer : Milestone { requirement = HAS "5 (Animal OR Microbe)" }
CLASS Geologist : Milestone { requirement = HAS "3 (OwnedTile<VolcanicArea> OR OwnedTile(HAS Neighbor<VolcanicArea>))" }
CLASS Landshaper : Milestone { requirement = HAS "CityTile, GreeneryTile, SpecialTile" }
CLASS Legend4 : Milestone { requirement = HAS "CARDS[4 CardBack<EventPile>]" }
CLASS Merchant : Milestone { requirement = HAS "2 Megacredit, 2 Steel, 2 Titanium, 2 Plant, 2 Energy, 2 Heat" }
CLASS Philantropist : Milestone { requirement = HAS "5 CardFront(HAS CitationsIgnoringRemoves<Class<VictoryPoint>>)" }
CLASS Pioneer4 : Milestone { requirement = HAS "4 Colony" }
// GrossHack contributes five synthetic M€ production components, so 21 models the printed
// combined production threshold of 16.
CLASS Producer : Milestone {
  HAS MAX 0 QuickStartVariant
  requirement = HAS "21 PROD[StandardResource]"
}
CLASS Producer22 : Milestone {
  HAS QuickStartVariant
  requirement = HAS "22 PROD[StandardResource]"
}
CLASS Spacefarer : Milestone { requirement = HAS "4 SpaceTag" }
CLASS Sponsor : Milestone { requirement = HAS "3 CardFront(HAS 20 cost)" }
CLASS Tactician4 : Milestone { requirement = HAS "4 CardFront(HAS requirement)" }
CLASS Terraformer29 : Milestone { requirement = HAS "29 TerraformRating" }
CLASS Terran : Milestone { requirement = HAS "5 EarthTag" }
CLASS Tycoon10 : Milestone { requirement = HAS "10 (ActiveCard OR AutomatedCard)" }

CLASS Administrator : Award { metric = COUNT "CardFront(HAS MAX 0 Tag)" }
CLASS Biologist : Award { metric = COUNT "BioTag" }
CLASS Collector : Award { metric = COUNT "Class<Resource>(HAS Resource<Owner>)" }
CLASS Constructor : Award { metric = COUNT "Colony OR CityTile" }
CLASS Highlander : Award { metric = COUNT "OwnedTile<MarsArea(HAS MAX 0 Neighbor<OceanTile>)>" }
CLASS Landscaper : Award { metric = COUNT "TileInLargestGroup" }
CLASS Manufacturer : Award { metric = COUNT "PROD[Steel OR Heat]" }
CLASS Promoter : Award { metric = COUNT "CARDS[CardBack<EventPile>]" }
CLASS Traveller : Award { metric = COUNT "JovianTag OR EarthTag" }
CLASS Visionary : Award { metric = COUNT "CARDS[ProjectCard<Hand>]" }
