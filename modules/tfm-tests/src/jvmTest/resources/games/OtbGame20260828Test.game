Green: useAction2(TitanShuttles) {
    selectTask(-9! Floater<TitanShuttles> THEN 9! Titanium)
    -9 Floater<TitanShuttles>
    9 Titanium
}

// "I'm going to play Dirigibles, which costs 11 money."
