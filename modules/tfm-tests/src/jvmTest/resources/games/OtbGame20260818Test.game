    EACH @WildTagElection(HAS MAX 0 Tag) { Tag<@WildTagElection>? } VIA RoboticWorkforce
    selectTask(-ProjectCard! THEN ProjectCard!)
    -ProjectCard
    ProjectCard
    0 BuildingTag<WildTagElection<WildTag<ResearchCoordination>, ActionScope>>
    CopyProductionBox<IndustrialMicrobes>
    PROD[Energy]
    PROD[Steel]
}
