// Test inference: unnamed draws are assigned in the order the cards are later played.
// keep all ten project cards
Me: Setup {
    14 TerraformRating
    CorporationCard
    10 ProjectCard<Selecting> VIA Me
    2 PreludeCard
    -0 ProjectCard<Selecting>
}

Me: playCard(SaturnSystems) {
    42 MC VIA SaturnSystems
    PROD[Titanium]
    PROD[MC]
    pay(30 MC)
    10 ProjectCard<Hand FROM Selecting>
}

Me: playCard(Biolab) {
    PROD[Plant]
    3 ProjectCard
}
Me: playCard(AcquiredSpaceAgency) {
    6 Titanium
    2 SearchForCard<TagFilter<Class<SpaceTag>>>
}

Me: playCard(EarthOffice) {
    pay(1 MC)
}
Me: playCard(MediaGroup) {
    pay(3 MC)
}
Me: playCard(InvestmentLoan) {
