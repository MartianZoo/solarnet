// Replay: HellasPromoGameTest
// Kotlin scenario: test/jvm/dev/martianzoo/tfm/tests/replays/HellasPromoGameTest.kt
// Comments retain the source replay's evidence, corrections, and uncertainties.

Config {
    Player1, Player2
    HellasMap
    PreludeExpansion
    promos:cards
}

GlobalEventDeck {
}

Player1: Setup {
    20 TerraformRating
    CorporationCard
    10 ProjectCard<Selecting> VIA Player1
    2 PreludeCard
    -3 ProjectCard<Selecting>
}

Player2: Setup {
    20 TerraformRating
    CorporationCard
    10 ProjectCard<Selecting> VIA Player2
    2 PreludeCard
    -5 ProjectCard<Selecting>
}

Player1: PlayCard(InterplanetaryCinematics) {
    30 MC VIA InterplanetaryCinematics
    20 Steel
    Pay(21 MC)
    7 ProjectCard<Hand FROM Selecting>
}

Player2: PlayCard(PharmacyUnion) {
    SearchForCard<TagFilter<Class<ScienceTag>>>
    54 MC VIA PharmacyUnion
    Pay(15 MC)
    5 ProjectCard<Hand FROM Selecting>
    Disease<PharmacyUnion>
    Disease<PharmacyUnion>
    -4 MC
    -4 MC
}

Player1: PlayCard(UnmiContractor) {
    3 TerraformRating
    ProjectCard
}
Player1: PlayCard(CorporateArchives) {
    13 MC
    7 ProjectCard<Selecting>
    2 ProjectCard<Hand FROM Selecting>
}

Player2: PlayCard(BiosphereSupport) {
    PROD[-MC]
    PROD[2 Plant]
}
Player2: PlayCard(SocietySupport) {
    PROD[-MC]
    PROD[Plant]
    PROD[Energy]
    PROD[Heat]
}

// Generation 1 (Player1 first)
Player1: PlayCard(MediaGroup) {
    Pay(6 MC)
}
Player1: PlayCard(Sabotage) {
    Pay(1 MC)
    5 MC
    -7 MC<Player2>
}

Player2: PlayCard(Research) {
    Pay(11 MC)
    2 ProjectCard
    TerraformRating FROM Disease<PharmacyUnion>
    TerraformRating FROM Disease<PharmacyUnion>
}
// decline Pharmacy Union's optional flip
Player2: PlayCard(MartianSurvey) {
    Pay(9 MC)
    2 ProjectCard
    Ok
}

Player1: Pass

Player2: PlayCard(SearchForLife) {
    Pay(3 MC)
    SelectTask(PlayedEvent<Class<PharmacyUnion>> FROM PharmacyUnion! THEN 3! TerraformRating)
    3 TerraformRating
}
// decline reward
Player2: UseAction1(SearchForLife) {
    Pay(1 MC)
    ProjectCard<Revealed>
    0 ClaimCardReward<TagFilter<Class<MicrobeTag>>, SearchForLife>
    -ProjectCard<Revealed>
}
Player2: Pass

Player1: Production {
    23 MC
}

Player2: Production {
    23 MC
    3 Plant
    Energy
    Heat
}

// Generation 2 (Player2 first)
Player1: Research {
    4 ProjectCard<Selecting>
    -3 ProjectCard<Selecting>
    Pay(3 MC)
    ProjectCard<Hand FROM Selecting>
}

Player2: Research {
    4 ProjectCard<Selecting>
    -ProjectCard<Selecting>
    Pay(9 MC)
    3 ProjectCard<Hand FROM Selecting>
}

Player2: UseStandardProject(SellPatentsProject) {
    MC FROM ProjectCard
}
Player2: PlayCard(VestaShipyard) {
    Pay(15 MC)
    PROD[Titanium]
}

Player1: PlayCard(EarthCatapult) {
    Pay(23 MC)
}
// no MC paid
Player1: PlayCard(OlympusConference) {
    Pay(4 Steel)
    Science<OlympusConference>
}

Player2: Pass

Player1: PlayCard(DevelopmentCenter) {
    Pay(4 Steel, 1 MC)
    ProjectCard FROM Science<OlympusConference>
}
Player1: PlayCard(GeothermalPower) {
    Pay(4 Steel, 1 MC)
    PROD[2 Energy]
}
Player1: PlayCard(MirandaResort) {
    Pay(10 MC)
    PROD[4 MC]
}
Player1: PlayCard(Hackers) {
    Pay(1 MC)
    PROD[-Energy]
    PROD[2 MC]
    PROD[-2 MC<Player2>]
}
Player1: PlayCard(MicroMills) {
    Pay(1 MC)
    PROD[Heat]
}
Player1: Pass

Player1: Production {
    29 MC
    Energy
    Heat
}

Player2: Production {
    21 MC
    3 Plant
    Energy VIA Production
    Heat VIA Production
    Heat FROM Energy
    Titanium
}

// Generation 3 (Player1 first)
Player1: Research {
    4 ProjectCard<Selecting>
    -ProjectCard<Selecting>
    Pay(9 MC)
    3 ProjectCard<Hand FROM Selecting>
}

Player2: Research {
    4 ProjectCard<Selecting>
    -3 ProjectCard<Selecting>
    Pay(3 MC)
    ProjectCard<Hand FROM Selecting>
}

Player1: UseAction1(DevelopmentCenter) {
    Pay(1 Energy)
    ProjectCard
}
Player1: PlayCard(ImmigrantCity) {
    Pay(5 Steel, 1 MC)
    PROD[-Energy]
    PROD[-2 MC]
    NormalCityTile<Hellas_9_7>
    PROD[MC]
    -6 MC
