Yellow: useAction1(AquiferPumping) {
    pay(8 MC)
    OceanTile<Cimmeria_9_5>
    TerraformRating
    4 Plant
    4 MC
}

Green: useAction1(SpaceElevator) {
    pay(1 Steel)
    5 MC
}

// Viron repeats Aquifer Pumping and places the ocean at 8,4.
Yellow: useAction1(Viron) {
