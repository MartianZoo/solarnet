    TerraformRating
    2 MC
}

// Focused Organization discards Physics Complex and 1 M€, then gains steel.
Green: useAction1(FocusedOrganization) {
    -ProjectCard
    -MC
    ProjectCard
    Steel
}

// "Methane from titan. That'll be, spend my five titanium is 15 and 13 real." It gains two
// plant production and two heat production.
Yellow: playCard(MethaneFromTitan) {
    pay(5 Titanium, 13 MC)
    PROD[2 Heat]
    PROD[2 Plant]
}

// Sponsored Academies costs 9 M€: discard Urbanized Area, draw three, and Yellow draws one.
Green: playCard(SponsoredAcademies) {
    pay(9 MC)
    -ProjectCard
    EACH Other@Player(NOT Green) { ProjectCard<Other@Player>! }
    3 ProjectCard
    ProjectCard<Yellow>
}

Yellow: pass

Green: pass

// Production.
Green: Production {
    20 MC
}

Yellow: Production {
    28 MC
    Titanium
    2 Heat
    2 Plant
}

// "I'm going to world gov. Akigen. Akigen up to three."
Yellow: WorldGovernment {
    OxygenStep! BY Admin
}

