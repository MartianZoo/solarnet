    -3 ProjectCard<Selecting>
    Pay(3 MC)
    ProjectCard<Hand FROM Selecting>
}

Purple: Research {
    4 ProjectCard<Selecting>
    -ProjectCard<Selecting>
    Pay(9 MC)
    3 ProjectCard<Hand FROM Selecting>
}

