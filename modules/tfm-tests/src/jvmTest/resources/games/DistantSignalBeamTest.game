Pink: Setup {
    20 TerraformRating
    CorporationCard
    10 ProjectCard<Selecting> VIA Pink
    2 PreludeCard
    -3 ProjectCard<Selecting>
}

Purple: Setup {
    20 TerraformRating
    // Keep all ten starting project cards.
    CorporationCard
    10 ProjectCard<Selecting> VIA Purple
    2 PreludeCard
    -0 ProjectCard<Selecting>
}

// Generation 1
Pink: PlayCard(MorningStarInc) {
    50 MC VIA MorningStarInc
    Pay(21 MC)
    7 ProjectCard<Hand FROM Selecting>
}

Purple: PlayCard(Aridor) {
    40 MC VIA Aridor
    Pay(30 MC)
    10 ProjectCard<Hand FROM Selecting>
}

Pink: PlayCard(AtmosphericEnhancers) {
    VenusStep*, VenusStep*
    2 TerraformRating
    2 SearchForCard<ReferenceFilter<Class<Floater>>>
}
Pink: PlayCard(PolarIndustries) {
    OceanTile<Hellas_5_6>
    TerraformRating
    PROD[2 Heat]
    ProjectCard
}

Purple: PlayCard(ProjectEden) {
    -3 ProjectCard
    PROD[2 MC]
    OceanTile<Hellas_4_6>
    GreeneryTile<Hellas_4_5>
    NormalCityTile<Hellas_4_4>
    TerraformRating
    Plant
    2 MC
    OxygenStep
    TerraformRating
    Steel VIA Hellas_4_5
    4 MC
    2 Steel
}
// Database save 4: Project Eden introduced Purple's first city and plant tags.
Purple: PlayCard(AlliedBank) {
    3 MC
    PROD[5 MC]
}

// Database save 5: Allied Bank introduced Purple's first Earth tag.
Pink: DoRequiredActions {
    3 SearchForCard<TagFilter<Class<VenusTag>>>
}
Pink: PlayCard(TitanShuttles) {
    Pay(23 MC)
}

Purple: DoRequiredActions {
    Luna
}

Pink: UseAction1(TitanShuttles) {
    2 Floater<TitanShuttles>
}

Purple: PlayCard(PeroxidePower) {
    Pay(3 Steel, 1 MC)
    PROD[-MC] VIA PeroxidePower
    PROD[2 Energy] VIA PeroxidePower
    PROD[2 MC]
}

// Database save 15: Peroxide Power introduced Purple's first power and building tags.
Pink: PlayCard(SulphurEatingBacteria) {
    Pay(6 MC)
}

Purple: PlayCard(Casinos) {
    Pay(5 MC)
    PROD[-Energy]
    PROD[4 MC]
}

Pink: UseAction1(SulphurEatingBacteria) {
    Microbe<SulphurEatingBacteria>
}

Purple: PlayCard(Tardigrades) {
    Pay(4 MC)
    PROD[MC]
}

// Database save 27: Tardigrades introduced Purple's first microbe tag.
Pink: Pass

Purple: UseAction1(Tardigrades) {
    Microbe<Tardigrades>
}
Purple: PlayCard(RotatorImpacts) {
    Pay(6 MC)
    PROD[MC]
}
// Database save 33: Rotator Impacts introduced Purple's first space tag.
Purple: Pass

Pink: Production {
    23 MC
    2 Heat
}

Purple: Production {
    36 MC
    Energy
}

Pink: WorldGovernment {
