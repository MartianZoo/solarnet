    40 MC VIA ArcadianCommunities
    10 Steel
    Pay(15 MC)
    5 ProjectCard<Hand FROM Selecting>
}

Pink: PlayCard(Teractor) {
    60 MC VIA Teractor
    Pay(24 MC)
    8 ProjectCard<Hand FROM Selecting>
}

// "I chose my preludes because they rhyme. I'm just kidding."
