// just like my steel."
Aqua: PlayCard(BoomTown) {
    PROD[2 Titanium]
    NormalCityTile<Vastitas_6_9>
    2 Titanium
}
// "Oh, is it double down?" "Double down!" "It's actually pretty funny."
Aqua: PlayCard(DoubleDown) {
    CopyPrelude<BoomTown>
    PROD[2 Titanium]
    NormalCityTile<Vastitas_8_7>
    Plant
    Steel
}

