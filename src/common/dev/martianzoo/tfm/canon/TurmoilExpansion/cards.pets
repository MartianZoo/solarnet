CLASS Election : GlobalEvent {
  PlaceDistantDelegate<Class<This>>:: PartyDelegate<Greens, Neutral> FROM ReserveDelegate<Neutral>.
  Current<Class<This>>:: PartyDelegate<MarsFirst, Neutral> FROM ReserveDelegate<Neutral>.
  ResolveGlobalEvent<Class<This>> IF MultiplayerMode:: \
    EACH Player(HAS =1 (RANK Player { Influence<Player> OR BuildingTag<Player> OR CityTile<Player> })) { 2 TerraformRating }
  ResolveGlobalEvent<Class<This>> IF MultiplayerMode:: \
    EACH Player(HAS =2 (RANK Player { Influence<Player> OR BuildingTag<Player> OR CityTile<Player> })) { TerraformRating }
  ResolveGlobalEvent<Class<This>> IF SoloMode:: \
    EACH Player { TerraformRating / 5 (Influence OR BuildingTag OR CityTile) MAX 2 }
}

