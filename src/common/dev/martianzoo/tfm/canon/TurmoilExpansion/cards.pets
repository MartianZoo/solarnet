// Turmoil declarations that accompany the generated project cards.

// Published Turmoil Global Events.
CLASS DemocraticReform : GePartyDistant<MarsFirst>, GePartyCurrent<Greens> {
  Current<This>:: AquiferReleasedByPublicCouncil<This>
}

CLASS AquiferReleasedByPublicCouncil : GlobalEffect {
  ResolveGlobalEvent IF GpIncomplete<Class<OceanTile>>: \
    EACH Starter@Player(HAS StartToken) { AdminOceanPlacement<Starter@> }
  ResolveGlobalEvent: EACH Me@Player { Plant / Influence, Steel / Influence }
}

CLASS MiningRestrictions : GePartyDistant<Reds>, GePartyCurrent<Unity> {
  Current<This>:: AsteroidMiningGlobalEffect<This>
}

CLASS AsteroidMiningGlobalEffect : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { Titanium / JovianTag MAX 5, Titanium / Influence }
}

CLASS SolarnetGlobalEvent : GePartyDistant<Unity>, GePartyCurrent<Greens> {
  Current<This>:: CelebrityLeaders<This>
}

CLASS CelebrityLeaders : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { 2 MC / PlayedEvent MAX 5, 2 MC / Influence }
}

CLASS FreeAcademiaTreaty : GePartyDistant<Scientists>, GePartyCurrent<Scientists> {
  Current<This>:: Diversity<This>
}

CLASS Diversity : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { \
    10 MC / (9 (Class<@Tag>(HAS @Tag) OR Influence) MAX 1) \
  }
}

CLASS MinimalImpactPolicy : GePartyDistant<Reds>, GePartyCurrent<Unity> {
  Current<This>:: DryDeserts<This>
}

CLASS DryDeserts : GlobalEffect {
  ResolveGlobalEvent IF GpIncomplete<Class<OceanTile>>: \
    EACH Starter@Player(HAS StartToken) { RemoveOceanForGlobalEvent<Starter@> }
  ResolveGlobalEvent: EACH Me@Player { ResolveDryDeserts }
}

"Lets the first player return one placed Ocean without reducing rating"
CLASS RemoveOceanForGlobalEvent : Owned<Player>, Signal, System { This: -OceanTile }

"Lets each of one player's influence choose its own Dry Deserts resource"
CLASS ResolveDryDeserts : Owned<Player>, Signal, System {
  This: EACH Influence { StandardResource }
}

CLASS ExperimentalLifeforms : GePartyDistant<Greens>, GePartyCurrent<Reds> {
  Current<This>:: EcoSabotage<This>
}

CLASS EcoSabotage : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { -Plant! / (Plant - Influence - 3) }
}

CLASS SelfSufficiencyProgram : GePartyDistant<Greens>, GePartyCurrent<MarsFirst> {
  Current<This>:: Election<This>
}

CLASS Election : GlobalEffect {
  ResolveGlobalEvent IF MultiplayerMode: \
    EACH Me@Player(HAS =1 (RANK Ranked@Player { \
      Influence<Ranked@> OR \
      BuildingTag<Ranked@> OR \
      CityTile<Ranked@> \
    })) { 2 TerraformRating }
  ResolveGlobalEvent IF MultiplayerMode: \
    EACH Me@Player(HAS =2 (RANK Ranked@Player { \
      Influence<Ranked@> OR \
      BuildingTag<Ranked@> OR \
      CityTile<Ranked@> \
    })) { TerraformRating }
  ResolveGlobalEvent IF SoloMode: \
    EACH Me@Player { TerraformRating / 5 (Influence OR BuildingTag OR CityTile) MAX 2 }
}

CLASS TerraformingLobbying : GePartyDistant<Kelvinists>, GePartyCurrent<Unity> {
  Current<This>:: GenerousFunding<This>
}

CLASS GenerousFunding : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { \
    2 MC / 5 (TerraformRating - 15) MAX 5, 2 MC / Influence \
  }
}

CLASS HeatFirstPolicy : GePartyDistant<Kelvinists>, GePartyCurrent<Greens> {
  Current<This>:: GlobalDustStorm<This>
}

CLASS GlobalDustStorm : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { \
    -Heat! / Heat, -2 MC. / (BuildingTag MAX 5 - Influence) \
  }
}

CLASS RedResistance : GePartyDistant<Reds>, GePartyCurrent<Unity> {
  Current<This>:: HomeworldSupport<This>
}

CLASS HomeworldSupport : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { 2 MC / EarthTag MAX 5, 2 MC / Influence }
}

CLASS SecondEnergyCrisis : GePartyDistant<Scientists>, GePartyCurrent<Kelvinists> {
  Current<This>:: ImprovedEnergyTemplates<This>
}

CLASS ImprovedEnergyTemplates : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { \
    PROD[Energy / 2 (PowerTag OR Influence)] \
  }
}

CLASS CharismaticWgPresident : GePartyDistant<Unity>, GePartyCurrent<Unity> {
  Current<This>:: InterplanetaryTradeGlobalEffect<This>
}

CLASS InterplanetaryTradeGlobalEffect : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { 2 MC / SpaceTag MAX 5, 2 MC / Influence }
}

CLASS RisingAlloyDemand : GePartyDistant<MarsFirst>, GePartyCurrent<Greens> {
  Current<This>:: MinersOnStrike<This>
}

CLASS MinersOnStrike : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { \
    -Titanium. / (JovianTag MAX 5 - Influence) \
  }
}

CLASS ThawMining : GePartyDistant<Kelvinists>, GePartyCurrent<Greens> {
  Current<This>:: MudSlides<This>
}

CLASS MudSlides : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { \
    -4 MC. / (OwnedTile<MarsArea(HAS Neighbor<OceanTile>)> MAX 5 - Influence) \
  }
}

CLASS ViralModificationsApproved : GePartyDistant<Greens>, GePartyCurrent<MarsFirst> {
  Current<This>:: Pandemic<This>
}

CLASS Pandemic : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { \
    -3 MC. / (BuildingTag MAX 5 - Influence) \
  }
}

CLASS ScientificConsensus : GePartyDistant<Kelvinists>, GePartyCurrent<Reds> {
  Current<This>:: ParadigmBreakdown<This>
}

CLASS ParadigmBreakdown : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { -2 ProjectCard., 2 MC / Influence }
}

CLASS ScientificProgress : GePartyDistant<Scientists>, GePartyCurrent<MarsFirst> {
  Current<This>:: Productivity<This>
}

CLASS Productivity : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { Steel / PROD[Steel] MAX 5, Steel / Influence }
}

CLASS AntarcticaMelts : GePartyDistant<Kelvinists>, GePartyCurrent<Reds> {
  Current<This>:: RedInfluence<This>
}

CLASS RedInfluence : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { \
    -3 MC. / (5 (TerraformRating - 10) MAX 5), PROD[1 MC / Influence] \
  }
}

CLASS WorldGovernmentDirectives : GePartyDistant<Unity>, GePartyCurrent<MarsFirst> {
  Current<This>:: Revolution<This>
}

CLASS Revolution : GlobalEffect {
  ResolveGlobalEvent IF MultiplayerMode: \
    EACH Me@Player(HAS 1 (EarthTag OR Influence), HAS =1 (RANK Ranked@Player { \
      EarthTag<Ranked@> OR Influence<Ranked@> \
    })) { \
      -2 TerraformRating. \
    }
  ResolveGlobalEvent IF MultiplayerMode: \
    EACH Me@Player(HAS 1 (EarthTag OR Influence), HAS =2 (RANK Ranked@Player { \
      EarthTag<Ranked@> OR Influence<Ranked@> \
    })) { \
      -TerraformRating. \
    }
  ResolveGlobalEvent IF SoloMode: \
    EACH Me@Player(HAS 4 (EarthTag OR Influence)) { -2 TerraformRating. }
}

CLASS IndependenceMovement : GePartyDistant<MarsFirst>, GePartyCurrent<Reds> {
  Current<This>:: Riots<This>
}

CLASS Riots : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { -4 MC. / (CityTile MAX 5 - Influence) }
}

CLASS CorporateAlliance : GePartyDistant<Unity>, GePartyCurrent<Reds> {
  Current<This>:: SabotageGlobalEffect<This>
}

CLASS SabotageGlobalEffect : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { \
    PROD[-Steel., -Energy.], Steel / Influence \
  }
}

CLASS ExploreFirstDirective : GePartyDistant<Reds>, GePartyCurrent<Scientists> {
  Current<This>:: ScientificCommunity<This>
}

CLASS ScientificCommunity : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { 1 MC / ProjectCard, 1 MC / Influence }
}

CLASS MoholeLakeGlobalEvent : GePartyDistant<Kelvinists>, GePartyCurrent<Kelvinists> {
  Current<This>:: SnowCover<This>
}

CLASS SnowCover : GlobalEffect {
  ResolveGlobalEvent IF GpIncomplete<Class<TemperatureStep>>: -2 TemperatureStep
  ResolveGlobalEvent: EACH Me@Player { ProjectCard / Influence }
}

CLASS IncreasedInterplanetaryTrade : GePartyDistant<Unity>, GePartyCurrent<Kelvinists> {
  Current<This>:: SolarFlare<This>
}

CLASS SolarFlare : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { -3 MC. / (SpaceTag MAX 5 - Influence) }
}

CLASS AiResearch : GePartyDistant<Scientists>, GePartyCurrent<MarsFirst> {
  Current<This>:: SolarnetShutdown<This>
}

CLASS SolarnetShutdown : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { -3 MC. / (ActiveCard MAX 5 - Influence) }
}

CLASS BioengineeringBoom : GePartyDistant<Greens>, GePartyCurrent<Scientists> {
  Current<This>:: SpinOffProducts<This>
}

CLASS SpinOffProducts : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { 2 MC / ScienceTag MAX 5, 2 MC / Influence }
}

CLASS ScienceSummit : GePartyDistant<Scientists>, GePartyCurrent<Greens> {
  Current<This>:: SponsoredProjects<This>
}

CLASS SponsoredProjects : GlobalEffect {
  ResolveGlobalEvent: \
    EACH Card@ResourceCard<Anyone>(HAS CardResource) { CardResource<Card@> }
  ResolveGlobalEvent: EACH Me@Player { ProjectCard / Influence }
}

CLASS MoralMovement : GePartyDistant<Reds>, GePartyCurrent<MarsFirst> {
  Current<This>:: StrongSociety<This>
}

CLASS StrongSociety : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { 2 MC / CityTile MAX 5, 2 MC / Influence }
}

CLASS LocalTerraformingSupport : GePartyDistant<MarsFirst>, GePartyCurrent<Scientists> {
  Current<This>:: SuccessfulOrganisms<This>
}

CLASS SuccessfulOrganisms : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { Plant / PROD[Plant] MAX 5, Plant / Influence }
}

CLASS PateraBoring : GePartyDistant<Scientists>, GePartyCurrent<Kelvinists> {
  Current<This>:: VolcanicEruptions<This>
}

CLASS VolcanicEruptions : GlobalEffect {
  ResolveGlobalEvent: 2 TemperatureStep
  ResolveGlobalEvent: EACH Me@Player { PROD[Heat / Influence] }
}

CLASS SeparatistMovement : GePartyDistant<MarsFirst>, GePartyCurrent<Kelvinists> {
  Current<This>:: WarOnEarth<This>
}

CLASS WarOnEarth : GlobalEffect {
  ResolveGlobalEvent: EACH Me@Player { -TerraformRating. / (4 - Influence) }
}
