CLASS Revolution : GlobalEvent {
  PlaceDistantDelegate<Class<This>>:: PartyDelegate<Unity, Neutral> FROM ReserveDelegate<Neutral>.
  Current<Class<This>>:: PartyDelegate<MarsFirst, Neutral> FROM ReserveDelegate<Neutral>.
  ResolveGlobalEvent<Class<This>> IF MultiplayerMode:: \
    EACH Player(HAS 1 (EarthTag OR Influence), =1 (RANK Player { EarthTag<Player> OR Influence<Player> })) { \
      -2 TerraformRating. \
    }
  ResolveGlobalEvent<Class<This>> IF MultiplayerMode:: \
    EACH Player(HAS 1 (EarthTag OR Influence), =2 (RANK Player { EarthTag<Player> OR Influence<Player> })) { \
      -TerraformRating. \
    }
  ResolveGlobalEvent<Class<This>> IF SoloMode:: \
    EACH Player(HAS 4 (EarthTag OR Influence)) { -2 TerraformRating. }
}

