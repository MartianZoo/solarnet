"Expansion adding the Terraforming Committee and Global Events"
CLASS TurmoilExpansion : Module {
  UseTurmoilPolicyAction<Action1>:: UseAction<ScientistsPolicy, Action1>
  UseTurmoilPolicyAction<Action2>:: UseAction<KelvinistsPolicy, Action1>
  LobbyAction<Action1>: -LobbyActionAvailable! THEN PartyDelegate
  LobbyAction<Action2>: 5 Owed<> THEN Billing<Class<LobbyAction>, Action2>
  This: Neutral, ReferenceFilter<Class<PartyRequirement>>
  HAS Class<LobbyAction>, Class<UseTurmoilPolicyAction>
  -Billing<Class<LobbyAction>>: MAX 6 (Delegate OR LobbyActionAvailable): PartyDelegate

  // Party derives each successor edge from this committee-order creation sequence.
  This: MarsFirst THEN Kelvinists THEN Reds THEN Greens THEN Unity THEN Scientists

  SetupPhase:: EACH Me@Player { TurmoilPlayer, LobbyActionAvailable }
  SetupPhase:: Chairman<Neutral>, Ruling<Greens>
  SetupPhase: RevealComingEvent
  TurmoilSolarPhase: TurmoilSolarOperation
}

CLASS Terraformer26 : Milestone { requirement = HAS "26 TerraformRating" }

"Runs TR revision and the current event, then changes government and advances the event queue"
CLASS TurmoilSolarOperation : Temporary, System, Hidden {
  HAS MAX 1 This
  This:: EACH Me@Player { -TerraformRating., MeasureInfluence }
  This: ResolveGlobalEvent
  -This: FormGovernment THEN ChangingTimes
}

"A revealed Global Event card, discarded by ChangingTimes after its Current generation"
ABSTRACT CLASS GlobalEvent {
  HAS MAX 1 This
  HAS MAX 1 GlobalEventPosition<This>
  This IF RevealComingEvent:: Coming<This>
  This IF RevealDistantEvent:: Distant<This>
}

"The party receiving the neutral delegate printed in a Global Event's distant position"
ABSTRACT CLASS GePartyDistant<DistantParty@Party> : GlobalEvent {
  This: PartyDelegate<DistantParty@, Neutral>.
}

"The party receiving the neutral delegate when a Global Event becomes current"
ABSTRACT CLASS GePartyCurrent<CurrentParty@Party> : GlobalEvent {
  Current<This>: PartyDelegate<CurrentParty@, Neutral>.
}

"One printed board position, occupied by at most one Global Event card"
ABSTRACT CLASS GlobalEventPosition<GlobalEvent> {
  CLASS Current { HAS MAX 1 Current }
  CLASS Coming { HAS MAX 1 Coming }
  CLASS Distant { HAS MAX 1 Distant }
}

"Requests the first revealed event and then the second setup event"
CLASS RevealComingEvent : Barrier, System, Hidden {
  HAS MAX 1 This
  This: GlobalEvent THEN RevealDistantEvent FROM This
}

"Requests the next event for the Distant position"
CLASS RevealDistantEvent : Barrier, System, Hidden {
  HAS MAX 1 This
  This: GlobalEvent THEN -This!
}

"The lower half of the current Global Event, removed with its card"
ABSTRACT CLASS GlobalEffect<GlobalEvent> {
  HAS MAX 1 GlobalEffect
}

"Resolves the active Global Effect"
CLASS ResolveGlobalEvent : Signal, System

"Moves every revealed Global Event one position and requests the next event"
CLASS ChangingTimes : Signal, System {
  This:: \
    EACH Event@GlobalEvent(HAS Current) { -Event@ }, \
    EACH Event@GlobalEvent(HAS Coming) { \
      Current<Event@> FROM Coming<Event@> \
    }, \
    EACH Event@GlobalEvent(HAS Distant) { \
      Coming<Event@> FROM Distant<Event@> \
    }, \
    RevealDistantEvent
}

"A player's reserve of seven delegates, held for as long as Turmoil is in play"
CLASS TurmoilPlayer : Owned<Player>, System, Hidden {
  HAS MAX 1 This
  // This is the TurmoilPlayer component, whose effect inherits its lexical Me.
  Delegate IF 8 Delegate:: Die
}

"The owner of gray delegates, who holds a reserve of fourteen"
CLASS Neutral : Owner {
  HAS =1 This
  HAS MAX 14 Delegate<This>
}

ABSTRACT CLASS Party {
  HAS =1 This
  HAS MAX 1 AfterParty<This, Party>, MAX 1 AfterParty<Party, This>
  HAS MAX 1 PartyLeader<This, Anyone>
  This:: EACH Previous@Party( \
    NOT This, HAS MAX 0 AfterParty \
  ) { AfterParty<Previous@, This> }
  FormGovernment IF Dominant<This>:: \
    -Ruling! THEN Ruling<This>, \
    ApplyRulingBonus<This>, \
    EACH FormerChairman@Owner(HAS Chairman) { \
      -Chairman<FormerChairman@> \
    }, \
    EACH DelegateHolder@Owner(HAS PartyDelegate<This>) { \
      -PartyDelegate<This, DelegateHolder@> / ( \
        PartyDelegate<This, DelegateHolder@> - \
        PartyLeader<This, DelegateHolder@> \
      ) \
    }, \
    EACH Leader@Player(HAS PartyLeader<This>) { \
      Chairman<Leader@> FROM PartyDelegate<This, Leader@> THEN \
      TerraformRating<Leader@> \
    }, \
    EACH Leader@Neutral(HAS PartyLeader<This>) { \
      Chairman<Leader@> FROM PartyDelegate<This, Leader@> \
    }, \
    EACH Next@Party(HAS MAX 0 Dominant, HAS =1 (RANK Ranked@Party { \
      PartyDelegate<Ranked@, Anyone>, PartyDistance<Ranked@, This> \
    })) { Dominant<Next@> }, \
    RefillLobby
}
CLASS MarsFirst : Party {
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / BuildingTag }
  ActionPhase OR Ruling<This> IF ActionPhase, Ruling<This>:: MarsFirstPolicy.
}
CLASS MarsFirstPolicy : Policy<Ruling<MarsFirst>> {
  Tile<MarsArea>: Steel
}

CLASS Scientists : Party {
  This:: AfterParty<This, MarsFirst>
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / ScienceTag }
  ActionPhase OR Ruling<This> IF ActionPhase, Ruling<This>:: ScientistsPolicy.
}
CLASS ScientistsPolicy : Policy<Ruling<Scientists>>, HasActions {
  10 MC -> 3 ProjectCard THEN ScientistsUsedMarker
}
CLASS ScientistsUsedMarker<GenerationScope> : Owned<Player>, System {
  HAS MAX 1 This
}

CLASS Unity : Party {
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / PlanetaryTag }
  ActionPhase OR Ruling<This> IF ActionPhase, Ruling<This>:: UnityPolicy.
}
CLASS UnityPolicy : Policy<Ruling<Unity>> {
  This:: EACH Me@Player { UnityTitaniumValue }
}
CLASS UnityTitaniumValue<UnityPolicy> : ResourceValue<Class<Titanium>> {
  HAS MAX 1 This
}

CLASS Greens : Party {
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / BioTag }
  ActionPhase OR Ruling<This> IF ActionPhase, Ruling<This>:: GreensPolicy.
}
CLASS GreensPolicy : Policy<Ruling<Greens>> {
  GreeneryTile: 4 MC
}

CLASS Reds : Party {
  // Ranking is highest-first, so rank each player by everyone else's rating to find the lowest.
  ApplyRulingBonus<This> IF MAX 0 SoloMode:: EACH Lowest@Player( \
    HAS =1 (RANK Ranked@Player { TerraformRating<Anyone(NOT Ranked@)> }) \
  ) { \
    TerraformRating<Lowest@> \
  }
  ApplyRulingBonus<This> IF SoloMode:: EACH Me@Player(HAS MAX 20 TerraformRating) { \
    TerraformRating \
  }
  ActionPhase OR Ruling<This> IF ActionPhase, Ruling<This>:: RedsPolicy.
}
CLASS RedsPolicy : Policy<Ruling<Reds>> {
  TerraformRating: -3 MC!
}

CLASS Kelvinists : Party {
  ApplyRulingBonus<This>:: EACH Me@Player { 1 MC / PROD[Heat] }
  ActionPhase OR Ruling<This> IF ActionPhase, Ruling<This>:: KelvinistsPolicy.
}
CLASS KelvinistsPolicy : Policy<Ruling<Kelvinists>>, HasActions {
  10 MC -> PROD[Heat, Energy]
}

"Requests the one-time bonus for the party forming the new government"
CLASS ApplyRulingBonus<Party> : Signal, System

"Performs the complete new-government sequence for the current Dominant party"
CLASS FormGovernment : Signal, System

"Identifies the Party immediately after another Party around the committee"
CLASS AfterParty<Party, Party> : System, Hidden { HAS MAX 1 This }

"The forward distance from one Party to another around the committee"
CLASS PartyDistance<Party, Party> : CustomMetric

"The clockwise seat distance between owners, with unseated owners last"
CLASS PlayerDistance<Owner, Owner> : CustomMetric

"Whether one player meets the ruling-party or two-delegate requirement for a party"
CLASS PartyRequirement<Party> : Owned<Player>, CustomMetric

ABSTRACT CLASS PartyStatus<Party> {
  "The party with the greatest delegate count"
  CLASS Dominant {
    HAS MAX 1 Dominant
    This:: -Dominant(NOT This).
  }

  "The party whose policy and bonus govern the current generation"
  CLASS Ruling {
    HAS MAX 1 Ruling
  }
}

"One of an owner's delegates, while it is placed on the committee"
ABSTRACT CLASS Delegate : Owned {
  "The delegate holding the committee chair"
  CLASS Chairman {
    HAS MAX 1 Chairman
    MeasureInfluence:: ChairmanInfluence
    End: VictoryPoint
  }

  "A delegate currently assigned to one political party"
  CLASS PartyDelegate<Delegation@Party> {
    // Preserve the incumbent on a count tie. For a player gain, choose the nearest tied
    // challenger clockwise from that player; Neutral and other unseated owners rank last.
    X This:: EACH Leader@Owner( \
      HAS MAX 0 PartyLeader<Delegation@>, \
      HAS =1 (RANK Ranked@Owner { \
        PartyDelegate<Delegation@, Ranked@>, \
        PartyLeader<Delegation@, Ranked@>, \
        Player - PlayerDistance<Me@, Ranked@> \
      }) \
    ) { \
      PartyLeader<Delegation@, Leader@> \
    }
    X This OR -X This:: RecalculateDominance<Delegation@>
    MeasureInfluence IF Dominant<Delegation@>, \
      1 (PartyDelegate<Delegation@> - PartyLeader<Delegation@>):: \
      DelegateInfluence.
  }
}


"The owner whose delegate occupies one party's leader seat"
CLASS PartyLeader<Delegation@Party> : Owned {
  This:: -PartyLeader<Delegation@, Anyone>(NOT This).
  -PartyDelegate<Delegation@> \
    IF MAX 0 PartyDelegate<Delegation@>:: \
    -This! THEN \
      EACH Leader@Owner( \
        HAS PartyDelegate<Delegation@>, \
        HAS MAX 0 PartyLeader<Delegation@>, \
        HAS =1 (RANK Ranked@Owner { \
          PartyDelegate<Delegation@, Ranked@>, \
          PartyLeader<Delegation@, Ranked@> \
        }) \
      ) { PartyLeader<Delegation@, Leader@> }
  MeasureInfluence IF Dominant<Delegation@>:: PartyLeaderInfluence
  End: VictoryPoint
}

"The unspent Lobby delegate, used by other placements only after the Delegate Reserve is empty"
CLASS LobbyActionAvailable : Owned<Player>, System, Hidden {
  HAS MAX 1 This
  Delegate IF 7 Delegate:: -This.
}

"Gives dominance to the largest delegation, then incumbency and committee order"
CLASS RecalculateDominance<Source@Party> : Signal {
  This:: EACH Next@Party(HAS MAX 0 Dominant, HAS =1 (RANK Ranked@Party { \
    PartyDelegate<Ranked@, Anyone>, Dominant<Ranked@>, \
    Party - PartyDistance<Source@, Ranked@> \
  })) { \
    Dominant<Next@> \
  }
}

"The repeatable lobbying action, free from the Lobby or costing 5 M€"
CLASS LobbyAction<ActionSlot> : StandardAction {
  DEFAULT LobbyAction<Action1>
}

"Restores free lobbying for each player who has an available delegate"
CLASS RefillLobby : Signal, System {
  This:: EACH Me@Player(HAS MAX 6 Delegate) { LobbyActionAvailable. }
}

"Requests the current political influence snapshot for one player"
CLASS MeasureInfluence : Owned<Player>, Signal, System {
  // Clear this player's previous snapshot before the other components supply current influence.
  This:: EACH Measured@Influence { -Measured@! }
}

"One generation's political influence; each source below supplies at most one"
ABSTRACT CLASS Influence<GenerationScope> : Owned<Player> {
  HAS MAX 1 This

  // Chairman; leading the Dominant party; any delegates in it; Event Analysts
  CLASS ChairmanInfluence
  CLASS PartyLeaderInfluence
  CLASS DelegateInfluence
  CLASS EventAnalystsInfluence
}

"A ruling party's capability during the Action phase"
ABSTRACT CLASS Policy<Ruling<Party>, ActionPhase> {
  HAS MAX 1 Policy
}

CLASS UseTurmoilPolicyAction<ActionSlot> : StandardAction {
  DEFAULT UseTurmoilPolicyAction<Action1>
}
