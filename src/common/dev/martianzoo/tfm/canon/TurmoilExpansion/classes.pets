"Expansion adding the Terraforming Committee and Global Events"
CLASS TurmoilExpansion : Module {
  HAS Class<RefillLobby>, Class<MeasureInfluence>, Class<ApplyRulingBonus>, Class<FormGovernment>, Class<ChangingTimes>
  HAS Class<TurmoilSolarOperation>
  HAS Class<ResolveCurrentGlobalEvent>, Class<ResolveGlobalEvent>
  HAS Class<RemoveOceanForGlobalEvent>, Class<ChooseDryDesertResource>
  HAS Class<RaiseTemperatureForGlobalEvent>, Class<RaiseTemperatureAgainForGlobalEvent>
  HAS Class<ResolveDryDeserts>, Class<ResolveDiversity>
  HAS Class<ResolveSponsoredProjects>, Class<ResolveCloudSocieties>
  HAS Class<AddResourceToCard>
  HAS Class<ChooseInfluenceFloaterCard>, Class<ResolveCorrosiveRain>
  This:: Neutral, MarsFirst, Scientists, Unity, Greens, Reds, Kelvinists, SendDelegateSA, UseTurmoilPolicySA
  SetupPhase:: EACH Player { TurmoilPlayer, LobbyDelegate, 6 ReserveDelegate }
  SetupPhase:: Chairman<Neutral>, 13 ReserveDelegate<Neutral>, Ruling<Greens>
  SetupPhase: RevealComingEvent
  SolarPhase: TurmoilSolarOperation
}

"Runs TR revision and the current event, then changes government and advances the event queue"
CLASS TurmoilSolarOperation : Temporary, System {
  HAS MAX 1 This
  This:: EACH Player { -TerraformRating. }
  This:: ResolveCurrentGlobalEvent
  -This: FormGovernment THEN ChangingTimes
}

"A revealed Global Event card"
ABSTRACT CLASS GlobalEvent {
  HAS MAX 1 This
  This IF RevealComingEvent:: Coming<Class<This>>, PlaceDistantDelegate<Class<This>>
  This IF RevealDistantEvent:: Distant<Class<This>>
  Distant<Class<This>>:: PlaceDistantDelegate<Class<This>>
  -Current<Class<This>>:: -This!
}

"One Global Event card occupying its printed board position"
ABSTRACT CLASS GlobalEventPosition<Class<GlobalEvent>>

CLASS Current<Class<GlobalEvent>> : GlobalEventPosition<Class<GlobalEvent>> {
  HAS MAX 1 Current
}

CLASS Coming<Class<GlobalEvent>> : GlobalEventPosition<Class<GlobalEvent>> {
  HAS MAX 1 Coming
}

CLASS Distant<Class<GlobalEvent>> : GlobalEventPosition<Class<GlobalEvent>> {
  HAS MAX 1 Distant
}

"Requests the top-left neutral delegate printed on one revealed event"
CLASS PlaceDistantDelegate<Class<GlobalEvent>> : Signal

"Requests the first revealed event and then the second setup event"
CLASS RevealComingEvent : Barrier {
  HAS MAX 1 This
  This: GlobalEvent THEN RevealDistantEvent FROM This
}

"Requests the next event for the Distant position"
CLASS RevealDistantEvent : Barrier {
  HAS MAX 1 This
  This: GlobalEvent THEN -This!
}

"Measures every player's influence and resolves the exact Current Global Event"
CLASS ResolveCurrentGlobalEvent : Signal {
  This:: \
    EACH Player { MeasureInfluence<Player> }, \
    EACH Class<GlobalEvent>(HAS Current<Class<GlobalEvent>>) { ResolveGlobalEvent<Class<GlobalEvent>> }
}

"Requests the printed effect of one Global Event"
CLASS ResolveGlobalEvent<Class<GlobalEvent>> : Signal

"Lets the first player return one placed Ocean without reducing rating"
CLASS RemoveOceanForGlobalEvent : Owned<Player>, Barrier {
  HAS MAX 1 This
  This: -OceanTile. THEN -This!
}

"Lets a player choose one standard resource granted by Dry Deserts"
CLASS ChooseDryDesertResource<Influence<Player>> : Owned<Owner>, Barrier {
  This: StandardResource THEN -This!
}

"Creates one independent Dry Deserts choice for each of a player's influence"
CLASS ResolveDryDeserts : Owned<Player>, Signal {
  This:: EACH Influence<Owner> { ChooseDryDesertResource<Influence> }
}

"Raises temperature twice for Admin, stopping if the first step completes the track"
CLASS RaiseTemperatureForGlobalEvent : Owned<Player>, Signal {
  This IF GpIncomplete<Class<TemperatureStep>>:: \
    TemperatureStep BY Admin THEN RaiseTemperatureAgainForGlobalEvent<Owner>
}

CLASS RaiseTemperatureAgainForGlobalEvent : Owned<Player>, Signal {
  This IF GpIncomplete<Class<TemperatureStep>>:: TemperatureStep BY Admin
}

"Pays one player for meeting Diversity's tag-type and influence threshold"
CLASS ResolveDiversity : Owned<Player>, Signal {
  This IF MAX 0 Influence, 9 Class<Tag>(HAS Tag<Owner>):: 10 MC
  This IF =1 Influence, 8 Class<Tag>(HAS Tag<Owner>):: 10 MC
  This IF =2 Influence, 7 Class<Tag>(HAS Tag<Owner>):: 10 MC
  This IF =3 Influence, 6 Class<Tag>(HAS Tag<Owner>):: 10 MC
}

"Resolves Sponsored Projects for one player and that player's compatible cards"
CLASS ResolveSponsoredProjects : Owned<Player>, Signal {
  This:: EACH ResourceCard<Owner> { \
    AddResourceToCard<ResourceCard> \
  }
  This:: ProjectCard / Influence
}

"Adds the resource type accepted by one compatible resource card"
CLASS AddResourceToCard<ResourceCard<Class<CardResource>, Player>> : Owned<Player>, Signal {
  This:: CardResource<ResourceCard>
}

"Adds Cloud Societies floaters to every compatible card, then requests one card for influence"
CLASS ResolveCloudSocieties : Owned<Player>, Signal {
  This IF ResourceCard<Class<Floater>>:: \
    EACH ResourceCard<Class<Floater>, Owner> { \
      AddResourceToCard<ResourceCard<Class<Floater>, Owner>> \
    }, \
    ChooseInfluenceFloaterCard<Owner>
}

"Lets one player put all Cloud Societies influence floaters on a single compatible card"
CLASS ChooseInfluenceFloaterCard : Owned<Player>, Barrier {
  HAS MAX 1 This
  This: Floater<ResourceCard<Class<Floater>, Owner>> / Influence THEN -This!
}

"Lets a player resolve Corrosive Rain before drawing cards for influence"
CLASS ResolveCorrosiveRain : Owned<Player>, Barrier {
  HAS MAX 1 This
  This: (-2 Floater! OR -10 MC.) THEN (ProjectCard / Influence, -This!)
}

"Moves every revealed Global Event one position and requests the next event"
CLASS ChangingTimes : Signal {
  This:: \
    EACH Class<GlobalEvent>(HAS Current<Class<GlobalEvent>>) { -Current<Class<GlobalEvent>>! }, \
    EACH Class<GlobalEvent>(HAS Coming<Class<GlobalEvent>>) { \
      Current<Class<GlobalEvent>> FROM Coming<Class<GlobalEvent>> \
    }, \
    EACH Class<GlobalEvent>(HAS Distant<Class<GlobalEvent>>) { \
      Coming<Class<GlobalEvent>> FROM Distant<Class<GlobalEvent>> \
    }, \
    RevealDistantEvent
}

"A player participating in the Turmoil political rules"
CLASS TurmoilPlayer : Owned<Player>, System {
  HAS MAX 1 This
}

"The owner of gray delegates"
CLASS Neutral : Owner {
  HAS MAX 1 This
}

ABSTRACT CLASS Party {
  HAS MAX 1 This
  FormGovernment IF Dominant<This>:: \
    (MAX 0 Ruling<This>: Ruling<This> FROM Ruling) OR (Ruling<This>: Ok), \
    ApplyRulingBonus<This>, \
    EACH Anyone(HAS Chairman<Anyone>) { ReserveDelegate<Anyone> FROM Chairman<Anyone> }, \
    EACH Anyone(HAS PartyDelegate<This, Anyone>) { \
      (ReserveDelegate<Anyone> FROM PartyDelegate<This, Anyone>) / (PartyDelegate<This, Anyone> - PartyLeader<This, Anyone>) \
    }, \
    EACH Anyone(HAS PartyLeader<This, Anyone>) { Chairman<Anyone> FROM PartyDelegate<This, Anyone> }, \
    EACH Player(HAS PartyLeader<This, Player>) { TerraformRating<Player> }, \
    EACH Anyone(HAS PartyLeader<This, Anyone>) { -PartyLeader<This, Anyone>! }, \
    SelectDominanceAfter<This>, \
    RefillLobby
}
CLASS MarsFirst : Party {
  SelectDominanceAfter<This>:: \
    5 DominancePriority<Kelvinists>, 4 DominancePriority<Reds>, 3 DominancePriority<Greens>, \
    2 DominancePriority<Unity>, DominancePriority<Scientists>, RecalculateDominanceClockwise
  ApplyRulingBonus<This>:: EACH Player { 1 MC / BuildingTag }
  ActionPhase IF Ruling<This>:: MarsFirstPolicy
}
CLASS Scientists : Party {
  SelectDominanceAfter<This>:: \
    5 DominancePriority<MarsFirst>, 4 DominancePriority<Kelvinists>, 3 DominancePriority<Reds>, \
    2 DominancePriority<Greens>, DominancePriority<Unity>, RecalculateDominanceClockwise
  ApplyRulingBonus<This>:: EACH Player { 1 MC / ScienceTag }
  ActionPhase IF Ruling<This>:: ScientistsPolicy
}
CLASS Unity : Party {
  SelectDominanceAfter<This>:: \
    5 DominancePriority<Scientists>, 4 DominancePriority<MarsFirst>, 3 DominancePriority<Kelvinists>, \
    2 DominancePriority<Reds>, DominancePriority<Greens>, RecalculateDominanceClockwise
  ApplyRulingBonus<This>:: EACH Player { 1 MC / PlanetaryTag }
  ActionPhase IF Ruling<This>:: UnityPolicy
}
CLASS Greens : Party {
  SelectDominanceAfter<This>:: \
    5 DominancePriority<Unity>, 4 DominancePriority<Scientists>, 3 DominancePriority<MarsFirst>, \
    2 DominancePriority<Kelvinists>, DominancePriority<Reds>, RecalculateDominanceClockwise
  ApplyRulingBonus<This>:: EACH Player { 1 MC / BioTag }
  ActionPhase IF Ruling<This>:: GreensPolicy
}
CLASS Reds : Party {
  SelectDominanceAfter<This>:: \
    5 DominancePriority<Greens>, 4 DominancePriority<Unity>, 3 DominancePriority<Scientists>, \
    2 DominancePriority<MarsFirst>, DominancePriority<Kelvinists>, RecalculateDominanceClockwise
  ApplyRulingBonus<This> IF MAX 0 SoloMode:: EACH Player(HAS =1 (RANK Player { TerraformRating<Owner(NOT Player)> })) { \
    TerraformRating<Player> \
  }
  ApplyRulingBonus<This> IF SoloMode:: EACH Player(HAS MAX 20 TerraformRating<Player>) { TerraformRating<Player> }
  ActionPhase IF Ruling<This>:: RedsPolicy
}
CLASS Kelvinists : Party {
  SelectDominanceAfter<This>:: \
    5 DominancePriority<Reds>, 4 DominancePriority<Greens>, 3 DominancePriority<Unity>, \
    2 DominancePriority<Scientists>, DominancePriority<MarsFirst>, RecalculateDominanceClockwise
  ApplyRulingBonus<This>:: EACH Player { 1 MC / PROD[Heat] }
  ActionPhase IF Ruling<This>:: KelvinistsPolicy
}

"Requests the one-time bonus for the party forming the new government"
CLASS ApplyRulingBonus<Party> : Signal

"Performs the complete new-government sequence for the current Dominant party"
CLASS FormGovernment : Signal

"Requests the post-government dominance choice clockwise from one party"
CLASS SelectDominanceAfter<Party> : Signal

"A temporary rank weight representing clockwise party order"
CLASS DominancePriority<Party> : Temporary, Hidden

ABSTRACT CLASS PartyStatus<Party> {
  "The party with the greatest delegate count"
  CLASS Dominant {
    HAS MAX 1 Dominant
  }

  "The party whose policy and bonus govern the current generation"
  CLASS Ruling {
    HAS MAX 1 Ruling
  }
}

ABSTRACT CLASS AbstractDelegate : Owned<Owner> {
  "The delegate holding the committee chair"
  CLASS Chairman {
    HAS MAX 1 Chairman
    MeasureInfluence:: ChairmanInfluence
    End: VictoryPoint
  }

  "A player's free delegate for the current generation"
  CLASS LobbyDelegate {
    HAS MAX 1 This
  }

  "A delegate available to enter the Lobby or a political party"
  CLASS ReserveDelegate
}

"A delegate currently assigned to one political party"
CLASS PartyDelegate<Party> : Owned<Owner> {
  This:: EACH Anyone(HAS MAX 0 PartyLeader<Party, Anyone>, =1 (RANK Anyone { PartyDelegate<Party, Anyone>, PartyLeader<Party, Anyone> })) { \
    PartyLeader<Party, Anyone> \
  }
  This:: RecalculateDominance
  MeasureInfluence IF Dominant<Party>, 1 (PartyDelegate<Party, Owner> - PartyLeader<Party, Owner>):: DelegateInfluence.
}

"The owner whose delegate occupies one party's leader seat"
CLASS PartyLeader<Party> : Owned<Owner> {
  This:: EACH Anyone(HAS PartyLeader<Party, Anyone>, 2 (RANK Anyone { PartyDelegate<Party, Anyone>, PartyLeader<Party, Anyone> })) { \
    -PartyLeader<Party, Anyone> \
  }
  MeasureInfluence IF Dominant<Party>:: PartyLeaderInfluence
  End: VictoryPoint
}

CLASS RecalculateDominance : Signal {
  This:: EACH Party(HAS MAX 0 Dominant<Party>, =1 (RANK Party { PartyDelegate<Party, Anyone>, Dominant<Party> })) { \
    (Dominant: Dominant<Party> FROM Dominant) OR \
    (MAX 0 Dominant: Dominant<Party>) \
  }
}

"Recalculates dominance with the active clockwise priorities breaking ties"
CLASS RecalculateDominanceClockwise : Signal {
  This:: -Dominant!
  This:: EACH Party(HAS =1 (RANK Party { PartyDelegate<Party, Anyone>, DominancePriority<Party> })) { \
    Dominant<Party> \
  }
}

"The repeatable lobbying action, free from the Lobby or costing 5 M€ from the reserve"
CLASS SendDelegateSA : StandardAction {
  -> PartyDelegate FROM LobbyDelegate
  5 MC -> PartyDelegate FROM ReserveDelegate
}

"Refills each vacant Lobby seat from that player's finite reserve"
CLASS RefillLobby : Signal {
  This:: EACH Player { LobbyDelegate<Player> FROM ReserveDelegate<Player>. }
}

"Requests the current political influence snapshot for one player"
CLASS MeasureInfluence : Owned<Player>, Signal

ABSTRACT CLASS Influence : Owned<Player>, Generational

"One influence supplied by the committee Chairman"
CLASS ChairmanInfluence : Influence {
  HAS MAX 1 This
}

"One influence supplied by leading the Dominant party"
CLASS PartyLeaderInfluence : Influence {
  HAS MAX 1 This
}

"One influence supplied by having one or more delegates in the Dominant party"
CLASS DelegateInfluence : Influence {
  HAS MAX 1 This
}

"The extra influence supplied by Event Analysts"
CLASS EventAnalystsInfluence : Influence {
  HAS MAX 1 This
}

"Returns one selected non-leader delegate to its owner's reserve"
CLASS BannedDelegateRemoval<Party, Anyone> : Owned<Player>, Barrier {
  HAS MAX 1 This
  This: ReserveDelegate<Anyone> FROM PartyDelegate<Party, Anyone> THEN -This!
}

"Exchanges one neutral non-leader delegate for one of the player's reserve delegates"
CLASS RecruitmentExchange<Party> : Owned<Player>, Barrier {
  HAS MAX 1 This
  This: ReserveDelegate<Neutral> FROM PartyDelegate<Party, Neutral> THEN \
    PartyDelegate<Party, Owner> FROM ReserveDelegate<Owner> THEN -This!
}

"A ruling party's capability during the Action phase"
ABSTRACT CLASS Policy<Party> {
  HAS MAX 1 Policy
  -ActionPhase:: -This!
}

CLASS UseTurmoilPolicySA : StandardAction {
  -> UseAction<ScientistsPolicy, Action1>
  -> UseAction<KelvinistsPolicy, Action1>
}

"Mars First ruling policy: tiles placed on Mars grant one steel"
CLASS MarsFirstPolicy : Policy<MarsFirst> {
  Tile<MarsArea> BY Player:: Steel<Player>
}

"Scientists ruling policy: pay 10 M€ to draw three cards, once per generation"
CLASS ScientistsPolicy : Policy<Scientists>, HasActions {
  10 MC -> (MAX 0 ScientistsUsedMarker: 3 ProjectCard, ScientistsUsedMarker)
}

CLASS ScientistsUsedMarker : Owned<Player>, Generational {
  HAS MAX 1 This
}

"Unity ruling policy: each titanium is worth one additional M€"
CLASS UnityPolicy : Policy<Unity> {
  This:: EACH Player { UnityTitaniumValue<Player> }
  -This:: EACH Player { -UnityTitaniumValue<Player>! }
}

CLASS UnityTitaniumValue : ResourceValue<Class<Titanium>> {
  HAS MAX 1 This
}

"Greens ruling policy: greenery placement grants 4 M€"
CLASS GreensPolicy : Policy<Greens> {
  GreeneryTile BY Player:: 4 MC<Player>
}

"Reds ruling policy: each player-attributed TR step costs 3 M€"
CLASS RedsPolicy : Policy<Reds> {
  X TerraformRating BY Player:: -3X MC<Player>!
}

"Kelvinists ruling policy: pay 10 M€ for one heat and one energy production"
CLASS KelvinistsPolicy : Policy<Kelvinists>, HasActions {
  10 MC -> PROD[Heat, Energy]
}
