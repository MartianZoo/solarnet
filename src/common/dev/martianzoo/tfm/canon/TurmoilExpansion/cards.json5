          "immediate": "53 MC, -2 TerraformRating",
          "effects": [
            "ProductionPhase IF MAX 0 HasRaisedTr: Preservation<This>, 6 MC",
            "End: VictoryPoint / Preservation<This>"
          ],
          "invariants": [ "Class<TrWatcher>" ],
          "components": [
            "CLASS Preservation : CardResource",
            // Must be identical to UnitedNationsMarsInitiative's declarations in TerraformingMars.
            "CLASS HasRaisedTr<GenerationScope> : Owned, System, Hidden { HAS MAX 1 This }",
            // PP counts attempts automatically; only its second and later Action-phase gains qualify.
            "CLASS TrWatcher : CardWatcher { TerraformRating IF MAX 0 HasRaisedTr, (MAX 0 ActionPhase OR MAX 0 PreservationProgram OR 2 ActionPhaseTrGain): HasRaisedTr. }"
          ],
        },
