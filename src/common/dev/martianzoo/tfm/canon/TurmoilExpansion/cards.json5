        {
          "name": "BannedDelegate",
          "requirement": "Chairman",
          "cost": 0,
          "tags": [ "EventTag" ],
          "immediate":
            "BannedDelegateRemoval<Party, Anyone>. / (PartyDelegate<Party, Anyone> - PartyLeader<Party, Anyone>) MAX 1",
          "components": [
            // Returns a selected non-leader delegate, then resolves its party leadership.
            // A transfer also removes a delegate; leadership changes only after this selected removal.
            "CLASS BannedDelegateRemoval<@Party, @Owner> : Owned<Player>, Barrier, System, Hidden { HAS MAX 1 This; This IF MAX 0 (PartyDelegate<@Party, @Owner> - PartyLeader<@Party, @Owner>):: Die; This: -PartyDelegate<@Party, @Owner> THEN -This!; -This:: EACH Next@Owner(HAS MAX 0 PartyLeader<@Party>, HAS =1 (RANK Ranked@Owner { PartyDelegate<@Party, Ranked@>, PartyLeader<@Party, Ranked@>, Player - PlayerDistance<Me@, Ranked@> })) { PartyLeader<@Party, Next@> FROM PartyLeader<@Party, Anyone> } }"
          ],
        },
