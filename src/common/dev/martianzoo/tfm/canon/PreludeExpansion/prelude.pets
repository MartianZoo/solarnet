"The published Prelude 1 rules"
CLASS PreludeExpansion : Module {
  phaseAfter = HAS "PreludePhase, CorporationPhase"

  HAS Class<PreludePhase>, Class<PreludePhaseScope>
  X SoloGenerationsLeft:: -2 SoloGenerationsLeft!

  SetupPhase:: EACH Player { 4 PreludeCard }
  NewTurn IF SetupPhase: -2 PreludeCard
}

CLASS PreludePhase : Phase {
  NewTurn: PlayCard<Class<PreludeCard>> OR (-PreludeCard THEN Audit THEN 15 MC)
}

"The Prelude phase's lifetime anchor"
CLASS PreludePhaseScope : PhaseScope<PreludePhase> {
  This IF WorkflowStarted:: \
    EACH @Player(HAS StartToken) { PreludeTurnContinuation<@Player> BY Admin }
  -PreludeCard<Previous@Owner> IF WorkflowStarted:: \
    PreludeTurnContinuation<Previous@Owner>. BY Admin
}

"Continues ordered Prelude turns after the previous choice settles"
CLASS PreludeTurnContinuation<Current@Player> : Continuation, System {
  HAS MAX 1 This
  -This IF WorkflowStarted, PreludePhaseScope, PreludeCard<Current@Player>:: \
    NewTurn<Current@Player> BY Current@Player
  -This IF WorkflowStarted, PreludePhaseScope, MAX 0 PreludeCard<Current@Player>, PreludeCard<Anyone>:: \
    EACH Next@Player(HAS AfterMe<Current@Player, Player>) { \
      PreludeTurnContinuation<Next@Player> BY Admin \
    }
  -This IF WorkflowStarted, PreludePhaseScope, MAX 0 PreludeCard<Anyone>:: \
    -PreludePhaseScope. BY Admin
}
