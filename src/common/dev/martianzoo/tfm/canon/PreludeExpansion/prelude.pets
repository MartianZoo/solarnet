"The published Prelude 1 rules"
CLASS PreludeExpansion : Module {
  HAS Class<PreludePhase>
  X SoloGenerationsLeft:: -2 SoloGenerationsLeft!

  SetupPhase:: EACH Player { 4 DrawCard<Class<PreludeCard>, Hand> }
  NewTurn IF SetupPhase: -PreludeCard THEN -PreludeCard
}

CLASS PreludePhase : Phase {
  NewTurn: PlayCard<Class<PreludeCard>, Hand> OR (-PreludeCard THEN Audit THEN 15 MC)
}
