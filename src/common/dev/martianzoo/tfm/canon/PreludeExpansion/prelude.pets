"The published Prelude 1 rules"
CLASS PreludeExpansion : Module {
  phaseAfter = HAS "PreludePhase, CorporationPhase"

  HAS Class<PreludePhase>
  X SoloGenerationsLeft:: -2 SoloGenerationsLeft!

  SetupPhase:: EACH Me@Player { 4 PreludeCard }
  NewTurn IF SetupPhase: -2 PreludeCard
}

CLASS PreludePhase : Phase {
  NewTurn: PlayOrFizzle
  This IF WorkflowStarted:: \
    EACH @Player(HAS StartToken) { PreludeTurnContinuation<@Player> BY Admin }
  -PreludeCard<Previous@Anyone> IF WorkflowStarted:: \
    PreludeTurnContinuation<Previous@>. BY Admin
}

"Continues ordered Prelude turns after the previous choice settles"
CLASS PreludeTurnContinuation<Current@Player> : Continuation, System {
  HAS MAX 1 This
  -This IF WorkflowStarted, PreludePhase, PreludeCard<Current@>:: \
    NewTurn<Current@> BY Current@
  -This IF WorkflowStarted, PreludePhase, MAX 0 PreludeCard<Current@>, PreludeCard<Anyone>:: \
    EACH Next@Player(HAS AfterMe<Current@, Player>) { \
      PreludeTurnContinuation<Next@> BY Admin \
    }
  -This IF WorkflowStarted, PreludePhase, MAX 0 PreludeCard<Anyone>:: \
    AdvancePhase<PreludePhase>. BY Admin
}
