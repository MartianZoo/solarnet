"The published Prelude 1 rules"
CLASS PreludeExpansion : Module {
  phaseAfter = HAS "PreludePhase, CorporationPhase"

  HAS Class<PreludePhase>, Class<PreludePhaseScope>
  X SoloGenerationsLeft:: -2 SoloGenerationsLeft!

  SetupPhase:: EACH Player { 4 PreludeCard }
  NewTurn IF SetupPhase: -2 PreludeCard
}

CLASS PreludePhase : Phase {
  NewTurn: PlayCard<Class<PreludeCard>, Hand> OR (-PreludeCard THEN 15 MC)
}

"The Prelude phase's lifetime anchor"
CLASS PreludePhaseScope : PhaseScope<PreludePhase>
