"The published Prelude 1 rules"
CLASS PreludeExpansion : Module {
  HAS Class<PreludePhase>
  X SoloGenerationsLeft:: -2 SoloGenerationsLeft!

  BeginnerCard<Starter@Player> IF SetupPhase: \
    4 PreludeCard<Starter@Player> THEN -2 PreludeCard<Starter@Player>
  X CorporationCard<Starter@Player, Selecting> IF SetupPhase: \
    4 PreludeCard<Starter@Player> THEN -2 PreludeCard<Starter@Player>
}

CLASS PreludePhase : Phase {
  NewTurn: PlayOrFizzle
}
