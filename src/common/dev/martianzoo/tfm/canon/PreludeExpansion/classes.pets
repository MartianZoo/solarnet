"The published Prelude 1 rules"
CLASS PreludeExpansion : Module {
  HAS PreludeCardPack, =1 Class<PreludePhase>
  X SoloGenerationsLeft:: -2 SoloGenerationsLeft!

  PreludePhase:: EACH Player { 2 PreludeCard }
}

"A selectable pool of Prelude cards"
ABSTRACT CLASS PreludeCardPack : Module

"The Prelude 1 card pool, selected by default with the Prelude 1 rules"
CLASS Prelude1CardPack : PreludeCardPack {
  autoSelectWhen = HAS "PreludeExpansion"
}

CLASS PreludePhase : Phase {
  NewTurn: PlayCard<Class<PreludeCard>> OR (-PreludeCard THEN 15 MC)
}

CLASS PreludeCard : CardBack
