"The published Prelude 1 rules"
CLASS PreludeExpansion : Module {
  HAS PreludeCardPack, Class<PreludePhase>
  autoSelectWhen = HAS "Prelude2Expansion"
  X SoloGenerationsLeft:: -2 SoloGenerationsLeft!

  SetupPhase:: EACH Player { 4 PreludeCard THEN -2 PreludeCard }
}

CLASS PreludePhase : Phase {
  NewTurn: PlayCard<Class<PreludeCard>, Hand> OR (-PreludeCard THEN 15 MC)
}
