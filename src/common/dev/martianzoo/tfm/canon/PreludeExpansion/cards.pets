CLASS ValleyTrust : CardFront<Class<CorporationCard>> {
  cost = 0

  This:: EarthTag<This>
  This: 37 MC, Mandate { -> CARDS[3 PreludeCard<Selecting>, PreludeCard<Hand FROM Selecting>, PlayCard<Class<PreludeCard>>] }
  PlayTag<Class<ScienceTag>>:: -2 Owed<>
}

CLASS Vitor : CardFront<Class<CorporationCard>> {
