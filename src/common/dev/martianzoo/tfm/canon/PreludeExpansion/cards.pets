// Prelude 1 card pack declarations.
CLASS CheungShingMars : CardFront<Class<CorporationCard>> {
  cost = 0

  This:: BuildingTag<This>
  This: 44 MC, PROD[3 MC]
  PlayTag<Class<BuildingTag>>:: -2 Owed<>
}

