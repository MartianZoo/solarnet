CLASS MartianSurvey : EventCard<Class<ProjectCard>> {
  cost = 9
  requirement = HAS "MAX 4 OxygenStep"

  This:: ScienceTag<This>, EventTag<This>
  This: 2 ProjectCard
  End: VictoryPoint
}

CLASS Psychrophiles : ActionCard, ActiveCard<Class<ProjectCard>>, ResourceCard<Class<Microbe>> {
  cost = 2
  requirement = HAS "MAX 5 TemperatureStep"

  This:: MicrobeTag<This>
  PlayTag<Class<PlantTag>>:: AcceptFromCard<This>
  PayFromCard<This>:: -2 Owed<>

  -> Microbe<This>
}

