// Turmoil declarations that accompany the generated project cards.

// Published Turmoil Global Events.
CLASS DemocraticReform : GePartyDistant<MarsFirst>, GePartyCurrent<Greens> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<AquiferReleasedByPublicCouncil>>
}

CLASS AquiferReleasedByPublicCouncil : GlobalEffect {
  This IF StartToken, GpIncomplete<Class<OceanTile>>: OceanTile<> BY Admin
  This: Plant / Influence, Steel / Influence
}

CLASS MiningRestrictions : GePartyDistant<Reds>, GePartyCurrent<Unity> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<AsteroidMiningGlobalEffect>>
}

CLASS AsteroidMiningGlobalEffect : GlobalEffect {
  This: Titanium / JovianTag MAX 5, Titanium / Influence
}

CLASS SolarnetGlobalEvent : GePartyDistant<Unity>, GePartyCurrent<Greens> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<CelebrityLeaders>>
}

CLASS CelebrityLeaders : GlobalEffect {
  This: 2 MC / PlayedEvent MAX 5, 2 MC / Influence
}

CLASS FreeAcademiaTreaty : GePartyDistant<Scientists>, GePartyCurrent<Scientists> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<Diversity>>
}

CLASS Diversity : GlobalEffect {
  This: 10 MC / (9 (Class<@Tag>(HAS @Tag) OR Influence) MAX 1)
}

CLASS MinimalImpactPolicy : GePartyDistant<Reds>, GePartyCurrent<Unity> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<DryDeserts>>
}

CLASS DryDeserts : GlobalEffect {
  This IF StartToken, GpIncomplete<Class<OceanTile>>: -OceanTile
  This: EACH Influence { StandardResource }
}

CLASS ExperimentalLifeforms : GePartyDistant<Greens>, GePartyCurrent<Reds> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<EcoSabotage>>
}

CLASS EcoSabotage : GlobalEffect {
  This: -Plant! / (Plant - Influence - 3)
}

CLASS SelfSufficiencyProgram : GePartyDistant<Greens>, GePartyCurrent<MarsFirst> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<Election>>
}

CLASS Election : GlobalEffect {
  This IF MultiplayerMode, Me@Player(HAS =1 (RANK Ranked@Player { Influence<Ranked@> OR BuildingTag<Ranked@> OR CityTile<Ranked@> })): 2 TerraformRating
  This IF MultiplayerMode, Me@Player(HAS =2 (RANK Ranked@Player { Influence<Ranked@> OR BuildingTag<Ranked@> OR CityTile<Ranked@> })): TerraformRating
  This IF SoloMode: TerraformRating / 5 (Influence OR BuildingTag OR CityTile) MAX 2
}

CLASS TerraformingLobbying : GePartyDistant<Kelvinists>, GePartyCurrent<Unity> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<GenerousFunding>>
}

CLASS GenerousFunding : GlobalEffect {
  This: 2 MC / 5 (TerraformRating - 15) MAX 5, 2 MC / Influence
}

CLASS HeatFirstPolicy : GePartyDistant<Kelvinists>, GePartyCurrent<Greens> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<GlobalDustStorm>>
}

CLASS GlobalDustStorm : GlobalEffect {
  This: -Heat! / Heat, -2 MC. / (BuildingTag MAX 5 - Influence)
}

CLASS RedResistance : GePartyDistant<Reds>, GePartyCurrent<Unity> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<HomeworldSupport>>
}

CLASS HomeworldSupport : GlobalEffect {
  This: 2 MC / EarthTag MAX 5, 2 MC / Influence
}

CLASS SecondEnergyCrisis : GePartyDistant<Scientists>, GePartyCurrent<Kelvinists> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<ImprovedEnergyTemplates>>
}

CLASS ImprovedEnergyTemplates : GlobalEffect {
  This: PROD[Energy / 2 (PowerTag OR Influence)]
}

CLASS CharismaticWgPresident : GePartyDistant<Unity>, GePartyCurrent<Unity> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<InterplanetaryTradeGlobalEffect>>
}

CLASS InterplanetaryTradeGlobalEffect : GlobalEffect {
  This: 2 MC / SpaceTag MAX 5, 2 MC / Influence
}

CLASS RisingAlloyDemand : GePartyDistant<MarsFirst>, GePartyCurrent<Greens> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<MinersOnStrike>>
}

CLASS MinersOnStrike : GlobalEffect {
  This: -Titanium. / (JovianTag MAX 5 - Influence)
}

CLASS ThawMining : GePartyDistant<Kelvinists>, GePartyCurrent<Greens> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<MudSlides>>
}

CLASS MudSlides : GlobalEffect {
  This: -4 MC. / (OwnedTile<MarsArea(HAS Neighbor<OceanTile>)> MAX 5 - Influence)
}

CLASS ViralModificationsApproved : GePartyDistant<Greens>, GePartyCurrent<MarsFirst> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<Pandemic>>
}

CLASS Pandemic : GlobalEffect {
  This: -3 MC. / (BuildingTag MAX 5 - Influence)
}

CLASS ScientificConsensus : GePartyDistant<Kelvinists>, GePartyCurrent<Reds> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<ParadigmBreakdown>>
}

CLASS ParadigmBreakdown : GlobalEffect {
  This: -2 ProjectCard., 2 MC / Influence
}

CLASS ScientificProgress : GePartyDistant<Scientists>, GePartyCurrent<MarsFirst> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<Productivity>>
}

CLASS Productivity : GlobalEffect {
  This: Steel / PROD[Steel] MAX 5, Steel / Influence
}

CLASS AntarcticaMelts : GePartyDistant<Kelvinists>, GePartyCurrent<Reds> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<RedInfluence>>
}

CLASS RedInfluence : GlobalEffect {
  This: -3 MC. / (5 (TerraformRating - 10) MAX 5), PROD[1 MC / Influence]
}

CLASS WorldGovernmentDirectives : GePartyDistant<Unity>, GePartyCurrent<MarsFirst> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<Revolution>>
}

CLASS Revolution : GlobalEffect {
  This IF MultiplayerMode, Me@Player(HAS 1 (EarthTag OR Influence), HAS =1 (RANK Ranked@Player { EarthTag<Ranked@> OR Influence<Ranked@> })): -2 TerraformRating.
  This IF MultiplayerMode, Me@Player(HAS 1 (EarthTag OR Influence), HAS =2 (RANK Ranked@Player { EarthTag<Ranked@> OR Influence<Ranked@> })): -TerraformRating.
  This IF SoloMode, Me@Player(HAS 4 (EarthTag OR Influence)): -2 TerraformRating.
}

CLASS IndependenceMovement : GePartyDistant<MarsFirst>, GePartyCurrent<Reds> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<Riots>>
}

CLASS Riots : GlobalEffect {
  This: -4 MC. / (CityTile MAX 5 - Influence)
}

CLASS CorporateAlliance : GePartyDistant<Unity>, GePartyCurrent<Reds> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<SabotageGlobalEffect>>
}

CLASS SabotageGlobalEffect : GlobalEffect {
  This: PROD[-Steel., -Energy.], Steel / Influence
}

CLASS ExploreFirstDirective : GePartyDistant<Reds>, GePartyCurrent<Scientists> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<ScientificCommunity>>
}

CLASS ScientificCommunity : GlobalEffect {
  This: 1 MC / ProjectCard, 1 MC / Influence
}

CLASS MoholeLakeGlobalEvent : GePartyDistant<Kelvinists>, GePartyCurrent<Kelvinists> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<SnowCover>>
}

CLASS SnowCover : GlobalEffect {
  This IF StartToken, GpIncomplete<Class<TemperatureStep>>: -2 TemperatureStep BY Admin
  This: ProjectCard / Influence
}

CLASS IncreasedInterplanetaryTrade : GePartyDistant<Unity>, GePartyCurrent<Kelvinists> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<SolarFlare>>
}

CLASS SolarFlare : GlobalEffect {
  This: -3 MC. / (SpaceTag MAX 5 - Influence)
}

CLASS AiResearch : GePartyDistant<Scientists>, GePartyCurrent<MarsFirst> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<SolarnetShutdown>>
}

CLASS SolarnetShutdown : GlobalEffect {
  This: -3 MC. / (ActiveCard MAX 5 - Influence)
}

CLASS BioengineeringBoom : GePartyDistant<Greens>, GePartyCurrent<Scientists> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<SpinOffProducts>>
}

CLASS SpinOffProducts : GlobalEffect {
  This: 2 MC / ScienceTag MAX 5, 2 MC / Influence
}

CLASS ScienceSummit : GePartyDistant<Scientists>, GePartyCurrent<Greens> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<SponsoredProjects>>
}

CLASS SponsoredProjects : GlobalEffect {
  This IF StartToken: EACH Card@ResourceCard<Anyone>(HAS CardResource) { CardResource<Card@> BY Admin }
  This: ProjectCard / Influence
}

CLASS MoralMovement : GePartyDistant<Reds>, GePartyCurrent<MarsFirst> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<StrongSociety>>
}

CLASS StrongSociety : GlobalEffect {
  This: 2 MC / CityTile MAX 5, 2 MC / Influence
}

CLASS LocalTerraformingSupport : GePartyDistant<MarsFirst>, GePartyCurrent<Scientists> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<SuccessfulOrganisms>>
}

CLASS SuccessfulOrganisms : GlobalEffect {
  This: Plant / PROD[Plant] MAX 5, Plant / Influence
}

CLASS PateraBoring : GePartyDistant<Scientists>, GePartyCurrent<Kelvinists> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<VolcanicEruptions>>
}

CLASS VolcanicEruptions : GlobalEffect {
  This IF StartToken: 2 TemperatureStep BY Admin
  This: PROD[Heat / Influence]
}

CLASS SeparatistMovement : GePartyDistant<MarsFirst>, GePartyCurrent<Kelvinists> {
  Current<This>:: PendingGlobalEffect<Current<This>, Class<WarOnEarth>>
}

CLASS WarOnEarth : GlobalEffect {
  This: -TerraformRating. / (4 - Influence)
}
