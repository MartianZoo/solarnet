"Terra Cimmeria's MSL Curiosity placement bonus; its colony branch exists only with Colonies"
CLASS CimmeriaPlacementBonus : Signal {
  This IF ColoniesExpansion: Colony<>, -5 MC
}

CLASS Planetologist : Milestone { requirement = HAS "2 EarthTag, 2 VenusTag, 2 JovianTag" }
CLASS Architect : Milestone { requirement = HAS "3 CityTag" }
CLASS Coastguard : Milestone { requirement = HAS "3 OwnedTile<MarsArea(HAS Neighbor<OceanTile>)>" }
CLASS Forester : Milestone { requirement = HAS "PROD[3 Plant]" }
// Search for GrossHack to understand this nonsense.
CLASS Fundraiser : Milestone { requirement = HAS "PROD[12 (MC - 5)]" }

CLASS Electrician : Award { metric = COUNT "PowerTag" }
CLASS Founder : Award { metric = COUNT "OwnedTile<MarsArea(HAS Neighbor<SpecialTile<Anyone>>)>" }
CLASS Mogul : Award { metric = COUNT "PROD[Steel OR Titanium OR Plant OR Energy OR Heat]" }
CLASS Zoologist : Award { metric = COUNT "Animal OR Microbe" }
CLASS Forecaster : Award { metric = COUNT "CardFront(HAS requirement)" }

CLASS CimmeriaMap : MarsMap

// The map areas below are code-generated based on the following comment
//               W     LP    VS    LP   WPP
//
//           WTT    L     L     L    LPS    WP
//
//         L     L     LX    L     L     LP    L
//
//      VS    L     LS    L    LSS    L    VTT    LC
//
//   L     L     L     LS    LS    LC    L    LSC    W
//
//     VCC    L    LTSS   L     LT   LSS    L    LSS
//
//        LPP    LT    L    LPSS  LPP    LP   WPP
//
//            W     LP    LT    LC   LPP   WPP
//
//              WPP    WP    WP    LP    WP

