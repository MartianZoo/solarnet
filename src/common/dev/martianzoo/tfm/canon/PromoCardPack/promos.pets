"Adds official promotional project, corporation, and prelude cards"
CLASS PromoCardPack : Module {
  This: EACH Class^1<Resource> { ResourceRemovalWatcher<Class^1> }
  This: EACH Class^1<StandardResource> { ProductionDecreaseWatcher<Class^1> }
}

"Asks its owner to choose an ocean area while preserving the Player who places it"
CLASS ChooseOceanArea : Owned, Signal {
  This BY Actor^1: OceanTile<> BY Actor^1
}

"The moving marker placed by Mars Nomads"
CLASS NomadsMarker : Owned<Player>, AreaPiece<LandArea^1> {
  HAS MAX 1 This
  Tile<LandArea^1> BY Anyone:: Die
}

"A durable generational resource-removal record owned by the victim and naming the attacker"
CLASS MyResourceWasRemoved<Class<Resource>, Player, GenerationScope> : Owned<Owner>, Hidden

"A durable generational production-decrease record owned by the victim and naming the attacker"
CLASS MyProductionWasDecreased<Class<StandardResource>, Player, GenerationScope> : Owned<Owner>, Hidden

CLASS ResourceRemovalWatcher<Class<Resource^1>> : System {
  HAS =1 This
  -X Resource^1<Owner^Victim(NOT Player^Attacker)> BY Player^Attacker:: MyResourceWasRemoved<Owner^Victim, Class<Resource^1>, Player^Attacker>.
}

CLASS ProductionDecreaseWatcher<Class<StandardResource^1>> : System {
  HAS =1 This
  -X Production<Owner^Victim(NOT Player^Attacker), Class<StandardResource^1>> BY Player^Attacker:: MyProductionWasDecreased<Owner^Victim, Class<StandardResource^1>, Player^Attacker>.
}
