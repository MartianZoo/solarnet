"Adds official promotional project, corporation, and prelude cards"
CLASS PromoCardPack : Module {
  This: EACH @Class<Resource> { ResourceRemovalWatcher<@Class> }
  This: EACH @Class<StandardResource> { ProductionDecreaseWatcher<@Class> }
}

"A durable generational resource-removal record owned by the victim and naming the attacker"
CLASS MyResourceWasRemoved<Class<Resource>, Player, GenerationScope> : Owned<Owner>, Hidden

"A durable generational production-decrease record owned by the victim and naming the attacker"
CLASS MyProductionWasDecreased<Class<StandardResource>, Player, GenerationScope> : Owned<Owner>, Hidden

CLASS ResourceRemovalWatcher<Class<@Resource>> : System {
  HAS =1 This
  -X @Resource<Victim@Owner(NOT Attacker@Player)> BY Attacker@Player:: MyResourceWasRemoved<Victim@Owner, Class<@Resource>, Attacker@Player>.
}

CLASS ProductionDecreaseWatcher<Class<@StandardResource>> : System {
  HAS =1 This
  -X Production<Victim@Owner(NOT Attacker@Player), Class<@StandardResource>> BY Attacker@Player:: MyProductionWasDecreased<Victim@Owner, Class<@StandardResource>, Attacker@Player>.
}
