"Adds official promotional project, corporation, and prelude cards"
CLASS PromoCardPack : Module {
  This: EACH @Class<Resource> { ResourceRemovalWatcher<@Class> }
  This: EACH @Class<StandardResource> { ProductionDecreaseWatcher<@Class> }
}

"A durable generational resource-removal record owned by the victim and naming the attacker"
CLASS MyResourceWasRemoved<Class<Resource>, Player, GenerationScope> : Owned, Hidden

"A durable generational production-decrease record owned by the victim and naming the attacker"
CLASS MyProductionWasDecreased<Class<StandardResource>, Player, GenerationScope> : Owned, Hidden

CLASS ResourceRemovalWatcher<Class<@Resource>> : System, Hidden {
  HAS =1 This
  -X @Resource<Victim@Anyone(NOT Attacker@Player)> BY Attacker@Player: MyResourceWasRemoved<Victim@Anyone, Class<@Resource>, Attacker@Player>.
}

CLASS ProductionDecreaseWatcher<Class<@StandardResource>> : System, Hidden {
  HAS =1 This
  -X Production<Victim@Anyone(NOT Attacker@Player), Class<@StandardResource>> BY Attacker@Player: MyProductionWasDecreased<Victim@Anyone, Class<@StandardResource>, Attacker@Player>.
}
