"Adds official promotional project, corporation, and prelude cards"
CLASS PromoCardPack : Module {
  This: EACH Class<Resource> { ResourceRemovalWatcher<Class<Resource>> }
  This: EACH Class<StandardResource> { ProductionDecreaseWatcher<Class<StandardResource>> }
}

"Asks its owner to choose an ocean area while preserving the Player who places it"
CLASS ChooseOceanArea : Owned, Signal {
  This BY Actor: OceanTile<> BY Actor
}

"The moving marker placed by Mars Nomads"
CLASS NomadsMarker<LandArea> : AreaPiece, Owned<Player> {
  HAS MAX 1 This
  Tile<LandArea> BY Anyone:: Die
}

"A durable generational resource-removal record owned by the victim and naming the attacker"
CLASS MyResourceWasRemoved<Class<Resource>, Player> : Owned<Owner>, Generational, Hidden

"A durable generational production-decrease record owned by the victim and naming the attacker"
CLASS MyProductionWasDecreased<Class<StandardResource>, Player> : Owned<Owner>, Generational, Hidden

CLASS ResourceRemovalWatcher<Class<Resource>> : System {
  HAS =1 This
  -X Resource<Owner(NOT Player)> BY Player:: MyResourceWasRemoved<Owner(NOT Player), Class<Resource>, Player>.
}

CLASS ProductionDecreaseWatcher<Class<StandardResource>> : System {
  HAS =1 This
  -X Production<Owner(NOT Player), Class<StandardResource>> BY Player:: MyProductionWasDecreased<Owner(NOT Player), Class<StandardResource>, Player>.
}
