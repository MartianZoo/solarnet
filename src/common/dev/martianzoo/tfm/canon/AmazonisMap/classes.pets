"Enforces the longer global-parameter tracks printed on Amazonis Planitia"
CLASS ExtendedGlobalParametersRule : Module {
  autoSelectWhen = HAS "AmazonisMap"

  HAS MAX 22 TemperatureStep
  HAS MAX 18 OxygenStep
  HAS MAX 11 OceanTile

  TemperatureStep IF =3 TemperatureStep: PROD[Heat]
  TemperatureStep IF =5 TemperatureStep: PROD[Heat]
  TemperatureStep IF =9 TemperatureStep: PROD[Plant]
  TemperatureStep IF =15 TemperatureStep: OceanTile<>
  TemperatureStep IF =22 TemperatureStep:: GpComplete<Class<TemperatureStep>>

  OxygenStep IF =7 OxygenStep: ProjectCard
  OxygenStep IF =11 OxygenStep: TemperatureStep
  OxygenStep IF =18 OxygenStep:: GpComplete<Class<OxygenStep>>

  OceanTile<MarsArea> IF =11 OceanTile:: GpComplete<Class<OceanTile>>
}

// Amazonis Planitia milestones, then awards, in board order.
CLASS Terran : Milestone { requirement = HAS "5 EarthTag" }
CLASS Landshaper : Milestone { requirement = HAS "CityTile, GreeneryTile, SpecialTile" }
CLASS Merchant3 : Milestone {
  requirement = HAS "3 MC, 3 Steel, 3 Titanium, 3 Plant, 3 Energy, 3 Heat"
}
CLASS Sponsor : Milestone { requirement = HAS "3 CardFront(HAS 20 cost)" }
// CLASS Lobbyist : Milestone { requirement = HAS "7 Delegate<Owner, Party>" }

CLASS Collector : Award { metric = COUNT "Class<Resource>(HAS Resource<Owner>)" }
CLASS Innovator : Award { metric = COUNT "CardFront OR CardBack<EventPile>" }
CLASS Constructor : Award { metric = COUNT "Colony OR CityTile" }
CLASS Manufacturer : Award { metric = COUNT "PROD[Steel OR Heat]" }
CLASS Physicist : Award { metric = COUNT "ScienceTag OR SpaceTag" }

CLASS AmazonisMap : MarsMap

// The map areas below are code-generated based on the following comment
//                  LS   LSS    LS    LC   LTT    L
//
//               W     LD    LS    L     LP   WPP   WTT
//
//           WSS    L    LCC    L     LP    W     LP   LPP
//
//         LT    W     L     L     LP    LP   LPP    LP   LPC
//
//     VSS    LP    LR    LP    WC    LP   LPP    LP    LR   WPP
//
//   LP    LP   LPP   LPP   WPP   WPP   LSPP   LP    L     LP    WC
//
//      LP   LPP   WPP   LEE    LE   LEE    L     LP    LP    VD
//
//         LP   WCC    LP    LE   LEE    LP   VDD    LS    L
//
//           WST    L     LT    L     L    LPP    L     VT
//
//               W     L     LR    L    L3P   LPP   VSS
//
//                  L    LST   LSS    L     LP    LC

