}

CLASS StormcraftIncorporated : ActionCard, ResourceCard<Class<Floater>, Class<CorporationCard>> {
  cost = 0

  This:: JovianTag<This>
  This: 48 MC
  Billing<HasActions, ActionSlot, Class<Heat>>:: AcceptFromCard<This>
  PayFromCard<This>:: -2 Owed<Class<Heat>>
  LocalHeatTrapping: (-Floater<This> THEN 2 Heat) OR (-2 Floater<This> THEN 4 Heat) OR (-3 Floater<This> THEN 5 Heat) OR Ok

  -> Floater
}

