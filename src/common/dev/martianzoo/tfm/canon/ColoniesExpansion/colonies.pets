  FinishTrade<This> IF =1 ColonyProduction<This>: 3 Heat
  FinishTrade<This> IF =2 ColonyProduction<This>: 4 Heat
  FinishTrade<This> IF =3 ColonyProduction<This>: 6 Heat
  FinishTrade<This> IF =4 ColonyProduction<This>: 8 Heat
  FinishTrade<This> IF =5 ColonyProduction<This>: 10 Heat
