CLASS Luna : ColonyTile, ColonyTileSelection<Class<Luna>> {
  OWN[Colony<This>: PROD[2 MC]]
  OWN[GainColonyBonus<This>: 2 MC]

  OWN[FinishTrade<This> IF =0 ColonyProduction<This>: 1 MC]
  OWN[FinishTrade<This> IF =1 ColonyProduction<This>: 2 MC]
  OWN[FinishTrade<This> IF =2 ColonyProduction<This>: 4 MC]
  OWN[FinishTrade<This> IF =3 ColonyProduction<This>: 7 MC]
  OWN[FinishTrade<This> IF =4 ColonyProduction<This>: 10 MC]
  OWN[FinishTrade<This> IF =5 ColonyProduction<This>: 13 MC]
  OWN[FinishTrade<This> IF =6 ColonyProduction<This>: 17 MC]
