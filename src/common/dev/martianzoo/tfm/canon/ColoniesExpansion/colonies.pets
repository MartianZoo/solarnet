  OWN[FinishTrade<This> IF =1 ColonyProduction<This>: Plant]
  OWN[FinishTrade<This> IF =2 ColonyProduction<This>: 2 Plant]
  OWN[FinishTrade<This> IF =3 ColonyProduction<This>: 3 Plant]
  OWN[FinishTrade<This> IF =4 ColonyProduction<This>: 4 Plant]
  OWN[FinishTrade<This> IF =5 ColonyProduction<This>: 5 Plant]
  OWN[FinishTrade<This> IF =6 ColonyProduction<This>: 6 Plant]
