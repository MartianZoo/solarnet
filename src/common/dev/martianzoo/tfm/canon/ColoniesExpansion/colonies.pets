"Expansion adding colony tiles, player colonies, and trade fleets"
CLASS ColoniesExpansion : Module {
  TradeAction<Action1>: 9 Owed<> THEN Billing<Class<TradeAction>, Action1>
  TradeAction<Action2>: 3 Owed<Class<Energy>> THEN Billing<Class<TradeAction>, Action2, Class<Energy>>
  TradeAction<Action3>: 3 Owed<Class<Titanium>> THEN Billing<Class<TradeAction>, Action3, Class<Titanium>>
  This: BuildColonyProject
  HAS Class<TradeAction>, Class<Action3>
  -Billing<Class<TradeAction>>: Trade
  SetupPhase: EACH Me@Player { TradeFleet }
  SetupPhase IF SoloMode, SelectedColonyTile: EACH Me@Player { SoloColoniesSetup }
  SetupPhase IF SoloMode: PROD[-2 MC<Player>]
  ColoniesSolarPhase: AdvanceColonyTracks
}

"A colony tile, such as Pluto"
ABSTRACT CLASS ColonyTile : System {
  HAS MAX 1 This, MAX 3 Colony<This>, MAX 1 Trade<This>

  This:: ColonyProduction<This>
  Colony<This>:: ColonyProduction<This> / Colony<This, Anyone> - ColonyProduction<This>
  ResetColonyProduction<This>: -ColonyProduction<This>. / ColonyProduction<This> - Colony<This, Anyone>
  AdvanceColonyTracks: ColonyProduction<This>.
  FinishTrade<This>: ResetColonyProduction<This>
}

CLASS Callisto : ColonyTile, ColonyTileSelection<Class<Callisto>> {
  Colony<This>: PROD[Energy]
  GainColonyBonus<This>: 3 Energy

  FinishTrade<This> IF =0 ColonyProduction<This>: Ok
  FinishTrade<This> IF =1 ColonyProduction<This>: 2 Energy
  FinishTrade<This> IF =2 ColonyProduction<This>: 3 Energy
  FinishTrade<This> IF =3 ColonyProduction<This>: 5 Energy
  FinishTrade<This> IF =4 ColonyProduction<This>: 7 Energy
  FinishTrade<This> IF =5 ColonyProduction<This>: 10 Energy
  FinishTrade<This> IF =6 ColonyProduction<This>: 13 Energy
}

CLASS Ceres : ColonyTile, ColonyTileSelection<Class<Ceres>> {
  Colony<This>: PROD[Steel]
  GainColonyBonus<This>: 2 Steel

  FinishTrade<This> IF =0 ColonyProduction<This>: Steel
  FinishTrade<This> IF =1 ColonyProduction<This>: 2 Steel
  FinishTrade<This> IF =2 ColonyProduction<This>: 3 Steel
  FinishTrade<This> IF =3 ColonyProduction<This>: 4 Steel
  FinishTrade<This> IF =4 ColonyProduction<This>: 6 Steel
  FinishTrade<This> IF =5 ColonyProduction<This>: 8 Steel
  FinishTrade<This> IF =6 ColonyProduction<This>: 10 Steel
}

CLASS Enceladus : ColonyTile {
