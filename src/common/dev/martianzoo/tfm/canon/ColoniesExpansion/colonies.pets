CLASS Miranda : ColonyTile {
  OWN[Colony<This>: Animal]
  OWN[GainColonyBonus<This>: ProjectCard]

  FinishTrade<This> IF =0 ColonyProduction<This>: Ok
  OWN[FinishTrade<This> IF =1 ColonyProduction<This>: Animal]
  OWN[FinishTrade<This> IF =2 ColonyProduction<This>: Animal]
  OWN[FinishTrade<This> IF =3 ColonyProduction<This>: 2 Animal]
  OWN[FinishTrade<This> IF =4 ColonyProduction<This>: 2 Animal]
  OWN[FinishTrade<This> IF =5 ColonyProduction<This>: 3 Animal]
  OWN[FinishTrade<This> IF =6 ColonyProduction<This>: 3 Animal]
}

CLASS Pluto : ColonyTile, ColonyTileSelection<Class<Pluto>> {
  OWN[Colony<This>: 2 ProjectCard]
  OWN[GainColonyBonus<This>: PlutoLock! THEN ProjectCard THEN -ProjectCard THEN -PlutoLock!]

  FinishTrade<This> IF =0 ColonyProduction<This>: Ok
  OWN[FinishTrade<This> IF =1 ColonyProduction<This>: ProjectCard]
  OWN[FinishTrade<This> IF =2 ColonyProduction<This>: 2 ProjectCard]
  OWN[FinishTrade<This> IF =3 ColonyProduction<This>: 2 ProjectCard]
  OWN[FinishTrade<This> IF =4 ColonyProduction<This>: 3 ProjectCard]
  OWN[FinishTrade<This> IF =5 ColonyProduction<This>: 3 ProjectCard]
  OWN[FinishTrade<This> IF =6 ColonyProduction<This>: 4 ProjectCard]
}

CLASS PlutoLock : Owned<Player> { HAS MAX 1 This }

