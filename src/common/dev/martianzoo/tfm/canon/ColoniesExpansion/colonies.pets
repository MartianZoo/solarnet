  GainColonyBonus<This>: Titanium

  FinishTrade<This> IF =0 ColonyProduction<This>: Ok
  FinishTrade<This> IF =1 ColonyProduction<This>: Titanium
  FinishTrade<This> IF =2 ColonyProduction<This>: Titanium
  FinishTrade<This> IF =3 ColonyProduction<This>: 2 Titanium
  FinishTrade<This> IF =4 ColonyProduction<This>: 3 Titanium
  FinishTrade<This> IF =5 ColonyProduction<This>: 4 Titanium
  FinishTrade<This> IF =6 ColonyProduction<This>: 5 Titanium
}

"One of the up-to-three colonies players can own on a ColonyTile"
CLASS Colony<@ColonyTile> : Owned<Player> {
  DEFAULT +Colony<ColonyTile(HAS MAX 0 Colony)>
  FinishTrade<Anyone, @ColonyTile> OR GainColonyBonuses: GainColonyBonus<@ColonyTile>
}

"A player's persistent capacity to conduct one Trade per generation"
CLASS TradeFleet : Owned<Player>

"A trade with one colony tile, retained until the next generation"
CLASS Trade<@ColonyTile, GenerationScope> : Owned<Player> {
  This:: (MAX 0 (Trade - TradeFleet): TradeBarrier<@ColonyTile>)
  This: -TradeBarrier<@ColonyTile>
}

"One unresolved barrier to completing a Trade"
CLASS TradeBarrier<@ColonyTile> : Owned<Player>, Barrier, Hidden, System {
  -This IF MAX 0 This: FinishTrade<@ColonyTile>
}

"The owner-attributed event that begins a Trade's completion consequences"
CLASS FinishTrade<ColonyTile> : Owned<Player>, Signal, System

"Trade with a colony tile"
CLASS TradeAction<ActionSlot> : StandardAction {
  DEFAULT TradeAction<Action1>
}

CLASS BuildColonyProject : StandardProject {
  cost = 17
  1 MC / cost -> Colony<>
}

"A selected colony tile, whether it is already in play or waiting for a compatible card"
ABSTRACT CLASS ColonyTileSelection<Class<ColonyTile>> { HAS MAX 1 This }

"A colony selected by the premise but not realized until setup is complete"
ABSTRACT CLASS SelectedColonyTile<Class<@ColonyTile>> : Hidden {
  HAS MAX 1 This
  CorporationPhase: ColonyTileSelection<Class<@ColonyTile>> FROM This
}

CLASS CallistoSelected : SelectedColonyTile<Class<Callisto>>
CLASS CeresSelected : SelectedColonyTile<Class<Ceres>>
CLASS EnceladusSelected : SelectedColonyTile<Class<Enceladus>>
CLASS EuropaSelected : SelectedColonyTile<Class<Europa>>
CLASS GanymedeSelected : SelectedColonyTile<Class<Ganymede>>
CLASS IoSelected : SelectedColonyTile<Class<Io>>
CLASS LunaSelected : SelectedColonyTile<Class<Luna>>
CLASS MirandaSelected : SelectedColonyTile<Class<Miranda>>
CLASS PlutoSelected : SelectedColonyTile<Class<Pluto>>
CLASS TitanSelected : SelectedColonyTile<Class<Titan>>
CLASS TritonSelected : SelectedColonyTile<Class<Triton>>

"Lets the solo player discard one selected colony tile; owned so that player makes the choice"
CLASS SoloColoniesSetup : Owned<Player>, System, Hidden {
  HAS MAX 1 This
  This: -SelectedColonyTile THEN -This!
}

"A notch on the production track of a ColonyTile; note a tile has 0 to 6 of these (not 1 to 7)"
CLASS ColonyProduction<ColonyTile> : System {
  HAS MAX 6 This
}

"An implementation detail used to trigger colony bonuses to be paid out"
CLASS GainColonyBonus<ColonyTile> : Owned<Player>, Signal, Atomized, System

"Advances every colony tile track one step during colony production"
CLASS AdvanceColonyTracks : Signal, System

"Requests one colony bonus payment for each colony the player owns"
CLASS GainColonyBonuses : Owned<Player>, Signal, System

"An implementation detail used to trigger a colony tile's 'white cube' to move left"
CLASS ResetColonyProduction<ColonyTile> : Signal, System

ABSTRACT CLASS DelayedColonyTile<Class<@ColonyTile>, Class<CardResource>> : ColonyTileSelection<Class<@ColonyTile>>

CLASS DelayedEnceladus : DelayedColonyTile<Class<Enceladus>, Class<Microbe>> {
  This IF ResourceCard<Class<Microbe>>: Enceladus FROM This
  ResourceCard<Class<Microbe>>: Enceladus FROM This
}

CLASS DelayedMiranda : DelayedColonyTile<Class<Miranda>, Class<Animal>> {
  This IF ResourceCard<Class<Animal>>: Miranda FROM This
  ResourceCard<Class<Animal>>: Miranda FROM This
}

CLASS DelayedTitan : DelayedColonyTile<Class<Titan>, Class<Floater>> {
  This IF ResourceCard<Class<Floater>>: Titan FROM This
  ResourceCard<Class<Floater>>: Titan FROM This
}
