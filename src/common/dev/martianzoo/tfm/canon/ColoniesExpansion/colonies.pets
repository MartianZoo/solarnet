  OWN[FinishTrade<This> IF =2 ColonyProduction<This>: 2 Microbe]
  OWN[FinishTrade<This> IF =3 ColonyProduction<This>: 3 Microbe]
  OWN[FinishTrade<This> IF =4 ColonyProduction<This>: 4 Microbe]
  OWN[FinishTrade<This> IF =5 ColonyProduction<This>: 4 Microbe]
  OWN[FinishTrade<This> IF =6 ColonyProduction<This>: 5 Microbe]
}

CLASS Europa : ColonyTile, ColonyTileSelection<Class<Europa>> {
  Colony<This>: OceanTile<>
  OWN[GainColonyBonus<This>: 1 MC]

  OWN[FinishTrade<This> IF =0 ColonyProduction<This>: PROD[1 MC]]
  OWN[FinishTrade<This> IF =1 ColonyProduction<This>: PROD[1 MC]]
  OWN[FinishTrade<This> IF =2 ColonyProduction<This>: PROD[Energy]]
  OWN[FinishTrade<This> IF =3 ColonyProduction<This>: PROD[Energy]]
  OWN[FinishTrade<This> IF =4 ColonyProduction<This>: PROD[Plant]]
  OWN[FinishTrade<This> IF =5 ColonyProduction<This>: PROD[Plant]]
  OWN[FinishTrade<This> IF =6 ColonyProduction<This>: PROD[Plant]]
}

CLASS Ganymede : ColonyTile, ColonyTileSelection<Class<Ganymede>> {
