  GainColonyBonus<This>: Microbe

  FinishTrade<This> IF =0 ColonyProduction<This>: Ok
  FinishTrade<This> IF =1 ColonyProduction<This>: Microbe
  FinishTrade<This> IF =2 ColonyProduction<This>: 2 Microbe
  FinishTrade<This> IF =3 ColonyProduction<This>: 3 Microbe
  FinishTrade<This> IF =4 ColonyProduction<This>: 4 Microbe
  FinishTrade<This> IF =5 ColonyProduction<This>: 4 Microbe
  FinishTrade<This> IF =6 ColonyProduction<This>: 5 Microbe
