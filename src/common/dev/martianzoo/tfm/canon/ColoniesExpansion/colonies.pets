  OWN[GainColonyBonus<This>: Floater]

  FinishTrade<This> IF =0 ColonyProduction<This>: Ok
  OWN[FinishTrade<This> IF =1 ColonyProduction<This>: Floater]
  OWN[FinishTrade<This> IF =2 ColonyProduction<This>: Floater]
  OWN[FinishTrade<This> IF =3 ColonyProduction<This>: 2 Floater]
  OWN[FinishTrade<This> IF =4 ColonyProduction<This>: 3 Floater]
  OWN[FinishTrade<This> IF =5 ColonyProduction<This>: 3 Floater]
  OWN[FinishTrade<This> IF =6 ColonyProduction<This>: 4 Floater]
}

CLASS Triton : ColonyTile, ColonyTileSelection<Class<Triton>> {
