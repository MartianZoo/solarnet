  FinishTrade<This> IF =1 ColonyProduction<This>: Plant
  FinishTrade<This> IF =2 ColonyProduction<This>: 2 Plant
  FinishTrade<This> IF =3 ColonyProduction<This>: 3 Plant
  FinishTrade<This> IF =4 ColonyProduction<This>: 4 Plant
  FinishTrade<This> IF =5 ColonyProduction<This>: 5 Plant
  FinishTrade<This> IF =6 ColonyProduction<This>: 6 Plant
