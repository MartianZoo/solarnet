  GainColonyBonus<This>: 2 MC

  FinishTrade<This> IF =0 ColonyProduction<This>: 1 MC
  FinishTrade<This> IF =1 ColonyProduction<This>: 2 MC
  FinishTrade<This> IF =2 ColonyProduction<This>: 4 MC
  FinishTrade<This> IF =3 ColonyProduction<This>: 7 MC
  FinishTrade<This> IF =4 ColonyProduction<This>: 10 MC
  FinishTrade<This> IF =5 ColonyProduction<This>: 13 MC
