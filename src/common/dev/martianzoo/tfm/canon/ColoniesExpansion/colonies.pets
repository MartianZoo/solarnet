CLASS Miranda : ColonyTile {
  Colony<This>: Animal
  GainColonyBonus<This>: ProjectCard

  FinishTrade<This> IF =0 ColonyProduction<This>: Ok
  FinishTrade<This> IF =1 ColonyProduction<This>: Animal
  FinishTrade<This> IF =2 ColonyProduction<This>: Animal
  FinishTrade<This> IF =3 ColonyProduction<This>: 2 Animal
  FinishTrade<This> IF =4 ColonyProduction<This>: 2 Animal
  FinishTrade<This> IF =5 ColonyProduction<This>: 3 Animal
  FinishTrade<This> IF =6 ColonyProduction<This>: 3 Animal
}

CLASS Pluto : ColonyTile, ColonyTileSelection<Class<Pluto>> {
  Colony<This>: 2 ProjectCard
  GainColonyBonus<This>: PlutoLock! THEN ProjectCard THEN -ProjectCard THEN -PlutoLock!

  FinishTrade<This> IF =0 ColonyProduction<This>: Ok
  FinishTrade<This> IF =1 ColonyProduction<This>: ProjectCard
  FinishTrade<This> IF =2 ColonyProduction<This>: 2 ProjectCard
  FinishTrade<This> IF =3 ColonyProduction<This>: 2 ProjectCard
  FinishTrade<This> IF =4 ColonyProduction<This>: 3 ProjectCard
  FinishTrade<This> IF =5 ColonyProduction<This>: 3 ProjectCard
  FinishTrade<This> IF =6 ColonyProduction<This>: 4 ProjectCard
}

CLASS PlutoLock : Owned<Player>, System { HAS MAX 1 This }

