  FinishTrade<This> IF =0 ColonyProduction<This>: Ok
  FinishTrade<This> IF =1 ColonyProduction<This>: Animal
  FinishTrade<This> IF =2 ColonyProduction<This>: Animal
  FinishTrade<This> IF =3 ColonyProduction<This>: 2 Animal
  FinishTrade<This> IF =4 ColonyProduction<This>: 2 Animal
  FinishTrade<This> IF =5 ColonyProduction<This>: 3 Animal
  FinishTrade<This> IF =6 ColonyProduction<This>: 3 Animal
