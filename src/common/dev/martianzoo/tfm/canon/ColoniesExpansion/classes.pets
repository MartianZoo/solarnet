  FinishTrade<This> IF =1 ColonyProduction<This>: PROD[1 MC]
  FinishTrade<This> IF =2 ColonyProduction<This>: PROD[Energy]
  FinishTrade<This> IF =3 ColonyProduction<This>: PROD[Energy]
  FinishTrade<This> IF =4 ColonyProduction<This>: PROD[Plant]
  FinishTrade<This> IF =5 ColonyProduction<This>: PROD[Plant]
  FinishTrade<This> IF =6 ColonyProduction<This>: PROD[Plant]
}

