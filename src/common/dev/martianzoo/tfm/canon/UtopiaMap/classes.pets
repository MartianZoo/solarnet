CLASS Manager : Milestone { requirement = HAS "3 SpecialTile" }
CLASS Pioneer3 : Milestone { requirement = HAS "3 Colony" }
CLASS Trader : Milestone { requirement = HAS "3 Class<CardResource>(HAS CardResource<Owner>)" }
CLASS Metallurgist : Milestone { requirement = HAS "6 PROD[Metal]" }
CLASS Researcher : Milestone { requirement = HAS "4 ScienceTag" }

CLASS Suburbian : Award { metric = COUNT "OwnedTile(HAS MAX 5 Neighbor)" }
CLASS Investor : Award { metric = COUNT "EarthTag" }
CLASS Botanist : Award { metric = COUNT "PROD[Plant]" }
CLASS Incorporator : Award { metric = COUNT "ActiveCard(HAS MAX 10 cost) OR AutomatedCard(HAS MAX 10 cost)" }
CLASS Metropolist : Award { metric = COUNT "CityTile" }

CLASS UtopiaMap : MarsMap

// The map areas below are code-generated based on the following comment
//               L     L    LEE    L     L
//
//            L    LSS   LEE   LEEC   L     L
//
