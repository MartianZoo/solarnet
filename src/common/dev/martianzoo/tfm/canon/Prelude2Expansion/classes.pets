"The published Prelude 2 expansion rules"
CLASS Prelude2Expansion : Module {
  premiseRequirement = HAS "PreludeExpansion, Prelude2CardPack"
}

"Prelude 2 card pool, including active preludes and cards that combine expansions"
CLASS Prelude2CardPack : PreludeCardPack {
  autoSelectWhen = HAS "Prelude2Expansion"
}
