// Prelude 2 card pack declarations.
CLASS NirgalEnterprises : CardFront<Class<CorporationCard>> {
  cost = 0

  This:: PowerTag<This>, PlantTag<This>, BuildingTag<This>
  This: 30 MC, PROD[Energy, Plant, Steel]
  Invoice<ClaimMilestone>:: -Owed<> / Owed<>
  Invoice<FundAward>:: -Owed<> / Owed<>
}

CLASS PalladinShipping : ActionCard<Class<CorporationCard>> {
  cost = 0

  This:: SpaceTag<This>
  This: 36 MC, 5 Titanium
  EventCard(HAS SpaceTag): Titanium

  2 Titanium -> TemperatureStep
}

CLASS SagittaFrontierServices : CardFront<Class<CorporationCard>> {
  cost = 0

  This: 31 MC, PROD[Energy, 2 MC], CARDS[SearchForCard(HAS MAX 0 PrintedTag)]
  CardFront(HAS MAX 0 Tag): 4 MC
  CardFront(HAS =1 Tag): 1 MC
}

CLASS EcoTec : CardFront<Class<CorporationCard>> {
  cost = 0

  This:: MicrobeTag<This>, PlantTag<This>
  This: 42 MC, PROD[Plant]
  BioTag: Plant OR Microbe
}

CLASS Spire : ResourceCard<Class<Science>, Class<CorporationCard>> {
  cost = 0

  This:: CityTag<This>, EarthTag<This>
  This: 50 MC, RequiredAction { -> 4 ProjectCard THEN -3 ProjectCard }
  CardFront(HAS 2 Tag): Science<This>
  UseAction<StandardProject(HAS cost)>:: AcceptingFromCard<This>
  PayFromCard<This>:: -2 Owed<>
}

CLASS AtmosphericEnhancers : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: VenusTag<This>
  This: (2 TemperatureStep OR 2 OxygenStep OR 2 VenusStep), CARDS[2 SearchForCard(HAS ReferenceTo<Class<Floater>>)]
}

CLASS BoardOfDirectors : ActionCard, ResourceCard<Class<Director>, Class<PreludeCard>> {
  cost = 0

  This:: EarthTag<This>
  This: 4 Director<This>

  -> PreludeCard, -PreludeCard OR (-12 MC THEN -Director<This> THEN PlayCard<Class<PreludeCard>, Hand>)
}

CLASS ColonyTradeHub : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: SpaceTag<This>
  This: PROD[Energy], 2 Titanium
  Colony<Anyone>: 2 MC
}

CLASS CorridorsOfPower : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: EarthTag<This>
  This: TerraformRating, 4 MC
  PartyLeader<Party>:: ProjectCard
}

CLASS EarlyColonization : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: SpaceTag<This>
  This: Colony<>, 3 Energy, 2 AdvanceColonyTracks
}

CLASS FloatingTradeHub : ActionCard, ResourceCard<Class<Floater>, Class<PreludeCard>> {
  cost = 0

  This:: SpaceTag<This>

  -> 2 Floater
  X Floater<This> -> X StandardResource
}

CLASS FocusedOrganization : ActionCard<Class<PreludeCard>> {
  cost = 0

  This: ProjectCard, StandardResource

  -> -ProjectCard THEN -StandardResource THEN Signal { This: ProjectCard, StandardResource }
}

CLASS HighCircles : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: EarthTag<This>
  This: TerraformRating, CARDS[SearchForCard(HAS partyRequirement)], \
    PartyDelegate<Party> FROM ReserveDelegate THEN PartyDelegate<Party> FROM ReserveDelegate
  MeasureInfluence:: HighCirclesInfluence
}

CLASS IndustrialComplex : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: BuildingTag<This>
  This IF MAX 0 QuickStartVariant: -18 MC, PROD[1 MC / 6 - MC, Steel / 1 - Steel, Titanium / 1 - Titanium, Plant / 1 - Plant, Energy / 1 - Energy, Heat / 1 - Heat]
  This IF QuickStartVariant: -18 MC, PROD[MC / 7 - MC, Steel / 2 - Steel, Titanium / 2 - Titanium, Plant / 2 - Plant, Energy / 2 - Energy, Heat / 2 - Heat]
}

CLASS MainBeltAsteroids : ActionCard, ResourceCard<Class<Asteroid>, Class<PreludeCard>> {
  cost = 0

  This:: SpaceTag<This>
  This: -5 MC
  Asteroid<This>: Titanium
  End: VictoryPoint / 2 Asteroid<This>

  -> Asteroid
}

CLASS OldMiningColony : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: SpaceTag<This>
  This: PROD[Titanium], Colony<>, -ProjectCard
}

CLASS PlanetaryAlliance : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: EarthTag<This>, JovianTag<This>, VenusTag<This>
  This: 2 TerraformRating, CARDS[SearchForCard(HAS PrintedTag<Class<JovianTag>>)], CARDS[SearchForCard(HAS PrintedTag<Class<VenusTag>>)]
}

CLASS ProjectEden : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: CityTag<This>, PlantTag<This>
  This: OceanTile<>, CityTile<>, GreeneryTile<>, -3 ProjectCard
}

CLASS Recession : CardFront<Class<PreludeCard>> {
  cost = 0

  This: 10 MC, EACH Player(HAS MAX 0 This<Anyone>) { -5 MC., PROD[-1 MC] }
}

CLASS RiseToPower : CardFront<Class<PreludeCard>> {
  cost = 0

  This: PROD[3 MC], \
    PartyDelegate<Party> FROM ReserveDelegate, \
    PartyDelegate<Party> FROM ReserveDelegate, \
    PartyDelegate<Party> FROM ReserveDelegate
}

CLASS SoilBacteria : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: MicrobeTag<This>
  This: CARDS[2 SearchForCard(HAS PrintedTag<Class<MicrobeTag>>)], 3 Plant
  PlantTag OR MicrobeTag: Plant
}

CLASS SpaceLanes : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: SpaceTag<This>
  This: 3 Titanium
  PlayTag<Class<PlanetaryTag>>:: -2 Owed<>
}

CLASS SuitableInfrastructure : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: BuildingTag<This>
  This: 5 Steel
  UseAction<StandardAction>:: -SuitableInfrastructurePaid.
  NewTurn IF PreludePhase:: -SuitableInfrastructurePaid.
  X Production<Class<StandardResource>> IF ActionPhase OR PreludePhase:: SuitableInfrastructurePaid.
}

CLASS TerraformingDeal : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: EarthTag<This>
  TerraformRating: 2 MC
}

CLASS VenusContract : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: VenusTag<This>
  This: CARDS[SearchForCard(HAS PrintedTag<Class<VenusTag>>)], TerraformRating
  VenusStep: 3 MC
}

CLASS VenusL1Shade : CardFront<Class<PreludeCard>> {
  cost = 0

  This:: SpaceTag<This>
  This: 3 VenusStep
}

CLASS WorldGovernmentAdvisor : ActionCard<Class<PreludeCard>> {
  cost = 0

  This:: EarthTag<This>
  This: 2 TerraformRating, ProjectCard

  -> WorldGovernmentTerraforming
}

CLASS CeresTechMarket : ActionCard, ActiveCard<Class<ProjectCard>> {
  cost = 12

  This:: ScienceTag<This>, SpaceTag<This>
  This: 2 MC / Colony
  End: VictoryPoint

  X ProjectCard -> 2X MC
}

CLASS CloudTourism : ActionCard, ActiveCard<Class<ProjectCard>>, ResourceCard<Class<Floater>> {
  cost = 11

  This:: JovianTag<This>, VenusTag<This>
  This: PROD[1 MC / EarthTag MAX VenusTag]
  End: VictoryPoint / 3 Floater<This>

  -> Floater<This>
}

CLASS ColonialEnvoys : EventCard<Class<ProjectCard>> {
  cost = 4
  requirement = HAS "Ruling<Unity> OR 2 PartyDelegate<Unity>"

  This:: EventTag<This>
  This: PlaceColonialEnvoys
}

CLASS ColonialRepresentation : ActiveCard<Class<ProjectCard>> {
  cost = 10

  This: 3 MC / Colony
  MeasureInfluence:: ColonialRepresentationInfluence
}

CLASS EnvoysFromVenus : EventCard<Class<ProjectCard>> {
  cost = 1
  requirement = HAS "3 VenusTag"

  This:: VenusTag<This>, EventTag<This>
  This: PartyDelegate<Party> FROM ReserveDelegate THEN PartyDelegate<Party> FROM ReserveDelegate
}

CLASS FloatingRefinery : ActionCard, ActiveCard<Class<ProjectCard>>, ResourceCard<Class<Floater>> {
