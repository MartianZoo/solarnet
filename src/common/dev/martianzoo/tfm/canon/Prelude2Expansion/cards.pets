  cost = 4

  This:: VenusTag<This>, EventTag<This>
  This: -ProjectCard THEN VenusStep
}

CLASS VenusAllies : AutomatedCard<Class<ProjectCard>> {
  cost = 30

  This:: VenusTag<This>, SpaceTag<This>
  This: 2 VenusStep, 4 MC / Colony
  End: 2 VictoryPoint
}

CLASS VenusOrbitalSurvey : ActionCard, ActiveCard<Class<ProjectCard>> {
  cost = 18

  This:: VenusTag<This>, SpaceTag<This>

  -> CARDS[2 ProjectCard<Selecting>, 2 ProjectCard<Hand FROM Selecting>(HAS VenusTag). THEN -2 ProjectCard<Selecting>? THEN BuySelectedCards]
}

CLASS VenusShuttles : ActionCard, ActiveCard<Class<ProjectCard>> {
  cost = 9

  This:: VenusTag<This>
  This: 2 Floater<CardFront(HAS VenusTag)>

  1 MC / (12 - VenusTag) -> VenusStep
}

CLASS VenusTradeHub : ActiveCard<Class<ProjectCard>> {
  cost = 12
  requirement = HAS "2 VenusTag"

  This:: VenusTag<This>, SpaceTag<This>
  Trade: 3 MC
  End: VictoryPoint
}

CLASS WgProject : AutomatedCard<Class<ProjectCard>> {
  cost = 9
  requirement = HAS "Chairman"

  This:: EarthTag<This>
  This: 3 PreludeCard<Selecting>, \
    PlayCard<Class<PreludeCard>, Selecting> THEN -2 PreludeCard<Selecting>
}

// Supporting declarations contributed by cards in this bundle.
CLASS Director : CardResource<ResourceHolder<Class<Director>>>

CLASS ColonialRepresentationInfluence : Influence { HAS MAX 1 This }

CLASS FrontierTownBonus : Owned<Player>, Hidden {
  HAS MAX 1 This
  Placement<MarsArea>:: -This! THEN RepeatPlacementBonus<MarsArea>
}

CLASS HighCirclesInfluence : Influence { HAS MAX 1 This }

CLASS PlaceColonialEnvoys : Owned<Player>, Custom

CLASS RepeatPlacementBonus<MarsArea> : Owned<Player>, Custom

CLASS SuitableInfrastructurePaid : Atomized, Hidden, Owned<Player> {
  HAS MAX 1 This
  This:: 2 MC
}
