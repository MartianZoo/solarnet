  cost = 10
  requirement = HAS "Ruling<Scientists> OR 2 PartyDelegate<Scientists>"

  This:: BuildingTag<This>, SpaceTag<This>
  This: 1 MC / (JovianTag OR EarthTag OR VenusTag OR Colony), 2 ProjectCard
