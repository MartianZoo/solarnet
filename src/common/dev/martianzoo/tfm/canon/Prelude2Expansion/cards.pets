  cost = 21
  requirement = HAS "4 EarthTag"

  This:: EarthTag<This>
  This: 3 TerraformRating, \
    PartyDelegate<Party> FROM ReserveDelegate THEN PartyDelegate<Party> FROM ReserveDelegate
}

