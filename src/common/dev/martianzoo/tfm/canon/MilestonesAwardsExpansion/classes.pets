CLASS GainsOf<CardFront, Class<Component>> : Custom

// A goal reprinted from a loaded map keeps the declaration from that map bundle. This bundle
// supplies the remaining supported goals and revised goals with distinct implementations.

// All Briber needs is a `Briber: -12 MC` effect attached to milestone claiming.
// CLASS Briber : Milestone { requirement = HAS "Component" }
CLASS Builder : Milestone { requirement = HAS "7 BuildingTag" }
// Requires making global-parameter components Owned.
// CLASS Hydrologist : Milestone { requirement = HAS "4 OceanTile" }
CLASS Legend : Milestone { requirement = HAS "CARDS[4 CardBack<EventPile>]" }
CLASS Merchant : Milestone { requirement = HAS "2 MC, 2 Steel, 2 Titanium, 2 Plant, 2 Energy, 2 Heat" }
CLASS Philantropist : Milestone { requirement = HAS "5 CardFront(HAS GainsOf<Class<VictoryPoint>>)" }
CLASS Pioneer : Milestone { requirement = HAS "4 Colony" }
// GrossHack contributes five synthetic M€ production components, so 21 models the printed
// combined production threshold of 16.
CLASS Producer : Milestone {
  HAS MAX 0 QuickStartVariant
  requirement = HAS "21 PROD[StandardResource]"
}
CLASS Producer22 : Milestone {
  HAS QuickStartVariant
  requirement = HAS "22 PROD[StandardResource]"
}
CLASS Tactician : Milestone { requirement = HAS "4 CardFront(HAS requirement)" }
CLASS Terraformer : Milestone { requirement = HAS "29 TerraformRating" }
// Requires making global-parameter components Owned.
// CLASS Thawer : Milestone { requirement = HAS "5 TemperatureStep" }
CLASS Tycoon : Milestone { requirement = HAS "10 (ActiveCard OR AutomatedCard)" }

CLASS Administrator : Award { metric = COUNT "CardFront(HAS MAX 0 Tag)" }
CLASS Biologist : Award { metric = COUNT "BioTag" }
// CLASS Politician : Award { metric = COUNT "PartyLeader OR Influence" }
CLASS Visionary : Award { metric = COUNT "CARDS[ProjectCard<Hand>]" }
