// A goal reprinted from a loaded map keeps the declaration from that map bundle. This bundle
// supplies the remaining supported goals and revised goals with distinct implementations.

CLASS Briber : Milestone {
  requirement = HAS "This"
  This: -12 MC
}
CLASS Builder : Milestone { requirement = HAS "7 BuildingTag" }
CLASS Hydrologist : Milestone {
  HAS Class<HydrologistWatcher>
  requirement = HAS "4 OceanCredit"
}

"Tracks ocean placements only while Hydrologist is in the milestone pool"
CLASS HydrologistWatcher<Class<Hydrologist>> : CardWatcher {
  OceanTile BY @Player: OceanCredit<@Player>
}

"A player's credit for placing an ocean"
CLASS OceanCredit : Owned<Player>

CLASS Legend : Milestone { requirement = HAS "4 PlayedEvent" }
CLASS Merchant : Milestone { requirement = HAS "2 MC, 2 Steel, 2 Titanium, 2 Plant, 2 Energy, 2 Heat" }
CLASS Philantropist : Milestone { requirement = HAS "5 Class<@CardFront>(HAS @CardFront<Me@Anyone>, HAS GainsOf<Class<VictoryPoint>>)" }
CLASS GainsOf<Class<CardFront>, Class<Component>> : CustomMetric
CLASS Pioneer : Milestone { requirement = HAS "4 Colony" }
CLASS Producer : Milestone {
  autoSelectWhen = HAS "MAX 0 QuickStartVariant"
  requirement = HAS "16 (PROD[StandardResource] - ProdOffset)"
}
CLASS Producer22 : Milestone {
  autoSelectWhen = HAS "QuickStartVariant"
  requirement = HAS "22 (PROD[StandardResource] - ProdOffset)"
}
CLASS Tactician : Milestone { requirement = HAS "4 CardFront(HAS requirement)" }
CLASS Terraformer : Milestone { requirement = HAS "29 TerraformRating" }
"Counts temperature increases made by the claiming player"
CLASS Thawer : Milestone {
  HAS Class<ThawerWatcher>
  requirement = HAS "5 ThawerCredit"
}

CLASS ThawerWatcher<Class<Thawer>> : CardWatcher {
  TemperatureStep BY @Player: ThawerCredit<@Player>
  Thawer:: -This!
}

CLASS ThawerCredit : Owned<Player>

CLASS Tycoon : Milestone { requirement = HAS "10 (ActiveCard OR AutomatedCard)" }

CLASS Administrator : Award { metric = COUNT "CardFront(HAS MAX 0 Tag)" }
CLASS Biologist : Award { metric = COUNT "BioTag" }
CLASS Politician : Award {
  metric = COUNT "PartyLeader OR Influence"
  MeasureAward<This>:: EACH Measured@Influence<Anyone> { -Measured@Influence! }
  MeasureAward<This>:: EACH Scored@Player { MeasureInfluence<Scored@Player> }
}
CLASS Visionary : Award { metric = COUNT "ProjectCard" }
