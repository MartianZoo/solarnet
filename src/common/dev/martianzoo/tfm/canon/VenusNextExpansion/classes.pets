CLASS VenusNextExpansion : Module {
  This:: AirScrappingSP
  This:: GpIncomplete<Class<VenusStep>>
  This:: StandardVenusTrackRules
}

CLASS AirScrappingSP : StandardProject {
  cost = 15
  1 MC / cost -> VenusStep
}

"Adds World Government Terraforming to the solar phase"
CLASS WorldGovernmentRule : Module {
  autoSelectWhen = HAS "VenusNextExpansion"

  SolarPhase IF GpIncomplete:: WorldGovernmentTerraforming
}

"Makes Venus a required global parameter for ending a multiplayer game"
CLASS MandatoryVenusVariant : Module {
  premiseRequirement = HAS "MultiplayerMode, VenusNextExpansion"
  This:: GpGameEndBarrier<Class<VenusStep>>
}

"Represents a 2% increase in Venus... terraformedness"
CLASS VenusStep : GlobalParameter

"Enforces the limit, rewards, and completion step printed on the standard Venus track"
CLASS StandardVenusTrackRules : System {
  HAS =1 This
  HAS MAX 15 VenusStep

  VenusStep IF =4 VenusStep: ProjectCard
  VenusStep IF =8 VenusStep: TerraformRating
  VenusStep IF =15 VenusStep:: GpComplete<Class<VenusStep>>
}

CLASS VenusTag : PlanetaryTag {
}

CLASS Hoverlord : Milestone {
  HAS MultiplayerMode
  requirement = HAS "7 Floater"
}

CLASS Venuphile : Award { metric = COUNT "VenusTag" }
