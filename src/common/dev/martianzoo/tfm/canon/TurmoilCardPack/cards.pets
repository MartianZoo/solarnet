// Published Turmoil card declarations.
CLASS LakefrontResorts : CardFront<Class<CorporationCard>> {
  cost = 0

  This:: BuildingTag<This>
  This: 54 MC
  OceanTile BY Anyone: PROD[1 MC]
  ForwardAdjacency<OceanTile, Tile>: 1 MC
}

CLASS Pristar : ResourceCard<Class<Preservation>, Class<CorporationCard>> {
  cost = 0

  This: 53 MC, -2 TerraformRating
  ProductionPhase IF MAX 0 HasRaisedTr: Preservation<This>, 6 MC
  End: VictoryPoint / Preservation<This>
}

CLASS TerraLabsResearch : CardFront<Class<CorporationCard>> {
  cost = 0

  This:: ScienceTag<This>, EarthTag<This>
  This: 14 MC, -TerraformRating
  BuyCard:: -2 Owed<>
}

CLASS UtopiaInvest : ActionCard<Class<CorporationCard>> {
  cost = 0

  This: 40 MC, PROD[Steel, Titanium]

  PROD[StandardResource] -> 4 StandardResource
}

// Supporting declarations contributed by cards in this bundle.
CLASS Preservation : CardResource<ResourceHolder<Class<Preservation>>>

CLASS HasRaisedTr : Generational, Hidden, Owned {
  HAS MAX 1 This
}

CLASS TrWatcher : Owned<Player>, System {
  HAS =1 This
  TerraformRating IF MAX 0 SetupPhase:: HasRaisedTr.
}
