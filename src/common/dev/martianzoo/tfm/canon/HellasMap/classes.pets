CLASS Diversifier : Milestone { requirement = HAS "8 Class<Tag>(HAS Tag<Owner>)" }
CLASS Tactician5 : Milestone { requirement = HAS "5 CardFront(HAS requirement)" }
CLASS PolarExplorer : Milestone {
  HAS HellasMap
  requirement = HAS "3 OwnedTile<MarsArea(HAS 8 row)>"
}
CLASS Energizer : Milestone { requirement = HAS "PROD[6 Energy]" }
CLASS RimSettler : Milestone { requirement = HAS "3 JovianTag" }

CLASS Cultivator : Award { metric = COUNT "GreeneryTile" }
CLASS Magnate : Award { metric = COUNT "AutomatedCard" }
CLASS SpaceBaron : Award { metric = COUNT "SpaceTag" }
CLASS Excentric : Award { metric = COUNT "CardResource" }
CLASS Contractor : Award { metric = COUNT "BuildingTag" }

CLASS HellasMap : MarsMap

// The map areas below are code-generated based on the following comment
//              WPP   LPP   LPP   LPS    LP
//
//           WPP   LPP    LP   LPS    LP    LP
//
//         WP    LP    LS    LS    L    LPP   LPC
//
//      WP    LP    LS   LSS    LS    WP    WP    LP
//
//   LC    L     L    LSS    L     WC   W3H    W     LP
//
//      LT    L     LS    L     L     W     WS    L
//
//        WTT    L     L     LC    L     L     LT
//
//            LS    LC   LHH   LHH    LT    LT
//
//               L    LHH   LO6   LHH    L

