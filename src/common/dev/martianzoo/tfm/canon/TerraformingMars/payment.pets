"A finalized quantity still owed in one standard-resource denomination"
CLASS Owed<Class<StandardResource> AS ResourceClass> : Owned<Player>, Barrier {
  DEFAULT +Owed<Class<MC>>
  DEFAULT -Owed<Class<MC>>.
  X This:: Accepting<ResourceClass>
}

"A finalized debt; removing it signals that its denomination has been fully paid"
ABSTRACT CLASS Billing<HasActions, ActionSlot, Class<StandardResource> AS ResourceClass> : Owned<Player>, Barrier {
  HAS MAX 1 This
  This IF MAX 0 Owed<ResourceClass>:: -This!
  -X Owed<ResourceClass> IF MAX 0 Owed<ResourceClass>:: -This!
}

"The billing produced by an action with a standard-resource cost"
CLASS ActionBilling : Billing {
  DEFAULT +ActionBilling<HasActions, ActionSlot, Class<MC>>
}

"The persistent operation that owns card play regardless of how the play was initiated"
CLASS CardPlay : HasActions { HAS =1 This }

"The finalized debt for playing a particular card"
CLASS CardBilling<Class<CardFront>> : Billing<CardPlay, Action1, Class<MC>>

CLASS Accepting<Class<StandardResource AS ThatResource>> : Owned<Player>, MustCleanUp {
  HAS MAX 1 This
  DEFAULT +Accepting.
  Billing: X Pay<Class<ThatResource>> FROM ThatResource?
  -X Billing:: -This!
}

CLASS Pay<Class<StandardResource> AS ResourceClass> : Owned<Player>, Signal {
  DEFAULT +Pay<Class<MC>>
  This:: -Owed<ResourceClass>
}

"Offers payment using the resource held by a specific card"
CLASS AcceptingFromCard<ResourceCard<Class<CardResource AS ThatResource>, Player> AS ThatCard> : Owned<Player>, MustCleanUp {
  HAS MAX 1 This
  Billing: X PayFromCard<ThatCard> FROM ThatResource<ThatCard>?
  -X Billing:: -This!
}

"Records payment using the resource held by a specific card"
CLASS PayFromCard<ResourceCard<Class<CardResource>, Player AS SameOwner>> : Owned<SameOwner>, Signal

"A card-owned adjustment that remains in play until the next card-play"
ABSTRACT CLASS NextCardEffect<GenerationScope> : Owned<Player> {
  Billing<CardPlay>:: -This!
}

"A component that makes a standard resource worth one M€ when paid"
ABSTRACT CLASS ResourceValue<Class<StandardResource> AS ResourceClass> : Owned<Player> {
  // The resource being spent can be Steel or Titanium, but it settles the default M€ debt.
  Pay<ResourceClass>:: -Owed<Class<MC>>

  "One M€ of a standard resource's ordinary payment value"
  CLASS BaseResourceValue

  "One M€ of resource value represented separately from the component granting it"
  CLASS GrantedResourceValue<CardFront>
}
