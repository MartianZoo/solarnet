"The only component to have absolutely no purpose whatsoever"
CLASS Victory : Owned<Player> { HAS MAX 1 This }

"Well it's a victory point"
CLASS VictoryPoint : Owned<Player>

"A milestone already claimed; unclaimed milestones exist only as a Class<ThatMilestoneType>"
ABSTRACT CLASS Milestone : Owned<Player> {
  HAS MAX 1 This<Player>
  HAS MAX 3 Milestone
  requirement = Requirement

  This:: (EVAL This.requirement: Ok)
  End: 5 VictoryPoint
}

"A funded award; unfunded awards exist only as a Class<ThatAwardType>"
ABSTRACT CLASS Award {
  HAS MAX 1 This
  HAS MAX 3 Award
  metric = Metric
  End: MeasureAward<This>
}

CLASS MeasureAward<Award^1, FinalScoringPending> : Temporary, System {
  -This:: EACH Player(HAS =1 (RANK Player { EVAL Award^1.metric })) { FirstPlace<Award^1> }
  -This IF 3 Player:: EACH Player(HAS =2 (RANK Player { EVAL Award^1.metric })) { SecondPlace<Award^1> }
}

CLASS FirstPlace<Award> : Owned<Player> { This:: 5 VictoryPoint }
CLASS SecondPlace<Award> : Owned<Player> { This:: 2 VictoryPoint }

"A marker removed after every final-scoring task has completed"
CLASS FinalScoringPending : Temporary, System { HAS MAX 1 This }

"(Like anything extending Custom) an implementation detail backed by Kotlin code"
CLASS ScoreEventVps<Class<CardFront>> : Owned<Player>, Custom
