"The action a player selects and performs during their turn"
ABSTRACT CLASS StandardAction : Owned<Player>, Signal {
  OWN[This:: MAX 0 RequiredAction: Ok]

  CLASS PlayProject<Class<@CardFront>> {
    OWN[This:: PlayCard<Class<ProjectCard>, Class<@CardFront>, Hand>]
  }
  CLASS UseStandardProject<@StandardProject> {
    OWN[This:: UseAction<@StandardProject, Action1>]
  }
  CLASS UseCardAction<@ActionCard<@Player>, @ActionSlot> : StandardAction<@Player> {
    OWN[This:: UseAction<@ActionCard, @ActionSlot> THEN ActionUsedMarker<@ActionCard>]
  }
  CLASS ConvertPlants {
    OWN[This: 8 Owed<Class<Plant>> THEN Billing<Class<ConvertPlants>, Class<Plant>> \
      THEN MAX 0 Billing: DefaultGreeneryTile]
  }
  CLASS ConvertHeat {
    OWN[This: 8 Owed<Class<Heat>> THEN Billing<Class<ConvertHeat>, Class<Heat>> \
      THEN MAX 0 Billing: TemperatureStep]
  }
  CLASS ClaimMilestone<Class<@Milestone>> {
    OWN[This: 8 Owed<> THEN Billing<Class<@Milestone>> THEN MAX 0 Billing: @Milestone]
  }
  CLASS FundAward<Class<@Award>> {
    This IF 3 Award: Die
    OWN[This: 8 Owed<> THEN 6 Owed<> / Award THEN Billing<Class<@Award>> \
      THEN MAX 0 Billing: @Award]
  }
}

ABSTRACT CLASS StandardProject : HasActions {
  HAS =1 This
  cost = Number

  "Discard cards for 1 megacredit each"
  CLASS SellPatentsProject {
    cost = 0
    OWN[-> X MC FROM ProjectCard]
  }

  CLASS PowerPlantProject {
    cost = 11
    OWN[1 MC / cost -> PROD[Energy]]
  }

  CLASS AsteroidProject {
    cost = 14
    OWN[1 MC / cost -> TemperatureStep]
  }

  CLASS AquiferProject {
    cost = 18
    OWN[1 MC / cost -> OceanTile<>]
  }

  CLASS GreeneryProject {
    cost = 23
    OWN[1 MC / cost -> DefaultGreeneryTile]
  }

  CLASS CityProject {
    cost = 25
    OWN[1 MC / cost -> CityTile<>, PROD[1 MC]]
  }
}

"Any component that can respond to `UseAction` signals"
ABSTRACT CLASS HasActions { HAS MAX 1 This }

"A simple enum type to identify which action of a `HasActions` you want"
ABSTRACT CLASS ActionSlot : System, Hidden {
  HAS =1 This
  CLASS Action1
  CLASS Action2
  CLASS Action3
}

CLASS UseAction<HasActions, ActionSlot> : Owned<Player>, Signal

"A mandatory pending action the owner must perform as their next"
ABSTRACT CLASS RequiredAction : Owned<Player>, HasActions {
  HAS MAX 1 This
  OWN[RequiredActionsSignal:: UseAction<This, Action1> THEN -This!]
}

CLASS RequiredActionsSignal : Owned<Player>, Signal
