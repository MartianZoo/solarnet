"One of the basic options a player has on their turn"
ABSTRACT CLASS StandardAction : HasActions {
  HAS =1 This

  CLASS PlayCardFromHandAction { -> PlayCard<Class<ProjectCard>, Hand> }
  CLASS UseStandardProjectAction { -> UseAction<StandardProject> }
  CLASS UseActionOnCardAction { -> ActionUsedMarker<ActionCard> THEN UseAction<ActionCard> }
  CLASS ConvertPlantsAction { 8 Plant -> DefaultGreeneryTile }
  CLASS ConvertHeatAction { 8 Heat -> TemperatureStep }
  CLASS ClaimMilestoneAction { 8 MC -> Milestone }
  CLASS FundAwardAction {
    8 MC -> (=0 Award: Award)
    14 MC -> (=1 Award: Award)
    20 MC -> (=2 Award: Award)
  }

  "Perform the pending actions accrued by playing a corporation like Inventrix"
  CLASS DoRequiredActionsAction { -> RequiredAction: RequiredActionsSignal }
}

ABSTRACT CLASS StandardProject : HasActions {
  HAS =1 This
  cost = Number

  "Discard cards for 1 megacredit each"
  CLASS SellPatentsProject {
    cost = 0
    -> X MC FROM ProjectCard<Hand>
  }

  CLASS PowerPlantProject {
    cost = 11
    1 MC / cost -> PROD[Energy]
  }

  CLASS AsteroidProject {
    cost = 14
    1 MC / cost -> TemperatureStep
  }

  CLASS AquiferProject {
    cost = 18
    1 MC / cost -> OceanTile<>
  }

  CLASS GreeneryProject {
    cost = 23
    1 MC / cost -> DefaultGreeneryTile
  }

  CLASS CityProject {
    cost = 25
    1 MC / cost -> CityTile<>, PROD[1 MC]
  }
}

"Any component that can respond to `UseAction` signals"
ABSTRACT CLASS HasActions { HAS MAX 1 This }

"A simple enum type to identify which action of a `HasActions` you want"
ABSTRACT CLASS ActionSlot : System {
  HAS =1 This
  CLASS Action1
  CLASS Action2
  CLASS Action3
}

CLASS UseAction<HasActions, ActionSlot> : Owned<Player>, Signal {
  This IF RequiredAction: MAX 0 RequiredAction: Ok
}

"A mandatory pending action the owner must perform as their next"
ABSTRACT CLASS RequiredAction : Owned<Player>, HasActions {
  HAS MAX 1 This
  RequiredActionsSignal: UseAction<This, Action1>
  RequiredActionsSignal: -This!
}

CLASS RequiredActionsSignal : Owned<Player>, Signal
