ABSTRACT CLASS Card : Owned<Player> {
  "A generic unplayed card with unknown face"
  ABSTRACT CLASS CardBack<CardLocation> {
    DEFAULT CardBack<Hand>
    autoSelectWhen = Requirement?

    CLASS CorporationCard
    CLASS ProjectCard
  }

  "A card in play, face-up on the table (consider rename to CardFace)"
  ABSTRACT CLASS CardFront<Class<CardBack>> : TagHolder {
    cost = Number
    requirement = Requirement?
    autoSelectWhen = Requirement?

    "A blue project card"
    ABSTRACT CLASS ActiveCard : CardFront<Class<ProjectCard>>
    "A green project card"
    ABSTRACT CLASS AutomatedCard : CardFront<Class<ProjectCard>>
    "A red project card"
    ABSTRACT CLASS EventCard : CardFront<Class<ProjectCard>>, Temporary {
      HAS =1 EventTag<This>
      // Some effects move an event directly into another player's pile. Record it only if that
      // move did not already create the one played-event record for this physical card.
      -This IF MAX 0 PlayedEvent<Anyone, Class<This>>:: PlayedEvent<Class<This>>
    }

    "Any card with actions, including corporation and prelude cards"
    ABSTRACT CLASS ActionCard : HasActions

    "Any card that can hold resources"
    ABSTRACT CLASS ResourceCard : ResourceHolder
  }

  "A card in your played-events pile"
  CLASS PlayedEvent<@Class<CardFront>> {
    End: ScoreEventVps<@Class>
  }
}

CLASS PreludeCard : CardBack

"Play the selected Prelude, or declare it unplayable and receive the fizzle compensation"
CLASS PlayOrFizzle<@CardLocation> : Owned<Player>, Signal, System {
  DEFAULT PlayOrFizzle<Hand>
  This: PlayCard<Class<PreludeCard>, @CardLocation> OR (-PreludeCard<@CardLocation> THEN Audit THEN 15 MC)
}

"Bills every project card left in this Player's selection"
CLASS BuySelectedCards : Owned<Player>, Signal, System {
  This IF ProjectCard<Selecting>:: \
    3 Owed<> / ProjectCard<Selecting> THEN \
    PayingFor<Class<ProjectCard>> / ProjectCard<Selecting> THEN \
    Billing<Class<This>, Action1>
}

"An externally specified search criterion; the selected card is not tracked before it reaches a hand"
ABSTRACT CLASS CardFilter : System

"Carries the externally asserted printed-tag criterion"
CLASS TagFilter<Class<Tag>> : CardFilter, Hidden { HAS MAX 1 This }

"Carries the externally asserted absence of printed tags"
CLASS NoTagsFilter : CardFilter, Hidden { HAS MAX 1 This }

"Carries the externally asserted reference to a game concept"
CLASS ReferenceFilter<Class<Component>> : CardFilter, Hidden { HAS MAX 1 This }

"Records the search criterion while adding only the externally selected card to the hand"
CLASS SearchForCard<CardFilter> : Owned<Player>, Signal {
  This:: ProjectCard, Audit
}

"Keeps an offered project card that externally satisfies the filter"
CLASS TakeSelectedCard<CardFilter> : Owned<Player>, Signal {
  This:: ProjectCard<Hand FROM Selecting>, Audit
}

"Claims a card resource when the revealed card externally satisfies the filter"
CLASS ClaimCardReward<CardFilter, @ResourceCard<Class<@CardResource>, @Player>> : Owned<@Player>, Signal {
  This:: @CardResource<@ResourceCard> / ProjectCard<Revealed>, Audit / ProjectCard<Revealed>
}

CLASS PlayCard<Class<@CardBack>, Class<@CardFront>, @CardLocation> : Owned<Player>, Signal {
  This:: (EVAL @CardFront<Class<@CardBack>>.requirement: Ok) OR \
    (GpRequirementShortfall<Class<@CardFront>, Class<GlobalParameter>>: \
      EACH @Class<GlobalParameter> { \
        Required<@Class> / GpRequirementShortfall<Class<@CardFront>, @Class> \
          THEN CheckRequirement<Class<@CardFront>> / \
            (GpRequirementShortfall<Class<@CardFront>, @Class> MAX 1) \
      })
  This: Owed<> / @CardFront.cost THEN PriceCard<Class<@CardFront>> THEN Billing<Class<@CardFront>> THEN MAX 0 Barrier: @CardFront FROM @CardBack<@CardLocation>
}

"Signals that a printed global-parameter requirement produced a shortfall ready for adjustment"
CLASS CheckRequirement<Class<CardFront>> : Owned<Player>, Signal, System

"How far one printed global-parameter requirement is from the current track value"
CLASS GpRequirementShortfall<Class<CardFront>, Class<GlobalParameter>> : CustomMetric

"Emits payment-adjustment events for a project card and each of its printed tags"
CLASS PriceCard<Class<@CardFront>> : Owned<Player>, Signal, System {
  This:: EACH @Class<Tag> { PayingFor<@Class> / PriceAspectCount<Class<@CardFront>, @Class> }
  This:: PayingFor<Class<@CardFront>> / PriceAspectCount<Class<@CardFront>, Class<@CardFront>>
}

"Number of payment-adjustment events for one aspect of a project card"
CLASS PriceAspectCount<Class<CardFront>, Class<Component>> : CustomMetric

"A temporary shortfall between a printed global requirement and the current parameter"
CLASS Required<Class<GlobalParameter>> : Owned<Player>, Barrier, Hidden, System {
  DEFAULT -Required.
}

"The current place of an anonymous unplayed card associated with a Player"
ABSTRACT CLASS CardLocation : System {
  CLASS Hand { HAS =1 This }
  CLASS Selecting { HAS =1 This }
  CLASS Revealed { HAS =1 This }
}

// TODO: can this be simplified??
ABSTRACT CLASS TagHolder : Owned<Player>

ABSTRACT CLASS Tag<TagHolder<@Player>> : Owned<@Player>, Atomized {
  CLASS BuildingTag
  CLASS SpaceTag
  CLASS ScienceTag
  CLASS PowerTag
  CLASS CityTag
  ABSTRACT CLASS BioTag {
    CLASS PlantTag
    CLASS MicrobeTag
    CLASS AnimalTag
  }
  ABSTRACT CLASS PlanetaryTag {
    CLASS EarthTag
    CLASS JovianTag
  }
  "The printed event icon, also available when choosing a wild tag type"
  CLASS EventTag
}

// TODO: can this be simplified?
"Anything that can hold a particular kind of card resource"
ABSTRACT CLASS ResourceHolder<Class<CardResource>> : Owned

ABSTRACT CLASS Cardbound<CardFront<@Player>> : Owned<@Player>

"Marks an action card that has been used this generation"
CLASS ActionUsedMarker<GenerationScope> : Cardbound<ActionCard>, System { HAS MAX 1 This }

"A singleton listener needed by selected content"
ABSTRACT CLASS CardWatcher : System, Hidden { HAS MAX 1 This }
