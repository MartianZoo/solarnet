ABSTRACT CLASS Card<Class<CardFront>> : Owned<Player> {
  "An unplayed card that retains its exact face"
  ABSTRACT CLASS CardBack<CardLocation> : Atomized {
    DEFAULT CardBack<Hand>
    DEFAULT +CardBack
    DEFAULT -CardBack
    autoSelectWhen = Requirement?

    ABSTRACT CLASS CorporationCard
    CLASS BeginnerCorporationCard : CorporationCard {
      autoSelectWhen = HAS "BeginnerVariant"
    }
    CLASS StandardCorporationCard : CorporationCard
    CLASS ProjectCard
  }

  "A card in play, face-up on the table (consider rename to CardFace)"
  ABSTRACT CLASS CardFront<Class<CardBack>> : Card<Class<This>>, TagHolder {
    HAS MAX 1 Card<Player, Class<This>>

    cost = Number
    requirement = Requirement?
    autoSelectWhen = Requirement?

    "A blue project card"
    ABSTRACT CLASS ActiveCard : CardFront<Class<ProjectCard>>
    "A green project card"
    ABSTRACT CLASS AutomatedCard : CardFront<Class<ProjectCard>>
    "A red project card"
    ABSTRACT CLASS EventCard : CardFront<Class<ProjectCard>>, Temporary {
      HAS =1 EventTag<This>
      // Some effects move an event directly into another player's pile. Record it only if that
      // move did not already create the one played-event record for this physical card.
      -This IF MAX 0 PlayedEvent<Anyone, Class<This>>:: PlayedEvent<Class<This>>
    }

    "Any card with actions, including corporation and prelude cards"
    ABSTRACT CLASS ActionCard : HasActions

    "Any card that can hold resources"
    ABSTRACT CLASS ResourceCard : ResourceHolder
  }

  "A card in your played-events pile"
  CLASS PlayedEvent {
    End: ScoreEventVps<This>
  }
}

"Deals the next concrete card from a named back's deck"
CLASS DrawCard<Class<CardBack>, CardLocation> : Owned<Player>, Custom, Atomized

"Draws from the ordered project deck until its printed predicate matches"
CLASS SearchForCard : Owned<Player>, Custom, Atomized

"Printed metadata predicates used in card-search refinements"
ABSTRACT CLASS PrintedTag<Class<Tag>>
ABSTRACT CLASS ReferenceTo<Class<Component>>

"Records that a face has left its ordered deck, including cards skipped by a search"
CLASS DeckSpent<Class<CardFront>> : System, Hidden { HAS MAX 1 This }

CLASS CardPurchase : HasActions {
  HAS =1 This
  -ActionBilling<This>:: ProjectCard<Hand FROM Selecting> / ProjectCard<Selecting>
}

"Triggers the purchase of every project card remaining in the player's selection"
CLASS BuySelectedCards : Owned<Player>, Signal {
  This:: (3 Owed<> / ProjectCard<Selecting>) THEN (PayingFor<Class<ProjectCard>> / ProjectCard<Selecting>) THEN ActionBilling<CardPurchase, Action1>
}

CLASS PlayCard<Class<@CardBack>, Class<@CardFront>, @CardLocation> : Owned<Player>, Signal {
  This:: (EVAL @CardFront<Class<@CardBack>>.requirement: Ok) OR AdjustGpRequirement<Class<@CardFront>>
  This: Owed<> / @CardFront.cost THEN PriceCard<Class<@CardFront>> THEN CardBilling<Class<@CardFront>> THEN MAX 0 Barrier: @CardFront FROM @CardBack<Class<@CardFront>, @CardLocation>
}

"Signals that a printed global-parameter requirement produced a shortfall ready for adjustment"
CLASS CheckRequirement<Class<CardFront>> : Owned<Player>, Signal

CLASS AdjustGpRequirement<Class<CardFront>> : Owned<Player>, Custom

"Emits one payment-adjustment event for the card and one for each of its printed tags"
CLASS PriceCard<Class<CardFront>> : Owned<Player>, Custom

"A temporary shortfall between a printed global requirement and the current parameter"
CLASS Required<Class<GlobalParameter>> : Owned<Player>, Barrier {
  DEFAULT -Required.
}

"A location that an owned unplayed card can occupy"
ABSTRACT CLASS CardLocation : System {
  CLASS Hand {
    HAS =1 This
  }
  CLASS Selecting {
    HAS MAX 1 This
    CardBack<This>:: CardLocationCleanup<This>.
    -This:: This!
  }
  CLASS Revealed {
    HAS MAX 1 This
    CardBack<This>:: CardLocationCleanup<This>.
    -This:: This!
  }
}

"Resets a transient card location after all current work finishes"
CLASS CardLocationCleanup<@CardLocation> : Temporary, Hidden {
  HAS MAX 1 This
  -This:: -@CardLocation!
}

// TODO: can this be simplified??
ABSTRACT CLASS TagHolder : Owned<Player>

ABSTRACT CLASS Tag<TagHolder<@Player>> : Owned<@Player>, Atomized {
  CLASS BuildingTag
  CLASS SpaceTag
  CLASS ScienceTag
  CLASS PowerTag
  CLASS CityTag
  ABSTRACT CLASS BioTag {
    CLASS PlantTag
    CLASS MicrobeTag
    CLASS AnimalTag
  }
  ABSTRACT CLASS PlanetaryTag {
    CLASS EarthTag
    CLASS JovianTag
  }
  "The printed event icon derived for every EventCard"
  CLASS EventTag : Tag<EventCard>
}

// TODO: can this be simplified?
"Anything that can hold a particular kind of card resource"
ABSTRACT CLASS ResourceHolder<Class<CardResource>> : Owned<Owner>

ABSTRACT CLASS Cardbound<CardFront<@Player>> : Owned<@Player>

"Marks an action card that has been used this generation"
CLASS ActionUsedMarker<GenerationScope> : Cardbound<ActionCard> { HAS MAX 1 This }

"A singleton listener needed by selected content"
ABSTRACT CLASS CardWatcher : System { HAS MAX 1 This }
