"The distinct card back used by beginner corporations"
CLASS BeginnerCard : CardBack {
  autoSelectWhen = HAS "BeginnerVariant"
}

"A beginner corporation supplies 42 M€ and all ten starting project cards for free"
ABSTRACT CLASS BeginnerCorporation : CardFront<Class<BeginnerCard>> {
  cost = 0
  This: 42 MC, 10 ProjectCard
}

CLASS BeginnerCorporation1 : BeginnerCorporation { HAS MAX 1 BeginnerCorporation1 }
CLASS BeginnerCorporation2 : BeginnerCorporation { HAS MAX 1 BeginnerCorporation2 }
CLASS BeginnerCorporation3 : BeginnerCorporation { HAS MAX 1 BeginnerCorporation3 }
CLASS BeginnerCorporation4 : BeginnerCorporation { HAS MAX 1 BeginnerCorporation4 }
CLASS BeginnerCorporation5 : BeginnerCorporation { HAS MAX 1 BeginnerCorporation5 }
