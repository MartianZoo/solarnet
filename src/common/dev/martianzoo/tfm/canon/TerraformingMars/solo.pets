"Solo play with a neutral opponent and a fixed generation limit"
CLASS SoloMode : GameMode {
  HAS =1 Player
  autoSelectWhen = HAS "=1 Player"

  HAS =1 SoloObjective

  This: SoloOpponent
  This: 14 SoloGenerationsLeft
  SetupPhase: 14 TerraformRating<Player>
  Generation: -SoloGenerationsLeft
}

"Exactly one solo objective Module active in a solo game"
ABSTRACT CLASS SoloObjective : Module {
  HAS MAX 1 SoloObjective, =1 SoloMode

  "The original solo victory objective: complete every required global parameter"
  CLASS StandardSoloObjective {
    autoSelectWhen = HAS "SoloMode, MAX 0 SoloObjective"

    CheckGameEnd IF MAX 0 GpIncomplete: Victory<Player>
  }

  "The solo objective is 63 terraform rating instead of completed global parameters"
  CLASS Tr63SoloObjective {
    This: BufferGasProject

    CheckGameEnd IF 63 TerraformRating: Victory
  }
}

"Raises terraform rating in the TR63 solo objective"
CLASS BufferGasProject : StandardProject {
  cost = 16
  1 MC / cost -> TerraformRating
}

"One generation that must begin before a solo game may end"
CLASS SoloGenerationsLeft : GameEndBarrier

"The passive owner of the removable neutral stock in solo mode"
CLASS SoloOpponent : Owner, System {
  HAS =1 This
  This:: EACH Class^1<StandardResource> { SoloStandardResourceReserve<Class^1> }
  This:: EACH Class^1<CardResource> { SoloCardResourceReserve<Class^1> }
  SetupPhase: PlaceNeutralTiles
}

"Creates the two independent city-and-greenery placement tasks in solo setup"
CLASS PlaceNeutralTiles : Signal, System, Owned<SoloOpponent> {
  HAS MAX 1 This
  This: CityTile^1<> THEN GreeneryTile<LandArea(HAS Neighbor<CityTile^1>)>
  This: CityTile^1<> THEN GreeneryTile<LandArea(HAS Neighbor<CityTile^1>)>
}

"Creates the neutral solo stock of each standard resource and its production"
CLASS SoloStandardResourceReserve<Class<StandardResource^1>> : Owned<SoloOpponent>, System {
  HAS =1 This
  SetupPhase: 42 StandardResource^1
  SetupPhase: PROD[42 StandardResource^1]

  -StandardResource^1 BY Player:: StandardResource^1 BY Admin
  StandardResource^1 BY Player:: -StandardResource^1 BY Admin
  PROD[-StandardResource^1] BY Player:: PROD[StandardResource^1] BY Admin
  PROD[StandardResource^1] BY Player:: PROD[-StandardResource^1] BY Admin
}

"A neutral solo-mode holder for each kind of removable card resource"
CLASS SoloCardResourceReserve : ResourceHolder<Class<CardResource^1>>, Owned<SoloOpponent>, System {
  HAS =1 This
  SetupPhase: 42 CardResource^1<This>

  -CardResource^1<This> BY Player:: CardResource^1<This> BY Admin
  CardResource^1<This> BY Player:: -CardResource^1<This> BY Admin
}
