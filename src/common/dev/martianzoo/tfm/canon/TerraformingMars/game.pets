"The base Terraforming Mars rules"
CLASS TerraformingMars : Module {
  autoSelectWhen = HAS "MAX 0 TerraformingMars"

  This:: 2 SelectableCorporationCount
  New@Player IF MultiplayerMode:: AfterMe<Player, New@>.
  premiseRequirement = HAS "(Unsafe OR MAX 0 Class<EcologyExperts> OR (MAX 0 Class<ViralEnhancers>, MAX 0 Class<EcologicalZone>, MAX 0 Class<Decomposers>, MAX 0 Class<GmoContract>)), (Unsafe OR MAX 0 Class<AmazonisMap> OR (MAX 0 Class<MiningGuild>, MAX 0 Class<MiningRights>, MAX 0 Class<MiningArea>)), (Unsafe OR MAX 0 Class<PreservationProgram> OR (MAX 0 Class<TerraformingDeal>, MAX 0 Class<TurmoilExpansion>)), (Unsafe OR MAX 0 Class<Merger> OR MAX 0 Class<SagittaFrontierServices>)"

  HAS =1 GameMode, =1 MarsMap
  HAS Class<Production>, Class<NormalCityTile>
  HAS Class<BootstrapPhase>, Class<SetupPhase>, Class<CorporationPhase>, Class<ResearchPhase>, Class<ActionPhase>, Class<ProductionPhase>, Class<CheckGameEnd>, Class<SolarPhase>, Class<FinalGreeneryPhase>, Class<End>
  HAS Class<WorkflowStarted>, Class<AdvancePhase>
  HAS Class<VenusSolarPhase>, Class<ColoniesSolarPhase>, Class<TurmoilSolarPhase>
  HAS Class<UseAction>, Class<NewTurn>, Class<SecondAction>

  This: SellPatentsProject, PowerPlantProject, AsteroidProject, AquiferProject, GreeneryProject, CityProject
  This: PlayCardFromHandAction, UseStandardProjectAction, UseActionOnCardAction, ConvertPlantsAction, ConvertHeatAction
  This: DoRequiredActionsAction
  This: Hand, Selecting, Revealed, CardPurchase
  This: NoTagsFilter
  This: EACH Class<@Tag> { TagFilter<Class<@Tag>> }
  This: EACH @Class<GlobalParameter> { GpIncomplete<@Class> }
  This: EACH Class<@RemoteArea> { @RemoteArea }
  This: EACH Class<@ActionSlot> { @ActionSlot }

  ModulesReady IF MAX 0 ExtendedGlobalParametersRule: StandardGpTrackRules

  PayingFor<Class<BuildingTag>> IF Owed:: Accepting<Class<Steel>>
  PayingFor<Class<SpaceTag>> IF Owed:: Accepting<Class<Titanium>>
}

"Allows known incompatible content to coexist"
CLASS Unsafe : Module

"Variant rule: each player begins with 1 of each production"
CLASS QuickStartVariant : Module {
  autoSelectWhen = HAS "TerraformingMars, MAX 0 CorporateEraExpansion"

  SetupPhase: EACH Me@Player { PROD[MC, Steel, Titanium, Plant, Energy, Heat] }
}

"A singleton immutable provider of rule content based on game options"
ABSTRACT CLASS Module : System {
  autoSelectWhen = Requirement?
  premiseRequirement = Requirement?
  phaseAfter = Requirement?

  HAS =1 This
}

"Signals that the complete selected Module layer is live"
// TODO.md: replace with BootstrapPhase entry after premise construction
CLASS ModulesReady : Signal, System {
  This IF MultiplayerMode:: AfterMe<Player, Player>
}

"Exactly one player-count Module active in a playable game"
ABSTRACT CLASS GameMode : Module {
  HAS =1 GameMode

  "Multiplayer rules, including the end condition that deliberately excludes Venus"
  CLASS MultiplayerMode {
    HAS 2 Player
    autoSelectWhen = HAS "2 Player"

    This: ClaimMilestoneAction, FundAwardAction
    This: GpGameEndBarrier<Class<TemperatureStep>>, GpGameEndBarrier<Class<OxygenStep>>, GpGameEndBarrier<Class<OceanTile>>
    SetupPhase: EACH Me@Player { 20 TerraformRating }
    CheckGameEnd IF WorkflowStarted, ProductionPhase:: FinalGreeneryPhase FROM ProductionPhase

    // TODO.md: move final scoring and victory assignment into their real phase boundaries
    -FinalScoringPending: EACH Me@Player(HAS =1 (RANK Me@Player { VictoryPoint, MC })) { Victory }
  }
}

"One of the actual people or bots playing Terraforming Mars"
ABSTRACT CLASS Player : Owner, Actor {
  HAS =1 This
  HAS MAX 1 AfterMe<This, Anyone>, MAX 1 AfterMe<Anyone, This>
  HAS MAX 0 AfterMe<This, This>
  HAS MAX 1 PlayerMode<This>

  This:: StartToken<This>.

  // Queued `This` work gives every Player its production floor and payment values only after the
  // complete seat layer exists.
  This: 5 ProdOffset<This, Class<MC>> BY Admin
  This: 2 BaseResourceValue<This, Class<Steel>>, 3 BaseResourceValue<This, Class<Titanium>>

  SetupPhase IF MAX 0 BeginnerVariant: NonBeginnerMode<This>
  SetupPhase IF BeginnerVariant: BeginnerMode<This> OR NonBeginnerMode<This>
  ResearchPhase: 4 ProjectCard<This, Selecting> THEN -4 ProjectCard<This, Selecting>? THEN BuySelectedCards<This>
}

"A player's persistent choice of starting-card procedure"
ABSTRACT CLASS PlayerMode : Owned<Player>

"A unit in the configured number of corporation cards offered to each player"
CLASS SelectableCorporationCount : System

"The normal starting-card procedure"
CLASS NonBeginnerMode : PlayerMode {
  This: CorporationCard / SelectableCorporationCount, \
    -CorporationCard / (SelectableCorporationCount - 1), \
    10 ProjectCard<Selecting>, -10 ProjectCard<Selecting>?
}

"One step on the terraform rating track; you generally start with 20 of them"
CLASS TerraformRating : Owned<Player>, Atomized {
  ProductionPhase: 1 MC
  End: VictoryPoint
}

"Marks the player who takes the first turn"
CLASS StartToken : Owned<Player> { HAS =1 StartToken }

"Identifies the Player immediately after another Player in seat order"
CLASS AfterMe<Previous@Owner, Next@Player> : System, Hidden {
  HAS MAX 1 This
  ResearchPhase IF MultiplayerMode, StartToken<Previous@>: StartToken<Next@ FROM Previous@>.
}

"The current game phase; exactly one exists from bootstrap through the terminal End phase"
ABSTRACT CLASS Phase : System {
  phaseSegment = Requirement?

  HAS =1 Phase

  CLASS BootstrapPhase {
    -AdvancePhase<This> IF WorkflowStarted:: SetupPhase FROM This
  }
  CLASS SetupPhase {
    This IF WorkflowStarted:: AdvancePhase<This>
    -AdvancePhase<This> IF WorkflowStarted:: CorporationPhase FROM This
    This:: Generation
  }
  CLASS CorporationPhase {
    phaseSegment = HAS "ActionPhase"
    This IF WorkflowStarted:: EACH @Player(HAS StartToken) { NewTurn<@Player> }
    -CorporationCard<Previous@Anyone> IF WorkflowStarted, MultiplayerMode: \
      CorporationPhaseCompletionCheck<AfterMe<Previous@, Player>>
    -BeginnerCard<Previous@Anyone> IF WorkflowStarted, MultiplayerMode: \
      CorporationPhaseCompletionCheck<AfterMe<Previous@, Player>>
    -CorporationCard<Anyone> IF WorkflowStarted, SoloMode: \
      AdvancePhase<CorporationPhase>
    -BeginnerCard<Anyone> IF WorkflowStarted, SoloMode: \
      AdvancePhase<CorporationPhase>
    This: Photosynthesis
    This:: EACH Class<@CardWatcher> { @CardWatcher }

    NewTurn IF CorporationCard<Hand>: \
      PlayCard<Class<CorporationCard>, Class<CardFront>, Hand> THEN BuySelectedCards
    NewTurn IF BeginnerCard<Hand>: \
      PlayCard<Class<BeginnerCard>, Class<CardFront>, Hand> THEN BuySelectedCards
  }
  CLASS ResearchPhase {
    This IF WorkflowStarted:: AdvancePhase<This>
    -AdvancePhase<This> IF WorkflowStarted:: ActionPhase FROM This
    This:: Generation
  }
  CLASS ActionPhase {
    This IF WorkflowStarted:: EACH @Player(HAS StartToken) { FirstActionTurn<@Player> }
    -AdvancePhase<This> IF WorkflowStarted:: ProductionPhase FROM This
    This:: EACH Me@Player(HAS Pass) { -Pass }
    NewTurn: UseAction<StandardAction> OR Pass
    SecondAction: UseAction<StandardAction>?
  }
  CLASS ProductionPhase {
    This IF WorkflowStarted:: AdvancePhase<This>
    -AdvancePhase<This> IF WorkflowStarted, GameEndBarrier:: SolarPhase FROM This
    -AdvancePhase<This> IF WorkflowStarted, MAX 0 GameEndBarrier:: CheckGameEnd
  }
  CLASS SolarPhase {
    phaseSegment = HAS "ResearchPhase"
    This IF WorkflowStarted:: AdvancePhase<This>
  }
  CLASS VenusSolarPhase { This IF WorkflowStarted:: AdvancePhase<This> }
  CLASS ColoniesSolarPhase { This IF WorkflowStarted:: AdvancePhase<This> }
  CLASS TurmoilSolarPhase { This IF WorkflowStarted:: AdvancePhase<This> }
  CLASS FinalGreeneryPhase {
    This IF WorkflowStarted:: EACH @Player(HAS StartToken) { FinalGreeneryTurn<@Player> }
    -AdvancePhase<This> IF WorkflowStarted:: End FROM This
    NewTurn<Me@Player> IF WorkflowStarted: UseAction<ConvertPlantsAction, Action1> OR FinishFinalGreenery<Me@>
    NewTurn IF MAX 0 WorkflowStarted: UseAction<ConvertPlantsAction, Action1>?
    UseAction<Me@Player, ConvertPlantsAction, Action1> IF WorkflowStarted:: FinalGreeneryTurn<Me@>
  }

  "The terminal game phase"
  CLASS End {
    This:: FinalScoringPending
  }
}

"Records that the phase workflow has been explicitly started"
CLASS WorkflowStarted : System {
  HAS MAX 1 This
  This:: AdvancePhase<BootstrapPhase>
}

"Requests phase advancement after pending work and its initiating operation have completed"
CLASS AdvancePhase<Phase> : Continuation, System { HAS MAX 1 This }

"Continues corporation selection with the next player after one settled choice"
CLASS CorporationPhaseCompletionCheck<AfterMe<Anyone, Next@Player>> : Continuation, System {
  -This IF WorkflowStarted, CorporationPhase, CorporationCard<Next@>:: \
    NewTurn<Next@>
  -This IF WorkflowStarted, CorporationPhase, BeginnerCard<Next@>:: \
    NewTurn<Next@>
  -This IF WorkflowStarted, CorporationPhase, MAX 0 CorporationCard<Anyone>, MAX 0 BeginnerCard<Anyone>:: \
    AdvancePhase<CorporationPhase>
}

"Offers another final greenery conversion after the preceding operation has settled"
CLASS FinalGreeneryTurn<Current@Player> : Continuation, Owned<Current@Player> {
  -This IF WorkflowStarted, FinalGreeneryPhase:: NewTurn<Current@>
}

"Continues final greenery in seat order, ending after the last player finishes"
CLASS FinishFinalGreenery<Current@Player> : Continuation, Owned<Current@Player> {
  -This IF WorkflowStarted, FinalGreeneryPhase, SoloMode: \
    AdvancePhase<FinalGreeneryPhase>
  -This IF WorkflowStarted, FinalGreeneryPhase:: \
    EACH Next@Player(HAS AfterMe<Current@, Player>, HAS MAX 0 StartToken) { \
      FinalGreeneryTurn<Next@> \
    }
  -This IF WorkflowStarted, FinalGreeneryPhase, AfterMe<Current@, Player(HAS StartToken)>: \
    AdvancePhase<FinalGreeneryPhase>
}

"This is what the engine creates to grant you a 'turn' (note in some phases you get two in a row)"
CLASS NewTurn : Owned<Player>, Signal

"The engine's signal for the second action slot in an action phase turn; no Pass option"
CLASS SecondAction : Owned<Player>, Signal

"One action slot, open until its work settles"
ABSTRACT CLASS ActionTurn<ActionPhase> : Continuation, System {
  HAS MAX 1 ActionTurn
}

"The mandatory first action slot in a Player's turn"
CLASS FirstActionTurn<Current@Player> : ActionTurn {
  This:: NewTurn<Current@>
  -This IF WorkflowStarted, ActionPhase, MAX 0 Pass<Current@>, 2 Player(HAS MAX 0 Pass):: \
    SecondActionTurn<Current@>
  -This IF WorkflowStarted, ActionPhase, MAX 0 Pass<Current@>, MAX 1 Player(HAS MAX 0 Pass):: \
    NextActionTurn<Current@>
  -This IF WorkflowStarted, ActionPhase, Player(HAS MAX 0 Pass), Pass<Current@>:: \
    EACH Next@Player(HAS AfterMe<Current@, Player>) { \
      NextActionTurn<Next@> \
    }
}

"The optional second action slot in a Player's turn"
CLASS SecondActionTurn<Current@Player> : ActionTurn {
  This:: SecondAction<Current@>
  -This IF WorkflowStarted, ActionPhase, Player(HAS MAX 0 Pass):: \
    EACH Next@Player(HAS AfterMe<Current@, Player>) { \
      NextActionTurn<Next@> \
    }
}

"Finds the next Player who has not passed"
CLASS NextActionTurn<Candidate@Player> : Continuation, System {
  -This IF WorkflowStarted, ActionPhase, MAX 0 Pass<Candidate@>:: \
    FirstActionTurn<Candidate@>
  -This IF WorkflowStarted, ActionPhase, Player(HAS MAX 0 Pass), Pass<Candidate@>:: \
    EACH Next@Player(HAS AfterMe<Candidate@, Player>) { \
      NextActionTurn<Next@> \
    }
}

"The player has passed; cleared when the next Action phase begins"
CLASS Pass : Owned<Player> {
  HAS MAX 1 This
  This IF WorkflowStarted, ActionPhase, MAX 0 Player(HAS MAX 0 Pass): AdvancePhase<ActionPhase>
}

"Tells what generation we're in"
CLASS Generation : System {
  This IF MAX 0 GenerationScope:: GenerationScope
}

"The lifetime anchor for components that exist only during the current generation"
CLASS GenerationScope : Scope, System, Hidden {
  HAS MAX 1 This
  Generation:: -This! THEN This!
}

"Anything that prevents the game from ending"
ABSTRACT CLASS GameEndBarrier

"Signals the post-production check after the final GameEndBarrier is removed"
CLASS CheckGameEnd : Signal, System
