"The base Terraforming Mars rules"
CLASS TerraformingMars : Module {
  autoSelectWhen = HAS "MAX 0 TerraformingMars"

  HAS =1 GameMode, =1 MarsMap
  HAS Class<Production>
  HAS Class<BootstrapPhase>, Class<SetupPhase>, Class<CorporationPhase>, Class<ResearchPhase>, Class<ActionPhase>, Class<ProductionPhase>, Class<CheckGameEnd>, Class<SolarPhase>, Class<FinalGreeneryPhase>, Class<End>
  HAS Class<WorkflowStarted>, Class<BootstrapPhaseScope>, Class<SetupPhaseScope>, Class<CorporationPhaseScope>, Class<ActionPhaseScope>, Class<ProductionPhaseScope>, Class<SolarPhaseScope>, Class<ResearchPhaseScope>, Class<FinalGreeneryPhaseScope>
  HAS Class<VenusSolarPhase>, Class<ColoniesSolarPhase>, Class<TurmoilSolarPhase>
  HAS Class<UseAction>, Class<NewTurn>, Class<SecondAction>

  This: SellPatentsProject, PowerPlantProject, AsteroidProject, AquiferProject, GreeneryProject, CityProject
  This: PlayCardFromHandAction, UseStandardProjectAction, UseActionOnCardAction, ConvertPlantsAction, ConvertHeatAction
  This: DoRequiredActionsAction
  This: CardPurchase, CardPlay
  This: EACH Class<@Tag> { TagFilter<Class<@Tag>> }
  This: EACH @Class<GlobalParameter> { GpIncomplete<@Class> }
  This: EACH Class<@RemoteArea> { @RemoteArea }
  This: EACH Class<@ActionSlot> { @ActionSlot }

  ModulesReady IF MAX 0 ExtendedGlobalParametersRule: StandardGpTrackRules

  PayingFor<Class<BuildingTag>> IF Owed:: Accepting<Class<Steel>>
  PayingFor<Class<SpaceTag>> IF Owed:: Accepting<Class<Titanium>>
}

"Variant rule: each player begins with 1 of each production"
CLASS QuickStartVariant : Module {
  autoSelectWhen = HAS "TerraformingMars, MAX 0 CorporateEraExpansion"

  SetupPhase: EACH Player { PROD[MC, Steel, Titanium, Plant, Energy, Heat] }
}

"A singleton immutable provider of rule content based on game options"
ABSTRACT CLASS Module : System {
  autoSelectWhen = Requirement?
  premiseRequirement = Requirement?
  phaseAfter = Requirement?

  HAS =1 This
}

// TODO.md: replace with BootstrapPhase entry after premise construction
"Signals that the complete selected Module layer is live"
CLASS ModulesReady : Signal

"Exactly one player-count Module active in a playable game"
ABSTRACT CLASS GameMode : Module {
  HAS =1 GameMode

  "Multiplayer rules, including the end condition that deliberately excludes Venus"
  CLASS MultiplayerMode {
    HAS 2 Player
    autoSelectWhen = HAS "2 Player"

    This: ClaimMilestoneAction, FundAwardAction
    This: GpGameEndBarrier<Class<TemperatureStep>>, GpGameEndBarrier<Class<OxygenStep>>, GpGameEndBarrier<Class<OceanTile>>
    SetupPhase: EACH Player { 20 TerraformRating }
    CheckGameEnd IF WorkflowStarted, ProductionPhase:: FinalGreeneryPhase FROM ProductionPhase

    // TODO.md: move final scoring and victory assignment into their real phase boundaries
    -FinalScoringPending: EACH Player(HAS =1 (RANK { VictoryPoint, MC })) { Victory }
  }
}

"One of the actual people or bots playing Terraforming Mars"
ABSTRACT CLASS Player : Owner, Actor {
  HAS =1 This
  HAS =1 ActionPhaseStatus<This>
  HAS MAX 1 AfterMe<This, Anyone>, MAX 1 AfterMe<Anyone, This>

  // Queued `This` work gives every Player its production floor and payment values only after the
  // complete seat layer exists.
  This:: HaveNotPassed
  This: 5 ProdOffset<This, Class<MC>> BY Admin
  This: 2 BaseResourceValue<Class<Steel>>, 3 BaseResourceValue<Class<Titanium>>

  // 2 CorporationOption; StandardCorporationCard<Selecting> / CorporationOption THEN 10 ProjectCard
  SetupPhase IF MAX 0 BeginnerVariant: \
    StandardCorporationCard THEN NewTurn
  // (BeginnerCorporationCard THEN 10 ProjectCard) OR
  //   (StandardCorporationCard<Selecting> / CorporationOption THEN 10 ProjectCard)
  SetupPhase IF BeginnerVariant: \
    (BeginnerCorporationCard THEN NewTurn) OR (StandardCorporationCard THEN NewTurn)
  // 4 ProjectCard<Selecting>, -4 ProjectCard<Selecting>? THEN BuySelectedCards
  ResearchPhase: 4 BuyCard?
}

"One step on the terraform rating track; you generally start with 20 of them"
CLASS TerraformRating : Owned<Player> {
  ProductionPhase: 1 MC
  End: VictoryPoint
}

"Marks the player who takes the first turn"
CLASS StartToken : Owned<Player> { HAS =1 StartToken }

"Identifies the Player immediately after another Player in seat order"
CLASS AfterMe<Previous@Owner, Next@Player> : System {
  HAS MAX 1 This
  ResearchPhase IF StartToken<Previous@Owner>: StartToken<Next@Player FROM Previous@Owner>.
}

"The current game phase; exactly one exists from bootstrap through the terminal End phase"
ABSTRACT CLASS Phase : System {
  phaseSegment = Requirement?

  HAS =1 Phase

  CLASS BootstrapPhase
  CLASS SetupPhase {
    This IF WorkflowStarted:: SetupPhaseScope
    This:: Generation
  }
  CLASS CorporationPhase {
    phaseSegment = HAS "CorporationPhase, ActionPhase"
    This: Photosynthesis
    This:: EACH Class<@CardWatcher> { @CardWatcher }

    // NewTurn IF SetupPhase, StandardCorporationCard<Selecting>: StandardCorporationCard<Hand FROM Selecting>,
    //   ((ProjectCard<Selecting FROM Hand> / ProjectCard<Hand>) THEN -10 ProjectCard<Selecting>?
    //     THEN (ProjectCard<Hand FROM Selecting> / ProjectCard<Selecting>))
    NewTurn IF StandardCorporationCard: \
      PlayCard<Class<CorporationCard>, Class<CardFront>(NOT Class<BeginnerCorporation>)> THEN 10 BuyCard?
    NewTurn IF BeginnerCorporationCard: \
      PlayCard<Class<CorporationCard>, Class<BeginnerCorporation>>
  }
  CLASS ResearchPhase {
    This IF WorkflowStarted:: ResearchPhaseScope
    This:: Generation
  }
  CLASS ActionPhase {
    This:: ActionPhaseScope
    This:: EACH Player(HAS Pass) { HaveNotPassed FROM Pass }
    NewTurn: UseAction<StandardAction> OR (Pass FROM HaveNotPassed)
    SecondAction: UseAction<StandardAction>?
  }
  CLASS ProductionPhase { This IF WorkflowStarted:: ProductionPhaseScope }
  CLASS SolarPhase { phaseSegment = HAS "SolarPhase, ResearchPhase" }
  CLASS VenusSolarPhase
  CLASS ColoniesSolarPhase
  CLASS TurmoilSolarPhase
  CLASS FinalGreeneryPhase {
    This IF WorkflowStarted:: FinalGreeneryPhaseScope
    NewTurn: UseAction<ConvertPlantsAction, Action1>?
  }

  "The terminal game phase"
  CLASS End {
    This:: FinalScoringPending
  }
}

"Records that the phase workflow has been explicitly started"
CLASS WorkflowStarted : System {
  HAS MAX 1 This
  This:: BootstrapPhaseScope
}

"The lifetime anchor for components belonging to one occurrence of a phase"
ABSTRACT CLASS PhaseScope<Phase> : System { HAS MAX 1 PhaseScope }

"The bootstrap phase's lifetime anchor and continuation"
CLASS BootstrapPhaseScope : PhaseScope<BootstrapPhase>, Temporary {
  -This IF WorkflowStarted:: SetupPhase FROM BootstrapPhase
}

"The setup phase's lifetime anchor and continuation"
CLASS SetupPhaseScope : PhaseScope<SetupPhase>, Temporary {
  -This IF WorkflowStarted:: CorporationPhase FROM SetupPhase
}

"The corporation phase's lifetime anchor"
CLASS CorporationPhaseScope : PhaseScope<CorporationPhase> {
  This IF WorkflowStarted:: EACH @Player(HAS StartToken) { NewTurn<@Player> BY @Player }
  -CorporationCard<Previous@Owner> IF WorkflowStarted:: \
    EACH Seat@AfterMe<Previous@Owner, Anyone> { \
      CorporationPhaseCompletionCheck<Seat@AfterMe> BY Admin \
    }
}

"Continues corporation selection with the next player after one settled choice"
CLASS CorporationPhaseCompletionCheck<AfterMe<Anyone, Next@Player>> : Continuation, System {
  -This IF WorkflowStarted, CorporationPhaseScope, CorporationCard<Next@Player>:: \
    NewTurn<Next@Player> BY Next@Player
  -This IF WorkflowStarted, CorporationPhaseScope, MAX 0 CorporationCard<Anyone>:: \
    -CorporationPhaseScope BY Admin
}

"The open action phase's lifetime anchor"
CLASS ActionPhaseScope : PhaseScope<ActionPhase> {
  This IF WorkflowStarted:: \
    EACH @Player(HAS StartToken) { FirstActionTurn<@Player> BY Admin }
}

"The completed action phase, removed only after the operation completing it has validated"
CLASS ActionPhaseComplete : PhaseScope<ActionPhase>, Continuation {
  -This IF WorkflowStarted:: ProductionPhase FROM ActionPhase
}

"The production phase's lifetime anchor and continuation"
CLASS ProductionPhaseScope : PhaseScope<ProductionPhase>, Temporary {
  -This IF WorkflowStarted, GameEndBarrier:: SolarPhase FROM ProductionPhase
  -This IF WorkflowStarted, MAX 0 GameEndBarrier:: CheckGameEnd
}

"The research phase's lifetime anchor and continuation"
CLASS ResearchPhaseScope : PhaseScope<ResearchPhase>, Temporary {
  -This IF WorkflowStarted:: ActionPhase FROM ResearchPhase
}

"The final greenery phase's lifetime anchor and terminal continuation"
CLASS FinalGreeneryPhaseScope : PhaseScope<FinalGreeneryPhase> {
  -This IF WorkflowStarted:: End FROM FinalGreeneryPhase
}

"This is what the engine creates to grant you a 'turn' (note in some phases you get two in a row)"
CLASS NewTurn : Owned<Player>, Signal

"The engine's signal for the second action slot in an action phase turn; no Pass option"
CLASS SecondAction : Owned<Player>, Signal

"One action slot, open until its work settles"
ABSTRACT CLASS ActionTurn : Temporary, System {
  HAS MAX 1 ActionTurn
}

"The mandatory first action slot in a Player's turn"
CLASS FirstActionTurn<Current@Player> : ActionTurn {
  This:: NewTurn<Current@Player> BY Current@Player
  -This IF WorkflowStarted, ActionPhaseScope, HaveNotPassed<Current@Player>, 2 HaveNotPassed<Anyone>:: \
    SecondActionStart<Current@Player> BY Admin
  -This IF WorkflowStarted, ActionPhaseScope, HaveNotPassed<Current@Player>, MAX 1 HaveNotPassed<Anyone>:: \
    NextActionTurn<Current@Player> BY Admin
  -This IF WorkflowStarted, ActionPhaseScope, Pass<Current@Player>:: \
    EACH Next@Player(HAS AfterMe<Current@Player, Player>) { \
      NextActionTurn<Next@Player> BY Admin \
    }
}

"Starts a second action only after the first action operation validates"
CLASS SecondActionStart<Current@Player> : Continuation, System {
  -This IF WorkflowStarted, ActionPhaseScope:: SecondActionTurn<Current@Player> BY Admin
}

"The optional second action slot in a Player's turn"
CLASS SecondActionTurn<Current@Player> : ActionTurn {
  This:: SecondAction<Current@Player> BY Current@Player
  -This IF WorkflowStarted, ActionPhaseScope:: \
    EACH Next@Player(HAS AfterMe<Current@Player, Player>) { \
      NextActionTurn<Next@Player> BY Admin \
    }
}

"Finds the next Player who has not passed"
CLASS NextActionTurn<Candidate@Player> : Continuation, System {
  -This IF WorkflowStarted, ActionPhaseScope, HaveNotPassed<Candidate@Player>:: \
    FirstActionTurn<Candidate@Player> BY Admin
  -This IF WorkflowStarted, ActionPhaseScope, Pass<Candidate@Player>:: \
    EACH Next@Player(HAS AfterMe<Candidate@Player, Player>) { \
      NextActionTurn<Next@Player> BY Admin \
    }
}

"A player's exhaustive Action-phase participation state, reset whenever Action begins"
ABSTRACT CLASS ActionPhaseStatus : Owned<Player>

"The player remains eligible to take a turn"
CLASS HaveNotPassed : ActionPhaseStatus

"The player is out for the remainder of this Action phase"
CLASS Pass : ActionPhaseStatus {
  This IF WorkflowStarted, MAX 0 HaveNotPassed<Anyone>:: \
    ActionPhaseComplete FROM ActionPhaseScope BY Admin
}

"Tells what generation we're in"
CLASS Generation : System {
  This IF MAX 0 GenerationScope:: GenerationScope
}

"The lifetime anchor for components that exist only during the current generation"
CLASS GenerationScope : Scope, System {
  HAS MAX 1 This
  Generation:: -This! THEN This!
}

"Anything that prevents the game from ending"
ABSTRACT CLASS GameEndBarrier

"Signals the post-production check after the final GameEndBarrier is removed"
CLASS CheckGameEnd : Signal, System
