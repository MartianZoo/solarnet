CLASS Generalist : Milestone {
  HAS MAX 0 QuickStartVariant
  requirement = HAS "PROD[6 MC, Steel, Titanium, Plant, Energy, Heat]"
}
CLASS Generalist2 : Milestone {
  HAS QuickStartVariant
  requirement = HAS "PROD[7 MC, 2 Steel, 2 Titanium, 2 Plant, 2 Energy, 2 Heat]"
}
// Search for GrossHack to understand this nonsense.
CLASS Specialist : Milestone { requirement = HAS "PROD[10 (MC - 5) OR 10 Steel OR 10 Titanium OR 10 Plant OR 10 Energy OR 10 Heat]" }
CLASS Ecologist : Milestone { requirement = HAS "4 BioTag" }
CLASS Tycoon15 : Milestone { requirement = HAS "15 (ActiveCard OR AutomatedCard)" }
CLASS Legend5 : Milestone { requirement = HAS "CARDS[5 CardBack<EventPile>]" }

CLASS Celebrity : Award { metric = COUNT "CardFront(HAS 20 cost)" }
CLASS Industrialist : Award { metric = COUNT "Steel OR Energy" }
CLASS DesertSettler : Award {
  HAS ElysiumMap
  metric = COUNT "OwnedTile<MarsArea(HAS 6 row)>"
}
CLASS EstateDealer : Award { metric = COUNT "OwnedTile<MarsArea(HAS Neighbor<OceanTile>)>" }
CLASS Benefactor : Award { metric = COUNT "TerraformRating" }

CLASS ElysiumMap : MarsMap

// The map areas below are code-generated based on the following comment
//               W     WT    WC    WS    LC
//
//            VT    L     L     W     W    LSS
//
//        VTT    L     LC    L     WP    W    V3C
//
//      LP    LP    LP   WPP    LP    WP    WP   LPS
//
//  LPP   LPP   LPP   WPP   LPP   L3P   LPP   LPP   VPT
//
//      LS    LP    LP    LP    LP    LP    LP    L
//
//         LT    LS    L     L     LS    L     L
//
//           LSS    L     L     L    LSS    L
//
//               LS    L     LC    LC   LSS

CLASS Elysium_1_1 :    WaterArea { row = 1; column = 1 }
CLASS Elysium_1_2 :    WaterArea { row = 1; column = 2; Tile<This>: Titanium }
