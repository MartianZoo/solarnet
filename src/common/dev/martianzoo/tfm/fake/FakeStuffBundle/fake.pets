"Explicitly selected support for incomplete game content"
CLASS FakeStuffBundle : Module {
  TemperatureStep BY Player^1 IF Class<FakeThawer>:: FakeTemperatureCredit<Player^1>
}

"Thawer whose temperature credits survive temperature reductions"
CLASS FakeThawer : Milestone {
  requirement = HAS "5 FakeTemperatureCredit"
}

"A temperature increase credited to a player, independent of the current temperature"
CLASS FakeTemperatureCredit : Owned<Player>
