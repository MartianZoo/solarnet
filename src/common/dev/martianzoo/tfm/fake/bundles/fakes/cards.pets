"An inert stand-in for a printed wild tag"
CLASS FakeWildTag : Cardbound

"A holder for tags supplied by a replay, removed after its owner's next action or Prelude play"
CLASS FakeWildTagUse : TagHolder {
  HAS MAX 1 This
  OWN[StandardAction: LATER { -This* }]
  OWN[PlayPrelude: LATER { -This* }]
}

CLASS FakeResearchNetwork : CardFront<Class<PreludeCard>> {
  cost = 0

  HAS MAX 1 FakeResearchNetwork
  HAS =1 FakeWildTag<This>
  OWN[This: PROD[1 MC], 3 ProjectCard]
}

CLASS FakeResearchCoordination : AutomatedCard {
  cost = 4

  HAS MAX 1 FakeResearchCoordination
  HAS =1 FakeWildTag<This>
}

"Floyd Continuum as represented by the source replay"
CLASS FakeFloydContinuum : ActionCard, ActiveCard {
  cost = 4

  HAS MAX 1 FakeFloydContinuum
  HAS =1 ScienceTag<This>
  OWN[-> 3 MC / GpComplete]
}

CLASS FakeAppliedScience : ActionCard, ResourceCard<Class<Science>, Class<PreludeCard>> {
  cost = 0

  HAS MAX 1 FakeAppliedScience
  HAS =1 FakeWildTag<This>
  OWN[This: 6 Science<This>]

  OWN[Science<This> -> CardResource<CardFront(HAS CardResource)> OR StandardResource]
}

CLASS FakeNobelPrize : CardFront<Class<PreludeCard>> {
  cost = 0

  HAS MAX 1 FakeNobelPrize
  HAS =1 FakeWildTag<This>
  // SearchForCard(HAS requirement)
  OWN[This: 5 MC, 2 ProjectCard]
  OWN[End: 2 VictoryPoint]
}

"Helion without correct Heat payment allocation"
CLASS FakeHelion : CardFront<Class<CorporationCard>> {
  cost = 0

  HAS MAX 1 FakeHelion
  HAS =1 SpaceTag<This>
  OWN[This:: BaseResourceValue<Class<Heat>>]
  OWN[This: 42 MC, PROD[3 Heat]]

  OWN[Billing<Class<Component>, Class<MC>> IF Owed<Class<MC>>:: Accepting<Class<Heat>>]
}

"A replay-only stand-in for an unsupported upstream corporation"
CLASS FakePolderTechDutch : CardFront<Class<CorporationCard>> {
  cost = 0

  HAS MAX 1 FakePolderTechDutch
  HAS =1 EarthTag<This>
  OWN[This: 35 MC, RequiredAction { -> OceanTile<> THEN GreeneryTile<LandArea(HAS Neighbor<OceanTile>)> }]
  OWN[OceanTile: Energy]
  OWN[GreeneryTile: Plant]
}

"Septem Tribus with an inert wild tag"
CLASS FakeSeptemTribus : ActionCard<Class<CorporationCard>> {
  cost = 0

  HAS MAX 1 FakeSeptemTribus
  HAS =1 FakeWildTag<This>
  OWN[This: 36 MC]

  OWN[-> 2 MC / Party(HAS PartyDelegate)]
}

"Head Start with independently interleavable actions granted on entry"
CLASS FakeHeadStart : CardFront<Class<PreludeCard>> {
  cost = 0

  HAS MAX 1 FakeHeadStart
  OWN[This:: Audit]
  OWN[This: 2 Steel, 2 MC / ProjectCard, \
    (MAX 0 RequiredAction: StandardAction) OR (RequiredAction: RequiredActionsSignal), \
    (MAX 0 RequiredAction: StandardAction) OR (RequiredAction: RequiredActionsSignal)]
}

"One robot unit stored with a card that reduces its play cost by 1 MC"
CLASS RobotUnit<Class<@CardFront>> : Resource, Owned<Player> {
  OWN[ReplicateForStagedProject<Class<@CardFront>>: This]
  OWN[PlayCard<Class<CardBack>, Class<@CardFront>>: -Owed, -This]
  OWN[FirstPlace<Collector> IF This:: Audit]
  OWN[SecondPlace<Collector> IF This:: Audit]
}

"Self-Replicating Robots with printed-tag selection delegated in follow mode"
CLASS FakeSelfReplicatingRobots : ActionCard, ActiveCard {
  cost = 7
  requirement = HAS "2 ScienceTag"

  HAS MAX 1 FakeSelfReplicatingRobots
  OWN[PlayCard<Class<CardBack>, Class<@CardFront>(HAS RobotUnit<Class<@CardFront>>)>: ProjectCard]

  // HAS PrintedTag<Class<BuildingTag>> OR PrintedTag<Class<SpaceTag>>
  OWN[-> StageForReplicatedProject<Class<CardFront>>]
  OWN[-> ReplicateForStagedProject<Class<CardFront>(HAS RobotUnit)>]
}

CLASS StageForReplicatedProject<Class<@CardFront>> : Owned<Player>, Signal {
  OWN[This: -ProjectCard THEN 2 RobotUnit<Class<@CardFront>>]
}

CLASS ReplicateForStagedProject<Class<CardFront>> : Owned<Player>, Signal
